                                 ; ***** PORTB ************************
                                 ; PORTB - Port B Data Register
                                 .equ	PORTB0	= 0	; Port B Data Register bit 0
                                 .equ	PB0	= 0	; For compatibility
                                 .equ	PORTB1	= 1	; Port B Data Register bit 1
                                 .equ	PB1	= 1	; For compatibility
                                 .equ	PORTB2	= 2	; Port B Data Register bit 2
                                 .equ	PB2	= 2	; For compatibility
                                 .equ	PORTB3	= 3	; Port B Data Register bit 3
                                 .equ	PB3	= 3	; For compatibility
                                 .equ	PORTB4	= 4	; Port B Data Register bit 4
                                 .equ	PB4	= 4	; For compatibility
                                 .equ	PORTB5	= 5	; Port B Data Register bit 5
                                 .equ	PB5	= 5	; For compatibility
                                 .equ	PORTB6	= 6	; Port B Data Register bit 6
                                 .equ	PB6	= 6	; For compatibility
                                 .equ	PORTB7	= 7	; Port B Data Register bit 7
                                 .equ	PB7	= 7	; For compatibility
                                 
                                 ; DDRB - Port B Data Direction Register
                                 .equ	DDB0	= 0	; Port B Data Direction Register bit 0
                                 .equ	DDB1	= 1	; Port B Data Direction Register bit 1
                                 .equ	DDB2	= 2	; Port B Data Direction Register bit 2
                                 .equ	DDB3	= 3	; Port B Data Direction Register bit 3
                                 .equ	DDB4	= 4	; Port B Data Direction Register bit 4
                                 .equ	DDB5	= 5	; Port B Data Direction Register bit 5
                                 .equ	DDB6	= 6	; Port B Data Direction Register bit 6
                                 .equ	DDB7	= 7	; Port B Data Direction Register bit 7
                                 
                                 ; PINB - Port B Input Pins
                                 .equ	PINB0	= 0	; Port B Input Pins bit 0
                                 .equ	PINB1	= 1	; Port B Input Pins bit 1
                                 .equ	PINB2	= 2	; Port B Input Pins bit 2
                                 .equ	PINB3	= 3	; Port B Input Pins bit 3
                                 .equ	PINB4	= 4	; Port B Input Pins bit 4
                                 .equ	PINB5	= 5	; Port B Input Pins bit 5
                                 .equ	PINB6	= 6	; Port B Input Pins bit 6
                                 .equ	PINB7	= 7	; Port B Input Pins bit 7
                                 
                                 
                                 ; ***** PORTC ************************
                                 ; PORTC - Port C Data Register
                                 .equ	PORTC0	= 0	; Port C Data Register bit 0
                                 .equ	PC0	= 0	; For compatibility
                                 .equ	PORTC1	= 1	; Port C Data Register bit 1
                                 .equ	PC1	= 1	; For compatibility
                                 .equ	PORTC2	= 2	; Port C Data Register bit 2
                                 .equ	PC2	= 2	; For compatibility
                                 .equ	PORTC3	= 3	; Port C Data Register bit 3
                                 .equ	PC3	= 3	; For compatibility
                                 .equ	PORTC4	= 4	; Port C Data Register bit 4
                                 .equ	PC4	= 4	; For compatibility
                                 .equ	PORTC5	= 5	; Port C Data Register bit 5
                                 .equ	PC5	= 5	; For compatibility
                                 .equ	PORTC6	= 6	; Port C Data Register bit 6
                                 .equ	PC6	= 6	; For compatibility
                                 
                                 ; DDRC - Port C Data Direction Register
                                 .equ	DDC0	= 0	; Port C Data Direction Register bit 0
                                 .equ	DDC1	= 1	; Port C Data Direction Register bit 1
                                 .equ	DDC2	= 2	; Port C Data Direction Register bit 2
                                 .equ	DDC3	= 3	; Port C Data Direction Register bit 3
                                 .equ	DDC4	= 4	; Port C Data Direction Register bit 4
                                 .equ	DDC5	= 5	; Port C Data Direction Register bit 5
                                 .equ	DDC6	= 6	; Port C Data Direction Register bit 6
                                 
                                 ; PINC - Port C Input Pins
                                 .equ	PINC0	= 0	; Port C Input Pins bit 0
                                 .equ	PINC1	= 1	; Port C Input Pins bit 1
                                 .equ	PINC2	= 2	; Port C Input Pins bit 2
                                 .equ	PINC3	= 3	; Port C Input Pins bit 3
                                 .equ	PINC4	= 4	; Port C Input Pins bit 4
                                 .equ	PINC5	= 5	; Port C Input Pins bit 5
                                 .equ	PINC6	= 6	; Port C Input Pins bit 6
                                 
                                 
                                 ; ***** PORTD ************************
                                 ; PORTD - Port D Data Register
                                 .equ	PORTD0	= 0	; Port D Data Register bit 0
                                 .equ	PD0	= 0	; For compatibility
                                 .equ	PORTD1	= 1	; Port D Data Register bit 1
                                 .equ	PD1	= 1	; For compatibility
                                 .equ	PORTD2	= 2	; Port D Data Register bit 2
                                 .equ	PD2	= 2	; For compatibility
                                 .equ	PORTD3	= 3	; Port D Data Register bit 3
                                 .equ	PD3	= 3	; For compatibility
                                 .equ	PORTD4	= 4	; Port D Data Register bit 4
                                 .equ	PD4	= 4	; For compatibility
                                 .equ	PORTD5	= 5	; Port D Data Register bit 5
                                 .equ	PD5	= 5	; For compatibility
                                 .equ	PORTD6	= 6	; Port D Data Register bit 6
                                 .equ	PD6	= 6	; For compatibility
                                 .equ	PORTD7	= 7	; Port D Data Register bit 7
                                 .equ	PD7	= 7	; For compatibility
                                 
                                 ; DDRD - Port D Data Direction Register
                                 .equ	DDD0	= 0	; Port D Data Direction Register bit 0
                                 .equ	DDD1	= 1	; Port D Data Direction Register bit 1
                                 .equ	DDD2	= 2	; Port D Data Direction Register bit 2
                                 .equ	DDD3	= 3	; Port D Data Direction Register bit 3
                                 .equ	DDD4	= 4	; Port D Data Direction Register bit 4
                                 .equ	DDD5	= 5	; Port D Data Direction Register bit 5
                                 .equ	DDD6	= 6	; Port D Data Direction Register bit 6
                                 .equ	DDD7	= 7	; Port D Data Direction Register bit 7
                                 
                                 ; PIND - Port D Input Pins
                                 .equ	PIND0	= 0	; Port D Input Pins bit 0
                                 .equ	PIND1	= 1	; Port D Input Pins bit 1
                                 .equ	PIND2	= 2	; Port D Input Pins bit 2
                                 .equ	PIND3	= 3	; Port D Input Pins bit 3
                                 .equ	PIND4	= 4	; Port D Input Pins bit 4
                                 .equ	PIND5	= 5	; Port D Input Pins bit 5
                                 .equ	PIND6	= 6	; Port D Input Pins bit 6
                                 .equ	PIND7	= 7	; Port D Input Pins bit 7
                                 
                                 
                                 ; ***** EEPROM ***********************
                                 ; EEDR - EEPROM Data Register
                                 .equ	EEDR0	= 0	; EEPROM Data Register bit 0
                                 .equ	EEDR1	= 1	; EEPROM Data Register bit 1
                                 .equ	EEDR2	= 2	; EEPROM Data Register bit 2
                                 .equ	EEDR3	= 3	; EEPROM Data Register bit 3
                                 .equ	EEDR4	= 4	; EEPROM Data Register bit 4
                                 .equ	EEDR5	= 5	; EEPROM Data Register bit 5
                                 .equ	EEDR6	= 6	; EEPROM Data Register bit 6
                                 .equ	EEDR7	= 7	; EEPROM Data Register bit 7
                                 
                                 ; EECR - EEPROM Control Register
                                 .equ	EERE	= 0	; EEPROM Read Enable
                                 .equ	EEWE	= 1	; EEPROM Write Enable
                                 .equ	EEMWE	= 2	; EEPROM Master Write Enable
                                 .equ	EEWEE	= EEMWE	; For compatibility
                                 .equ	EERIE	= 3	; EEPROM Ready Interrupt Enable
                                 
                                 
                                 ; ***** CPU **************************
                                 ; SREG - Status Register
                                 .equ	SREG_C	= 0	; Carry Flag
                                 .equ	SREG_Z	= 1	; Zero Flag
                                 .equ	SREG_N	= 2	; Negative Flag
                                 .equ	SREG_V	= 3	; Two's Complement Overflow Flag
                                 .equ	SREG_S	= 4	; Sign Bit
                                 .equ	SREG_H	= 5	; Half Carry Flag
                                 .equ	SREG_T	= 6	; Bit Copy Storage
                                 .equ	SREG_I	= 7	; Global Interrupt Enable
                                 
                                 ; MCUCR - MCU Control Register
                                 ;.equ	ISC00	= 0	; Interrupt Sense Control 0 Bit 0
                                 ;.equ	ISC01	= 1	; Interrupt Sense Control 0 Bit 1
                                 ;.equ	ISC10	= 2	; Interrupt Sense Control 1 Bit 0
                                 ;.equ	ISC11	= 3	; Interrupt Sense Control 1 Bit 1
                                 .equ	SM0	= 4	; Sleep Mode Select
                                 .equ	SM1	= 5	; Sleep Mode Select
                                 .equ	SM2	= 6	; Sleep Mode Select
                                 .equ	SE	= 7	; Sleep Enable
                                 
                                 ; MCUCSR - MCU Control And Status Register
                                 .equ	MCUSR	= MCUCSR	; For compatibility
                                 .equ	PORF	= 0	; Power-on reset flag
                                 .equ	EXTRF	= 1	; External Reset Flag
                                 .equ	BORF	= 2	; Brown-out Reset Flag
                                 .equ	WDRF	= 3	; Watchdog Reset Flag
                                 
                                 ; OSCCAL - Oscillator Calibration Value
                                 .equ	CAL0	= 0	; Oscillator Calibration Value Bit0
                                 .equ	CAL1	= 1	; Oscillator Calibration Value Bit1
                                 .equ	CAL2	= 2	; Oscillator Calibration Value Bit2
                                 .equ	CAL3	= 3	; Oscillator Calibration Value Bit3
                                 .equ	CAL4	= 4	; Oscillator Calibration Value Bit4
                                 .equ	CAL5	= 5	; Oscillator Calibration Value Bit5
                                 .equ	CAL6	= 6	; Oscillator Calibration Value Bit6
                                 .equ	CAL7	= 7	; Oscillator Calibration Value Bit7
                                 
                                 ; SPMCR - Store Program Memory Control Register
                                 .equ	SPMEN	= 0	; Store Program Memory Enable
                                 .equ	PGERS	= 1	; Page Erase
                                 .equ	PGWRT	= 2	; Page Write
                                 .equ	BLBSET	= 3	; Boot Lock Bit Set
                                 .equ	RWWSRE	= 4	; Read-While-Write Section Read Enable
                                 .equ	RWWSB	= 6	; Read-While-Write Section Busy
                                 .equ	SPMIE	= 7	; SPM Interrupt Enable
                                 
                                 ; SFIOR - Special Function IO Register
                                 .equ	PSR10	= 0	; Prescaler Reset Timer/Counter1 and Timer/Counter0
                                 .equ	PUD	= 2	; Pull-up Disable
                                 .equ	ADHSM	= 4	; ADC High Speed Mode
                                 
                                 
                                 ; ***** AD_CONVERTER *****************
                                 ; ADMUX - The ADC multiplexer Selection Register
                                 .equ	MUX0	= 0	; Analog Channel and Gain Selection Bits
                                 .equ	MUX1	= 1	; Analog Channel and Gain Selection Bits
                                 .equ	MUX2	= 2	; Analog Channel and Gain Selection Bits
                                 .equ	MUX3	= 3	; Analog Channel and Gain Selection Bits
                                 .equ	ADLAR	= 5	; Left Adjust Result
                                 .equ	REFS0	= 6	; Reference Selection Bit 0
                                 .equ	REFS1	= 7	; Reference Selection Bit 1
                                 
                                 ; ADCSRA - The ADC Control and Status register
                                 .equ	ADCSR	= ADCSRA	; For compatibility
                                 .equ	ADPS0	= 0	; ADC  Prescaler Select Bits
                                 .equ	ADPS1	= 1	; ADC  Prescaler Select Bits
                                 .equ	ADPS2	= 2	; ADC  Prescaler Select Bits
                                 .equ	ADIE	= 3	; ADC Interrupt Enable
                                 .equ	ADIF	= 4	; ADC Interrupt Flag
                                 .equ	ADFR	= 5	; ADC  Free Running Select
                                 .equ	ADSC	= 6	; ADC Start Conversion
                                 .equ	ADEN	= 7	; ADC Enable
                                 
                                 
                                 
                                 ; ***** LOCKSBITS ********************************************************
                                 .equ	LB1	= 0	; Lock bit
                                 .equ	LB2	= 1	; Lock bit
                                 .equ	BLB01	= 2	; Boot Lock bit
                                 .equ	BLB02	= 3	; Boot Lock bit
                                 .equ	BLB11	= 4	; Boot lock bit
                                 .equ	BLB12	= 5	; Boot lock bit
                                 
                                 
                                 ; ***** FUSES ************************************************************
                                 ; LOW fuse bits
                                 .equ	CKSEL0	= 0	; Select Clock Source
                                 .equ	CKSEL1	= 1	; Select Clock Source
                                 .equ	CKSEL2	= 2	; Select Clock Source
                                 .equ	CKSEL3	= 3	; Select Clock Source
                                 .equ	SUT0	= 4	; Select start-up time
                                 .equ	SUT1	= 5	; Select start-up time
                                 .equ	BODEN	= 6	; Brown out detector enable
                                 .equ	BODLEVEL	= 7	; Brown out detector trigger level
                                 
                                 ; HIGH fuse bits
                                 .equ	BOOTRST	= 0	; Select Reset Vector
                                 .equ	BOOTSZ0	= 1	; Select Boot Size
                                 .equ	BOOTSZ1	= 2	; Select Boot Size
                                 .equ	EESAVE	= 3	; EEPROM memory is preserved through chip erase
                                 .equ	CKOPT	= 4	; Oscillator Options
                                 .equ	SPIEN	= 5	; Enable Serial programming and Data Downloading
                                 .equ	WTDON	= 6	; Enable watchdog
                                 .equ	RSTDISBL	= 7	; Disable reset
                                 
                                 
                                 
                                 ; ***** CPU REGISTER DEFINITIONS *****************************************
                                 .def	XH	= r27
                                 .def	XL	= r26
                                 .def	YH	= r29
                                 .def	YL	= r28
                                 .def	ZH	= r31
                                 .def	ZL	= r30
                                 
                                 
                                 
                                 ; ***** DATA MEMORY DECLARATIONS *****************************************
                                 .equ	FLASHEND	= 0x0fff	; Note: Word address
                                 .equ	IOEND	= 0x003f
                                 .equ	SRAM_START	= 0x0060
                                 .equ	SRAM_SIZE	= 1024
                                 .equ	RAMEND	= 0x045f
                                 .equ	XRAMEND	= 0x0000
                                 .equ	E2END	= 0x01ff
                                 .equ	EEPROMEND	= 0x01ff
                                 .equ	EEADRBITS	= 9
                                 #pragma AVRPART MEMORY PROG_FLASH 8192
                                 #pragma AVRPART MEMORY EEPROM 512
                                 #pragma AVRPART MEMORY INT_SRAM SIZE 1024
                                 #pragma AVRPART MEMORY INT_SRAM START_ADDR 0x60
                                 
                                 
                                 
                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0xc00
                                 .equ	NRWW_STOP_ADDR	= 0xfff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0xbff
                                 .equ	PAGESIZE	= 32
                                 .equ	FIRSTBOOTSTART	= 0xf80
                                 .equ	SECONDBOOTSTART	= 0xf00
                                 .equ	THIRDBOOTSTART	= 0xe00
                                 .equ	FOURTHBOOTSTART	= 0xc00
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0001	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0002	; External Interrupt Request 1
                                 .equ	OC2addr	= 0x0003	; Timer/Counter2 Compare Match
                                 .equ	OVF2addr	= 0x0004	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0005	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0006	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0007	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x0008	; Timer/Counter1 Overflow
                                 .equ	OVF0addr	= 0x0009	; Timer/Counter0 Overflow
                                 .equ	SPIaddr	= 0x000a	; Serial Transfer Complete
                                 .equ	URXCaddr	= 0x000b	; USART, Rx Complete
                                 .equ	UDREaddr	= 0x000c	; USART Data Register Empty
                                 .equ	UTXCaddr	= 0x000d	; USART, Tx Complete
                                 .equ	ADCCaddr	= 0x000e	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x000f	; EEPROM Ready
                                 .equ	ACIaddr	= 0x0010	; Analog Comparator
                                 .equ	TWIaddr	= 0x0011	; 2-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0012	; Store Program Memory Ready
                                 
                                 .equ	INT_VECTORS_SIZE	= 19	; size in words
                                 
                                 #pragma AVRPART CORE INSTRUCTIONS_NOT_SUPPORTED break
                                 
                                 #endif  /* _M8DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; Step_03.asm
                                 ;
                                 ; Created: 20.02.2026 13:30:00
                                 ; Author : ar_user
                                 ;
                                 
                                 .include "m8def.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega8.xml *************
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m8def.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega8
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega8
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M8DEF_INC_
                                 #endif  /* _M8DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 .list
                                 .include "define.inc"	; Наши все определения переменных тут
                                 
                                  * define.inc
                                  */ 
                                 
                                 .equ F_CPU = 1000000
                                 
                                 ; SPI для 74HC595
                                 .equ SPI_PORT    = PORTB
                                 .equ SPI_DDR     = DDRB		; направление 1 -выход, 0 -вход
                                 .equ SPI_PIN     = PINB		; информация только читается
                                 .equ SCK         = PB5     ; CLOCK
                                 .equ MISO        = PB4     ; не используется
                                 .equ DATA        = PB3     ; DATA (SER)
                                 .equ LATCH       = PB2     ; LATCH (CS)
                                 .equ OE          = PB1     ; ШИМ для яркости (Output Enable, активный низкий)
                                 
                                 .equ BEEPER_PIN  = PB0	   ; Выход для бипера
                                 
                                 ; Кнопки на PD7-PD4 с внешней подтяжкой
                                 .equ BTN_PORT    = PORTD
                                 .equ BTN_DDR     = DDRD
                                 .equ BTN_PIN     = PIND
                                 .equ BTN_MASK    = 0xF0		; PD7-PD4
                                 .equ BTN1        = 7		;PD7 Минус
                                 .equ BTN2        = 6		;PD6 Плюс
                                 .equ BTN3        = 5		;PD5 Вход в настройку (Edit)
                                 .equ BTN4        = 4		;PD4 Режимы дисплея/ Запись времени
                                 
                                 .equ BEEP_LEN   = 5     ; Длительность работы БИППЕРА (3 * 10мс = 30мс)
                                 .def rBeepTimer = r9     ; Счетчик длительности звука (в младших регистрах)
                                 
                                 .equ T_SHORT	= 5        ; 50 мс : Дребезг 5 проходов по 10 мс
                                 .equ Sec_TimeOut     = 50	   ; 50 сек : Время для перехода в режим отображения по умолчанию
                                 
                                 .def rDebounce	 = r8     ; Счетчик антидребезга
                                 .def rBtn_now    = r20    ; Текущее чтение PIND
                                 .def rBtn_Index  = r21	  ; Индекс нажатой кнопки
                                 
                                 ; Кнопки через диоды (на INT1)
                                 .equ BTN_INT   = PD3     ; INT1
                                 
                                 ; DS3231 (на INT0)
                                 .equ DS3231_INT   = PD2     ; INT0
                                 
                                 ; I2C для DS3231
                                 .equ SDA          = PC4
                                 .equ SCL          = PC5
                                 
                                 ; Флаги
                                 .def rFlags = r23		  ; R23 регистр флагов
                                 .equ rFlag_int0   = 0	  ; Бит 0: Событие INT0 (от DS3231)
                                 .equ rFlag_dot  = 1		 ; Бит 1: Фаза мигания точки
                                 .equ rFlag_short  = 2     ; Бит 2: Короткое нажатие
                                 .equ rFlag_TimeOut = 3	  ; Бит 3: TimeOut режимов 
                                 .equ rFlag_beep   = 4     ; Бит 4: Активность бипера (1 - звучит)
                                 
                                 
                                 
                                 ; Сегменты цифр 0b dp,g,f,e,d,c,b,a
                                 			
                                 .equ SEG_0 = 0b00111111
                                 .equ SEG_1 = 0b00000110
                                 .equ SEG_2 = 0b01011011
                                 .equ SEG_3 = 0b01001111
                                 .equ SEG_4 = 0b01100110
                                 .equ SEG_5 = 0b01101101
                                 .equ SEG_6 = 0b01111101
                                 .equ SEG_7 = 0b00000111
                                 .equ SEG_8 = 0b01111111
                                 .equ SEG_9 = 0b01101111
                                 .equ SEG_C = 0b00111001
                                 .equ SEG_E = 0b01111001
                                 .equ SEG_ho = 0b01100011
                                 .equ SEG_lo = 0b01011100
                                 
                                 
                                 ; =========== Сегмент данных ===========
                                 .dseg
                                 .org SRAM_START
                                 
                                 ; Режимы дисплея
000060                           display_mode: .byte 1
                                 .equ MODE_HM     = 0      ; Часы-минуты
                                 .equ MODE_MS     = 1      ; Минуты-секунды
                                 .equ MODE_DM     = 2      ; Число-месяц
                                 .equ MODE_DAY    = 3      ; День недели
                                 .equ MODE_YEAR   = 4      ; Год (2 последние цифры)
                                 
                                 
000061                           edit_mode:    .byte 1
                                 .equ edit_off		= 0      ; редактирование отключено
                                 .equ edit_sec		= 1      ; секунды
                                 .equ edit_min		= 2      ; минуты
                                 .equ edit_hours     = 3      ; часы
                                 .equ edit_weekday   = 4      ; день недели
                                 .equ edit_day		= 5      ; день месяца
                                 .equ edit_mouth		= 6      ; месяц
                                 .equ edit_year		= 7      ; год
                                 
                                 
                                 ; Буферы
000062                           display_buf:  .byte 4
                                 .equ display_1		= display_buf       ; байт первого индикатора
                                 .equ display_2		= display_buf+1     ; байт второго индикатора
                                 .equ display_3		= display_buf+2     ; байт третьего индикатора
                                 .equ display_4		= display_buf+3     ; байт четвертого индикатора
                                 
000066                           i2c_buffer:   .byte 7      ; Буфер для I2C (секунды, минуты, часы, день, дата, месяц, год)
                                 .equ i2c_sec		= i2c_buffer     ; байт секунд в формате BCD 
                                 .equ i2c_min		= i2c_buffer+1   ; байт минут в формате BCD
                                 .equ i2c_hours		= i2c_buffer+2   ; байт часов в формате BCD 
                                 .equ i2c_weekday	= i2c_buffer+3   ; байт дня недели в формате BCD 
                                 .equ i2c_day		= i2c_buffer+4   ; байт дня месяца в формате BCD 
                                 .equ i2c_month		= i2c_buffer+5   ; байт месяца в формате BCD 
                                 .equ i2c_year		= i2c_buffer+6   ; байт года в формате BCD 
                                 
00006d                           rBtn_Save:   .byte 1    ; состояние нажатой кнопки
00006e                           timeout_cnt:  .byte 1    ; счетчик сброса режимов
                                 
                                 .cseg
                                 ; =========== Векторы прерывания ===========
                                 .include "vectors.inc"
                                 
                                 			;.CSEG
                                 			.ORG 	0x0000			; Проц стартует с нуля, но дальше идут вектора 
000000 c02d                      			RJMP 	Reset			; прерываний, поэтому отсюда сразу же прыгаем на начало программы. На метку Reset
                                 			.ORG	INT0addr		; External Interrupt Request 0 = 0x0001
000001 c208                      			RJMP 	INT0_ISR		; Вектор INT0 (DS3231)
                                 			.ORG	INT1addr		; External Interrupt Request 1 = 0x0002
000002 c20d                      			RJMP 	INT1_ISR		; Вектор INT1
                                 			.ORG	OC2addr			; Timer/Counter2 Compare Match = 0x0003
000003 9518                      			RETI	
                                 			.ORG	OVF2addr		; Timer/Counter2 Overflow	= 0x0004
000004 9518                      			RETI
                                 			.ORG	ICP1addr		; Timer/Counter1 Capture Event = 0x0005
000005 9518                      			RETI
                                 			.ORG	OC1Aaddr		; Timer/Counter1 Compare Match A = 0x0006
000006 9518                      			RETI
                                 			.ORG	OC1Baddr		; Timer/Counter1 Compare Match B = 0x0007
000007 9518                      			RETI
                                 			.ORG	OVF1addr		; Timer/Counter1 Overflow = 0x0008
000008 9518                      			RETI
                                 			.ORG	OVF0addr		; Timer/Counter0 Overflow = 0x0009
000009 c216                      			RJMP	TIMER0_ISR		; Jump to Timer0 overflow ISR
                                 			.ORG	SPIaddr			; Serial Transfer Complete = 0x000a
00000a 9518                      			RETI
                                 			.ORG	URXCaddr		; USART, Rx Complete = 0x000b
00000b 9518                      			RETI	
                                 			.ORG	UDREaddr		; USART Data Register Empty = 0x000c
00000c 9518                      			RETI
                                 			.ORG	UTXCaddr		; USART, Tx Complete = 0x000d
00000d 9518                      			RETI
                                 			.ORG	ADCCaddr		; ADC Conversion Complete = 0x000e
00000e 9518                      			RETI
                                 			.ORG	ERDYaddr		; EEPROM Ready = 0x000f
00000f 9518                      			RETI
                                 			.ORG	ACIaddr			; Analog Comparator = 0x0010
000010 9518                      			RETI
                                 			.ORG	TWIaddr			; 2-wire Serial Interface = 0x0011
000011 9518                      			RETI
                                 			.ORG	SPMRaddr		; Store Program Memory Ready = 0x0012
000012 9518                      			RETI
                                 
                                 .org 0x0020
                                 
                                 ; =========== Таблицы ===========
                                 SEG_TABLE:
000020 063f
000021 4f5b
000022 6d66
000023 077d
000024 6f7f                          .db SEG_0, SEG_1, SEG_2, SEG_3, SEG_4, SEG_5, SEG_6, SEG_7, SEG_8, SEG_9
                                 
                                 TABLDISP:
000025 c060                      	rjmp SHOW_HM      ; Индекс 0
000026 c064                      	rjmp SHOW_MS      ; Индекс 1
000027 c069                      	rjmp SHOW_DM      ; Индекс 2
000028 c067                      	rjmp SHOW_DAY     ; Индекс 3
000029 c06c                      	rjmp SHOW_YEAR    ; Индекс 4
                                 
                                 TABLSHORT:
00002a c24e                      	rjmp MINUS		    ; Индекс 0
00002b c247                      	rjmp PLUS	        ; Индекс 1
00002c c23b                      	rjmp CHANGE_ED      ; Индекс 2
00002d c22b                      	rjmp CHANGE_MO      ; Индекс 3
                                 
                                 Reset:
                                     ; Инициализация стека
00002e e004                          ldi r16, high(RAMEND)
00002f bf0e                          out SPH, r16
000030 e50f                          ldi r16, low(RAMEND)
000031 bf0d                          out SPL, r16
                                 
                                 	; Инициализация портов
000032 d01d                          rcall INIT_PORTS
                                 
                                 	; Инициализация переменных
000033 d00a                      	rcall INIT_VARIABLES
                                 
                                 	; Инициализация прерываний
000034 d027                      	rcall INIT_INTERRUPTS
                                 
                                 	; Инициализация DS3231
000035 d104                      	rcall INIT_DS3231
                                 
                                 	; Инициализация SPI
000036 d1bc                      	rcall INIT_SPI
                                 	 
                                 	; Разрешение прерываний
000037 9478                      	sei
                                 
                                 
                                 
                                 MAIN_LOOP:
                                 	; 1. Событие INT0 (RTC секунда прошла)
000038 fd70                          sbrc rFlags, rFlag_int0 ; Пропустить следующую команду если бит в регистре очищен
000039 d030                      	rcall SELECT_DISP
                                 
                                 	; 2. Кнопки
00003a fd72                      	sbrc rFlags, rFlag_short ; Пропустить следующую команду если бит в регистре очищен
00003b d208                      	rcall Press_Short
                                 	
                                 SLEEP_ALL:	
                                 	; Режим сна
00003c 9588                      	 sleep                 ; Перевести МК в режим энергосбережения
                                 
00003d cffa                      	rjmp MAIN_LOOP
                                 
                                 .include "initialization.asm"
                                 
                                  * initialization.asm
                                  *
                                  *  Created: 02.02.2026 16:11:17
                                  *   Author: ar_user
                                  */ 
                                  ; =========== Инициализация переменных ===========
                                 INIT_VARIABLES:
00003e 2411                      	clr r1 ; R1: Всегда 0x00 (ускоряет очистку регистров и портов)
00003f 2455                          clr r5	; Используем в прерывании INT0 для сохранения SREG
000040 2466                      	clr r6	; Используем в прерывании INT1 для сохранения SREG
000041 2477                      	clr r7	; Используем в прерывании TIMER0 OVF для сохранения SREG
000042 2488                      	clr r8	; Счетчик антидребезга
000043 2499                      	clr r9  ; Счетчик длительности звука (в младших регистрах)
000044 2755                      	clr r21	; Индекс нажатой кнопки
                                 	
                                 	; Флаги
000045 2777                           clr rflags ; регистр r23
                                 	     
                                     ; Режимы
000046 e000                      	ldi r16,0
000047 9300 0061                 	sts edit_mode, r16
                                 
000049 e000                      	ldi r16,0
00004a 9300 0060                 	sts display_mode, r16
                                 	
00004c e00a                      	ldi r16,10
00004d 9300 006e                 	sts timeout_cnt, r16
                                 
00004f 9508                      	ret
                                 
                                 ; =========== Инициализация портов ===========
                                 INIT_PORTS:
                                     
                                 	; SPI порты (MOSI, SCK, SS, OE, MR как выходы) и BEEPER_PIN
000050 ea0f                          ldi r16, (1<<DATA)|(1<<SCK)|(1<<LATCH)|(1<<OE)|(1<<BEEPER_PIN)|(1<<PB7)
000051 bb07                          out SPI_DDR, r16
                                     
                                     ; OE (яркость) - низкий уровень по умолчанию (максимальная яркость)
000052 98c1                          cbi SPI_PORT, OE
                                 	     
                                 	    
                                     ; Порт для DS3231 (INT0)
000053 988a                          cbi DDRD, DS3231_INT      ; Вход
000054 9a92                          sbi PORTD, DS3231_INT     ; Подтяжка
                                     
                                     ; Порты для I2C
000055 98a4                          cbi DDRC, SDA             ; SDA - вход
000056 98a5                          cbi DDRC, SCL             ; SCL - вход
000057 9aac                          sbi PORTC, SDA            ; Подтяжка
000058 9aad                          sbi PORTC, SCL            ; Подтяжка
                                 
                                 	; Порты подключенных кнопок как входы и PD3 для INT1, без подтяжки (внешние резисторы на 5в)
000059 e000                          ldi r16, (0<<BTN1)|(0<<BTN2)|(0<<BTN3)|(0<<BTN4)|(0<<BTN_INT); BTN1 это PD7, BTN2 это PD6, BTN3 это PD5, BTN4 это PD4, BTN_INT это PD3
00005a bb01                          out BTN_DDR, r16
                                     
00005b 9508                          ret
                                 
                                 
                                 ; =========== Инициализация прерываний ===========
                                 INIT_INTERRUPTS:
                                 	/*ISC01 ISC00 Описание
                                 	0 		0 Низкий уровень INT0 генерирует запрос прерывания.
                                 	0 		1 Любое логическое изменение на INT0 генерирует запрос прерывания.
                                 	1 		0 Спадающий фронт INT0 генерирует запрос прерывания.
                                 	1 		1 Восходящий фронт INT0 генерирует запрос прерывания.*/
                                     ; INT0 - От DS3231 восходящий фронт генерирует запрос прерывания
00005c e002                          ldi r16, (1<<ISC01)|(0<<ISC00)
00005d bf05                          out MCUCR, r16
00005e e400                          ldi r16, (1<<INT0)
00005f bf0b                          out GICR, r16
                                 
                                 	; INT1 - прерывание от кнопок по нажатию 
                                     ; (нажатие = 1->0 на INT1, отпускание = 0->1)
000060 b705                         in r16, MCUCR
                                     ;ldi r16, (1<<ISC11)|(0<<ISC10)  ; нажатие = 1->0 по спаду (Falling Edge)
000061 6008                      	ori r16, (1<<ISC11)|(0<<ISC10)  ; нажатие = 1->0 по спаду (Falling Edge) добавляем два бита
000062 bf05                          out MCUCR, r16
                                 	; ВКЛЮЧИТЬ INT1 (установить бит INT1, сохранив INT0)
000063 b70b                      	in  r16, GICR        ; Читаем текущее состояние
000064 6800                      	ori r16, (1<<INT1)   ; Устанавливаем только бит INT1 (Разрешение INT1)
000065 bf0b                      	out GICR, r16        ; Записываем обратно, включаем INT1
                                 
                                 	; Разрешаем прерывание по переполнению Таймера 0
000066 b709                          in r16, TIMSK
000067 6001                          ori r16, (1 << TOIE0)
000068 bf09                          out TIMSK, r16
                                     
000069 9508                      
                                 SELECT_DISP:
00006a fd73                      	sbrc rFlags, rFlag_TimeOut ; Пропустить следующую команду если бит в регистре очищен
00006b d009                      	rcall TimeOut
00006c 7f7e                      	cbr rFlags, (1<<rFlag_int0) ; сброс флага
                                 	;rcall TEST_A
                                 	;проверка на режим редактирования
00006d 9120 0061                 	lds r18, edit_mode
00006f 2322                          tst r18
000070 f011                          breq DiWo       ; Переход если равно т.е.если 0 — работаем как обычно
000071 d083                      	rcall DISPLAY_EDIT	;переход в показ режима редактирования
                                 	;rcall TEST_C
000072 c001                      	rjmp OUT_SeDi
                                 DiWo:
000073 d026                      	rcall DISPLAY_WORK ;переход в показ времени
                                 OUT_SeDi:
000074 9508                      	ret
                                 
                                 TimeOut:
000075 930f                      	push r16
000076 932f                      	push r18
                                 	; --- Логика таймаута ---
000077 9120 006e                     lds r18, timeout_cnt
000079 952a                          dec r18             ; Уменьшаем каждую секунду
00007a 9320 006e                     sts timeout_cnt, r18
00007c f431                          brne Out_TO  ; Если еще не ноль, продолжаем (Проверяется флаг нулевого значения (Z) регистра статуса, сдесь реагирует на dec r19)
                                 
00007d 2700                          clr r16             ; Если ноль — сброс режима
00007e 7f77                      	cbr rFlags, (1<<rFlag_TimeOut) ; сброс флага
00007f 9300 0061                     sts edit_mode, r16	
000081 9300 0060                 	sts display_mode, r16
                                 
                                 Out_TO:
000083 912f                      	pop r18
000084 910f                      	pop r16
000085 9508                       ret
                                 
                                 .include "displaywork.asm"
                                 
                                  * displayrtc.asm
                                  *
                                  *  Created: 02.02.2026 16:20:48
                                  *   Author: ar_user
                                  */ 
                                  ; --- Обработчики табличных переходов ---
                                 SHOW_HM:
000086 9100 0068                     lds  r16, i2c_hours
000088 9110 0067                     lds  r17, i2c_min
00008a c023                          rjmp Buffer_disp
                                 
                                 SHOW_MS:
00008b 9100 0067                     lds  r16, i2c_min
00008d 9110 0066                     lds  r17, i2c_sec
00008f c01e                          rjmp Buffer_disp
                                 
                                 SHOW_DAY:
                                 	;ldi  r16, 0x00
                                     ;lds  r17, i2c_weekday
000090 c01d                          rjmp Buffer_disp
                                 
                                 SHOW_DM:
000091 9100 006a                 	lds  r16, i2c_day
000093 9110 006b                     lds  r17, i2c_month
000095 c018                          rjmp Buffer_disp
                                 
                                 SHOW_YEAR:
000096 e200                      	ldi  r16, 0x20
000097 9110 006c                     lds  r17, i2c_year
000099 c014                          rjmp Buffer_disp
                                 
                                 
                                 DISPLAY_WORK:
00009a 930f                      	push r16
00009b 931f                      	push r17
00009c 932f                      	push r18
00009d 93ef                      	push r30
00009e 93ff                      	push r31
                                 
                                 NORMAL_VIEW:
00009f d0a5                      	rcall RTC_ADAPTIVE
0000a0 9100 0060                 	lds r16, display_mode
0000a2 3005                      	cpi R16, 5          ; Проверяем, что индекс меньше 5
0000a3 f430                          brsh Error1     ; Если R16 >= 5, уходим на обработку ошибки
                                 
                                     ; Используем табличный переход
                                 	; Загружаем базовый адрес таблицы
0000a4 e2e5                          ldi  ZL, low(TABLDISP) 
0000a5 e0f0                          ldi  ZH, high(TABLDISP)
                                     ; Прибавляем индекс к адресу (Z = Z + r16)
0000a6 0fe0                          add  ZL, r16
0000a7 2711                          clr  r17
0000a8 1ff1                          adc  ZH, r17              ; Учитываем перенос
                                 
0000a9 9409                          ijmp                      ; ПРЫЖОК в обработчики табличных переходов по адресу в Z 
                                 
                                 Error1:
0000aa 2700                      	clr r16					; обнуляем "мусор" переводим на режим по дефолту
0000ab 9300 0060                 	sts display_mode, r16
0000ad cff1                      	rjmp NORMAL_VIEW
                                 	
                                 		
                                 Buffer_disp:
                                 		
                                 	; Переход для формирования дня недели
0000ae 9120 0060                     lds r18, display_mode
0000b0 3023                      	cpi r18, MODE_DAY
0000b1 f109                      	BREQ MD3
                                 	
                                 			    
                                     ; Формируем 4 цифры:
                                     ; Индикатор 1 (левый): десятки часов
0000b2 2f20                      	mov r18, r16
0000b3 9522                          swap r18
0000b4 702f                          andi r18, 0x0F        ; Десятки часов (0-2)
0000b5 d147                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
0000b6 9320 0062                 	sts display_1, r18     ;  Сохраняем в буфер для левого (первого) индикатора
                                 	    
                                     ; Индикатор 2: единицы часов + точка
0000b8 2f20                          mov r18, r16
0000b9 702f                          andi r18, 0x0F        ; Единицы часов (0-9)
0000ba d142                          rcall DIGIT_TO_SEGMENT ; преобразуем цифру в код сегментов
                                 
                                     ; Добавляем мигающую точку (между часами и минутами) работает только в режиме НМ
0000bb 9100 0060                 	lds r16, display_mode
0000bd 3000                      	cpi R16, MODE_HM
0000be f431                      	brne OUT_DI2 ; Перейти если не равно
                                 	;SBRS rFlags, rFlag_dot ; проверяет состояние одного бита в регистре и пропускает следующую команду если этот бит установлен
0000bf fd71                      	SBRC rFlags, rFlag_dot ; проверяет состояние одного бита в регистре и пропускает следующую команду если этот бит очищен
0000c0 c003                      	rjmp OUT_DI1
0000c1 6820                      	ori r18, (1<<7) ; устанавливаем 7 бит (это точка на 2-ом индикаторе) без изменения остальных
0000c2 6072                      	sbr rFlags, (1<<rFlag_dot)
0000c3 c001                      	rjmp OUT_DI2
                                 OUT_DI1:
0000c4 7f7d                      	cbr rFlags, (1<<rFlag_dot)
                                 OUT_DI2:
0000c5 9320 0063                 	sts display_2, r18     ; Сохраняем в буфер для второго индикатора
                                 
                                 
                                     ; Индикатор 3: Десятки минут
0000c7 2f21                          mov r18, r17
0000c8 9522                          swap r18
0000c9 702f                          andi r18, 0x0F        ; Десятки минут (0-5)
0000ca d132                          rcall DIGIT_TO_SEGMENT
0000cb 9320 0064                     sts display_3, r18     ; третий индикатор
                                     
                                     ; 4. Единицы минут
0000cd 2f21                          mov r18, r17
0000ce 702f                          andi r18, 0x0F        ; Единицы минут (0-9)
0000cf d12d                          rcall DIGIT_TO_SEGMENT
0000d0 9320 0065                     sts display_4, r18     ; четвертый индикатор
                                 	
0000d2 c00e                      	rjmp UPDATE_DISPLAY
                                 
                                 MD3:; формирование дня недели
0000d3 e400                      	ldi r16, 0b01000000
0000d4 9300 0062                 	sts display_1, r16
0000d6 9300 0063                 	sts display_2, r16
0000d8 9300 0065                 	sts display_4, r16	 ; четвертый индикатор
0000da 9110 0069                 	lds  r17, i2c_weekday
0000dc 2f21                      	mov r18, r17
0000dd 702f                          andi r18, 0x0F        ; дни (1-7)
0000de d11e                          rcall DIGIT_TO_SEGMENT
0000df 9320 0064                     sts display_3, r18   ; третий индикатор  
                                 	
                                 	
                                 UPDATE_DISPLAY:	 
                                 	    
                                     ; ВАЖНО: передаем данные в обратном порядке!
                                     ; Первым выводим правый разряд (последний в цепочке 74HC595)
                                     
0000e1 9100 0065                 	lds r16,display_4
0000e3 d114                      	rcall spi_send
0000e4 9100 0064                 	lds r16,display_3
0000e6 d111                      	rcall spi_send
0000e7 9100 0063                 	lds r16,display_2
0000e9 d10e                      	rcall spi_send
0000ea 9100 0062                 	lds r16,display_1
0000ec d10b                      	rcall spi_send
                                 
                                 	    
                                     ; Защелкиваем данные (импульс на SS/CS)
0000ed 9ac2                      	sbi SPI_PORT, LATCH
                                 	;nop
0000ee 98c2                      	cbi SPI_PORT, LATCH 
                                 
                                 	;rcall TEST_A
                                 
0000ef 91ff                      	pop r31
0000f0 91ef                      	pop r30
0000f1 912f                      	pop r18
0000f2 911f                      	pop r17
0000f3 910f                      	pop r16
                                 
0000f4 9508                          ret
                                 	
                                 
                                 
                                 .include "displayedit.asm"
                                 
                                  * displayedit.asm
                                  *
                                  *  Created: 04.02.2026 13:29:19
                                  *   Author: ar_user
                                  */ 
                                 
                                 
                                  DISPLAY_EDIT:
0000f5 930f                      	push r16
0000f6 931f                      	push r17
0000f7 932f                      	push r18
0000f8 93ef                      	push r30
0000f9 93ff                      	push r31
                                 
0000fa 9100 0061                 	lds r16, edit_mode
0000fc 3008                      	cpi R16, 8          ; Проверяем, что индекс меньше 8
0000fd f428                          brsh Error2     ; Если R16 >= 8, уходим на обработку ошибки
0000fe 2f20                      	mov r18,r16
0000ff d0fd                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
000100 9320 0062                 	sts display_1, r18     ;  Сохраняем в буфер для левого (первого) индикатора
000102 c004                      	rjmp DE1
                                 Error2:
000103 2722                      	clr r18					; обнуляем "мусор" переводим на режим по дефолту
000104 9320 0061                 	sts edit_mode, r18
000106 c02d                      	rjmp OUT_UD2
                                 DE1:
000107 d013                      	rcall Disp_2 ; анимация 2-ого идикатора
                                 	
                                 
                                 	;Находим нужный байт времени
000108 e6a6                      	ldi  XL, low(i2c_buffer)
000109 e0b0                          ldi  XH, high(i2c_buffer)
00010a 950a                          dec  r16                ;делаю декримент для правильной работы мне надо чтобы индекс edit_mode начинался с нуля Делаем из 1..7 -> 0..6
00010b 0fa0                          add  XL, r16
00010c 2700                          clr  r16
00010d 1fb0                          adc  XH, r16
                                 
00010e 911c                          ld   r17, X             ; Загружаем в r17 значение нужного байта по адресу Х
                                 
00010f 2f21                      	mov r18, r17
000110 9522                          swap r18
000111 702f                          andi r18, 0x0F        ; Десятки
000112 d0ea                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
000113 9320 0064                 	sts display_3, r18     ;  Сохраняем в буфер для третьего индикатора
                                 	    
                                     ; Индикатор 4: единицы
000115 2f21                          mov r18, r17
000116 702f                          andi r18, 0x0F        ; Единицы
000117 d0e5                          rcall DIGIT_TO_SEGMENT ; преобразуем цифру в код сегментов
000118 9320 0065                 	sts display_4, r18
                                 
00011a c00a                      	rjmp UPDATE_DISPLAY_2
                                 
                                 
                                 ; анимация 2-ого идикатора
                                 disp_2:
                                 
00011b fd71                      	sbrc rflags, rflag_dot ; проверяет состояние одного бита в регистре и пропускает следующую команду если этот бит очищен
00011c c003                      	rjmp holo
00011d e52c                      	ldi  r18,seg_lo
00011e 6072                      	sbr rFlags, (1<<rFlag_dot)
00011f c002                      	rjmp loho
                                 holo:
000120 e623                      	ldi  r18,seg_ho
000121 7f7d                      	cbr rFlags, (1<<rFlag_dot)
                                 loho:	
000122 9320 0063                 	sts display_2, r18
                                 	/*ldi r18,0b01001001
                                 	sts display_2, r18*/
000124 9508                      	ret
                                 
                                 
                                 UPDATE_DISPLAY_2:	 
                                 	    
000125 9100 0065                 	lds r16,display_4
000127 d0d0                      	rcall spi_send
000128 9100 0064                 	lds r16,display_3
00012a d0cd                      	rcall spi_send
00012b 9100 0063                 	lds r16,display_2
00012d d0ca                      	rcall spi_send
00012e 9100 0062                 	lds r16,display_1
000130 d0c7                      	rcall spi_send
                                 
                                 	    
                                     ; Защелкиваем данные (импульс на SS/CS)
000131 9ac2                      	sbi SPI_PORT, LATCH
000132 0000                      	nop
000133 98c2                      	cbi SPI_PORT, LATCH 
                                 OUT_UD2:
000134 91ff                      	pop r31
000135 91ef                      	pop r30
000136 912f                      	pop r18
000137 911f                      	pop r17
000138 910f                      	pop r16
                                 .include "i2c.asm"	
000139 9508                      
                                  * i2c.asm
                                 */ 
                                 ; =========== Инициализация DS3231 ===========
                                 INIT_DS3231:
00013a d0a0                          rcall I2C_INIT
                                     
00013b d0a4                          rcall I2C_START
00013c ed00                          ldi r16, 0xD0		;адрес DS3231
00013d d0a8                          rcall I2C_WRITE
                                     
00013e e00e                          ldi r16, 0x0E		; адресс Control Register (0Eh) DS3231 
00013f d0a6                          rcall I2C_WRITE
                                     
000140 e000                          ldi r16, 0x00		; запись в Control Register (0Eh) DS3231 Установка SQW на 1 Гц
000141 d0a4                          rcall I2C_WRITE
                                     
000142 d0ad                          rcall I2C_STOP
                                 
000143 d022                      	rcall READ_DATETIME_FULL
                                 	;rcall READ_DATETIME
                                 
000144 9508                          ret
                                 
                                 ; Подстраиваем глубину опроса времени.
                                 ; В режимах показа часов-минут, минут-секунд читаем только первые 3 байта (Сек, Мин, Час)
                                 ; В режимах день недели, день-месяц, год читаем 7 байт
                                 RTC_ADAPTIVE:
000145 9100 0060                 	lds r16, display_mode
000147 3002                          cpi r16, MODE_DM          ; Если режим Дата, День или Год
000148 f410                          brsh READ_FULL            ; Переход если больше или равно (Читаем все 7 байт)
                                 
                                     ; Иначе (HM или MS) — читаем только первые 3 байта (Сек, Мин, Час)
                                     ;ldi r17, 3
000149 d003                          rcall READ_DATETIME
00014a c001                          rjmp OUT_RTC
                                 
                                 READ_FULL:
                                     ;ldi r17, 7
00014b d01a                          rcall READ_DATETIME_FULL
                                 OUT_RTC:
00014c 9508                      	ret
                                 
                                 ;============== Чтение времени из DS3231 ==================================
                                 
                                 READ_DATETIME:
00014d 930f                          push r16
00014e 7f7e                      	 cbr rFlags, (1<<rFlag_int0)       
                                     ;rcall I2C_INIT
                                     
00014f d090                          rcall I2C_START
                                     ; Адрес DS3231 для записи
000150 ed00                          ldi r16, 0xD0
000151 d094                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x00 (секунды)
000152 e000                          ldi r16, 0x00
000153 d092                          rcall I2C_WRITE
                                     
000154 d08b                      	rcall I2C_START
                                     ; Повторный START для чтения
000155 ed01                          ldi r16, 0xD1
000156 d08f                          rcall I2C_WRITE
                                 		
000157 d092                      	rcall I2C_READ_ACK
000158 b103                      	in r16, TWDR
000159 9300 0066                 	sts i2c_sec,r16
                                 	
00015b d08e                      	rcall I2C_READ_ACK
00015c b103                      	in r16, TWDR
00015d 9300 0067                 	sts i2c_min,r16
                                 	
00015f d08d                      	rcall I2C_READ_NACK
000160 b103                      	in r16, TWDR
000161 9300 0068                 	sts i2c_hours,r16
                                 		
000163 d08c                      	rcall I2C_STOP
                                 	
000164 910f                      	pop r16
000165 9508                         ret
                                 
                                 ;============== Чтение времени из DS3231 ==================================
                                 
                                 READ_DATETIME_FULL:
000166 930f                          push r16
                                 	        
                                         
000167 d078                          rcall I2C_START
                                     ; Адрес DS3231 для записи
000168 ed00                          ldi r16, 0xD0
000169 d07c                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x00 (секунды)
00016a e000                          ldi r16, 0x00
00016b d07a                          rcall I2C_WRITE
                                     
00016c d073                      	rcall I2C_START
                                     ; Повторный START для чтения
00016d ed01                          ldi r16, 0xD1
00016e d077                          rcall I2C_WRITE
                                 		
00016f d07a                      	rcall I2C_READ_ACK
000170 b103                      	in r16, TWDR
000171 9300 0066                 	sts i2c_sec,r16
                                 	
000173 d076                      	rcall I2C_READ_ACK
000174 b103                      	in r16, TWDR
000175 9300 0067                 	sts i2c_min,r16
                                 
000177 d072                      	rcall I2C_READ_ACK
000178 b103                      	in r16, TWDR
000179 9300 0068                 	sts i2c_hours,r16
                                 
00017b d06e                      	rcall I2C_READ_ACK
00017c b103                      	in r16, TWDR
00017d 9300 0069                 	sts i2c_weekday,r16
                                 
00017f d06a                      	rcall I2C_READ_ACK
000180 b103                      	in r16, TWDR
000181 9300 006a                 	sts i2c_day,r16
                                 
000183 d066                      	rcall I2C_READ_ACK
000184 b103                      	in r16, TWDR
000185 9300 006b                 	sts i2c_month,r16
                                 	
000187 d065                      	rcall I2C_READ_NACK
000188 b103                      	in r16, TWDR
000189 9300 006c                 	sts i2c_year,r16
                                 		
00018b d064                      	rcall I2C_STOP
                                 	
00018c 910f                      	pop r16
00018d 9508                         ret
                                 
                                 
                                 ; =========== Запись времени в DS3231 ===========
                                 WRITE_DATETIME:
00018e 930f                          push r16
                                     
                                     ;rcall I2C_INIT
                                     
00018f d050                      	rcall I2C_START
000190 ed00                          ldi r16, 0xD0
000191 d054                          rcall I2C_WRITE
                                     
000192 e000                          ldi r16, 0x00
000193 d052                          rcall I2C_WRITE
                                     
000194 9100 0066                     lds r16, i2c_sec
000196 d04f                          rcall I2C_WRITE
                                     
000197 9100 0067                     lds r16, i2c_min
000199 d04c                          rcall I2C_WRITE
                                     
00019a 9100 0068                     lds r16, i2c_hours
00019c d049                          rcall I2C_WRITE
                                     
00019d d052                          rcall I2C_STOP
                                 
00019e 910f                          pop r16
00019f 9508                          ret
                                 
                                 ;============== Запись определенных параметров времени в DS3231 ====================
                                 	WRITE_SPECIFIC_TIME:
0001a0 930f                      	push r16
                                 
0001a1 d03e                      	rcall I2C_START
0001a2 ed00                          ldi r16, 0xD0
0001a3 d042                          rcall I2C_WRITE
                                 
0001a4 9100 0061                 	lds r16, edit_mode
                                 ;запись секунд
0001a6 3001                      	cpi r16,1		;
0001a7 f429                      	BRNE M_Wr		;Перейти если не равно
0001a8 e000                      	ldi r16, 0x00	; адрес регистра секенд
0001a9 d03c                      	rcall I2C_WRITE
0001aa 9100 0066                 	lds r16, i2c_sec
0001ac c02a                          rjmp WR_T
                                 ;запись минут
                                 M_Wr:
0001ad 3002                      	cpi r16,2		;
0001ae f429                      	BRNE H_Wr		;Перейти если не равно
0001af e001                      	ldi r16, 0x01	; адрес регистра минут
0001b0 d035                      	rcall I2C_WRITE
0001b1 9100 0067                 	lds r16, i2c_min
0001b3 c023                          rjmp WR_T
                                 ;запись часов
                                 H_Wr:
0001b4 3003                      	cpi r16,3		;
0001b5 f429                      	BRNE WD_Wr		;Перейти если не равно
0001b6 e002                      	ldi r16, 0x02	; адрес регистра часов
0001b7 d02e                      	rcall I2C_WRITE
0001b8 9100 0068                 	lds r16, i2c_hours
0001ba c01c                          rjmp WR_T
                                 ;запись дня недели
                                 WD_Wr:
0001bb 3004                      	cpi r16,4		;
0001bc f429                      	BRNE D_Wr		;Перейти если не равно
0001bd e003                      	ldi r16, 0x03	; адрес регистра дня недели
0001be d027                      	rcall I2C_WRITE
0001bf 9100 0069                 	lds r16, i2c_weekday
0001c1 c015                      	rjmp WR_T
                                 ;запись дня месяца
                                 D_Wr:
0001c2 3005                      	cpi r16,5		;
0001c3 f429                      	BRNE MO_Wr		;Перейти если не равно
0001c4 e004                      	ldi r16, 0x04	; адрес регистра дня месяца
0001c5 d020                      	rcall I2C_WRITE
0001c6 9100 006a                 	lds r16, i2c_day
0001c8 c00e                          rjmp WR_T
                                 ;запись месяца
                                 MO_Wr:
0001c9 3006                      	cpi r16,6		;
0001ca f429                      	BRNE Y_Wr		;Перейти если не равно
0001cb e005                      	ldi r16, 0x05	; адрес регистра месяца
0001cc d019                      	rcall I2C_WRITE
0001cd 9100 006b                 	lds r16, i2c_month
0001cf c007                      	rjmp WR_T
                                 ;запись года
                                 Y_Wr:
0001d0 3007                      	cpi r16,7		;
0001d1 f439                      	BRNE St_Wr		;Перейти если не равно
0001d2 e006                      	ldi r16, 0x06	; адрес регистра года
0001d3 d012                      	rcall I2C_WRITE
0001d4 9100 006c                 	lds r16, i2c_year
0001d6 c000                          rjmp WR_T
                                 
                                 WR_T:	
0001d7 d00e                      	rcall I2C_WRITE
0001d8 d017                          rcall I2C_STOP
                                 St_Wr:
0001d9 910f                      	pop r16
0001da 9508                          ret
                                 
                                 
                                 ; =========== I2C процедуры ===========
                                 I2C_INIT:
0001db e00b                          ldi r16, 11
0001dc b900                          out TWBR, r16 ; TWI Bit Rate Register  коэффициент деления для генератора скорости передачи данных
0001dd e000                          ldi r16, (0<<TWPS1)|(0<<TWPS0) ; биты предварительного делителя в регистр TWSR (PrescalerValue = 1)
0001de b901                          out TWSR, r16
0001df 9508                          ret
                                 
                                 	; TWINT  устанавливается аппаратно, когда TWI завершил свою текущую работу и ожидает ответа 
                                 	; TWEN разрешает работу TWI и активирует интерфейс TWI
                                 	; TWSTA генерирует условие START
                                 I2C_START:
0001e0 ea04                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTA)
0001e1 bf06                          out TWCR, r16
                                 
                                 I2C_WAIT:
0001e2 b706                          in r16, TWCR
0001e3 ff07                          sbrs r16, TWINT ;  проверяет состояние 7 бита TWINT в регистре и, если этот бит установлен, пропускает следующую команду
0001e4 cffd                          rjmp I2C_WAIT
0001e5 9508                          ret
                                 
                                 I2C_WRITE:
0001e6 b903                          out TWDR, r16
0001e7 e804                          ldi r16, (1<<TWINT)|(1<<TWEN)
0001e8 bf06                          out TWCR, r16
0001e9 cff8                          rjmp I2C_WAIT
                                 
                                 	; TWEA: TWI Enable Acknowledge Bit 
                                 I2C_READ_ACK:
0001ea ec04                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWEA)
0001eb bf06                          out TWCR, r16
0001ec cff5                          rjmp I2C_WAIT
                                 
                                 I2C_READ_NACK:
0001ed e804                          ldi r16, (1<<TWINT)|(1<<TWEN)
0001ee bf06                          out TWCR, r16
0001ef cff2                          rjmp I2C_WAIT
                                 
                                 	; TWSTO: TWI STOP Condition Bit 
                                 I2C_STOP:
0001f0 e904                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
0001f1 bf06                          out TWCR, r16
0001f2 9508                          ret
                                 
                                 .include "spi.asm"
                                 
                                  * spi_1.asm
                                  *
                                  *  Created: 07.01.2026 22:45:59
                                  *   Author: ar_user
                                  */ 
                                  INIT_SPI:
                                 ; Включение SPI, режим Master, частота F_CPU/16
0001f3 e501                          ldi r16, (1<<SPE)|(1<<MSTR)|(0<<SPR1)|(1<<SPR0)
0001f4 b90d                          out SPCR, r16
                                     ;ldi r16, (0<<SPI2X); этот бит в нуль для полного спокойствия
0001f5 e001                      	ldi r16, (1<<SPI2X); Бит удвоения скорости SPI
0001f6 b90e                          out SPSR, r16
0001f7 9508                          ret
                                 
                                 
                                 ;=================== SPI_SEND (ОТПРАВКА БАЙТА ЧЕРЕЗ SPI)===================
                                 
                                 SPI_SEND:
                                     ; Вход: r16 = данные для отправки
                                     ; Выход: данные отправлены через аппаратный SPI
                                     
0001f8 b90f                          out SPDR, r16          ; Записываем данные в регистр SPI
                                 
                                 SPI_WAIT:
0001f9 b10e                          in r16, SPSR           ; Читаем статус SPI
0001fa ff07                          sbrs r16, SPIF         ; Пропустить следующую команду если бит в регистре установлен. Проверяем флаг завершения передачи
0001fb cffd                      	rjmp SPI_WAIT          ; Ждем завершения
                                     
0001fc 9508                          ret
                                 
                                 DIGIT_TO_SEGMENT:
                                     ; Вход: r18 = цифра (0-9)
                                     ; Выход: r18 = код сегментов для этой цифры
                                     ; Использует: Z, r17
                                 
0001fd 93ef                          push ZL
0001fe 93ff                          push ZH
0001ff 931f                          push r17
                                    
000200 e4e0                          ldi ZL, low(SEG_TABLE*2)
000201 e0f0                          ldi ZH, high(SEG_TABLE*2)
000202 0fe2                          add ZL, r18
000203 2711                          clr r17
000204 1ff1                          adc ZH, r17
000205 9124                          lpm r18, Z
                                 
000206 911f                          pop r17
000207 91ff                          pop ZH
000208 91ef                          pop ZL
000209 9508                          ret
                                 
                                  ;=========== Прерывание от DS3231 (INT0) ===========
                                 INT0_ISR:
                                 
00020a b65f                          in r5, SREG
00020b 930f                          push r16
                                 	
00020c 6071                      	sbr rFlags, (1<<rFlag_int0) ; устанавливаем флаг
                                    	
00020d 910f                      	pop r16
00020e be5f                          out SREG, r5
                                 	
00020f 9518                          reti
                                 
                                 INT1_ISR:
000210 b66f                      	in r6, SREG
000211 930f                          push r16
                                 
                                 	; ВЫКЛЮЧИТЬ INT1, чтобы не частил (сбросить бит INT1, сохранив INT0)
                                 	/*in  r16, GICR			; Читаем текущее состояние прерываний
                                 	andi r16, ~(1<<INT1)	; Сбрасываем только бит INT1 (это способ создать маску для инвертирования нужного бита в регистре микроконтроллера)
                                 	out GICR, r16			; Выключаем INT1*/
                                 
000212 b70b                      	in r16, GICR
000213 770f                          cbr r16, (1<<INT1)
000214 bf0b                          out GICR, r16
                                 
                                 	; Запуск Таймера 0
                                 	/*; Устанавливаем предделитель (для 10мс)
                                 	Частота МК: 1 000 000 Гц.
                                 	Максимальный предделитель: 1024.
                                 	Частота таймера: 1000000/1024=976,5 Гц.
                                 	Период одного тика: =1,024 мс.
                                 	Количество тиков для 10 мс: 10/1,024=9,76.
                                 	10 мс — это почти ровно 10 тиков таймера при предделителе 1024.
                                 	Это дает погрешность около 2.4% (реально будет 10.24 мс), что для кнопок абсолютно не критично.
                                 	Чтобы таймер срабатывал каждые 10 тиков, мы будем использовать прерывание по переполнению (OVF) и при каждом входе догружать в счетчик значение, чтобы он быстрее добегал до 256.
                                  	Расчет: 256-10=246  (0xF6).*/
                                 	;ldi r16, 246        ; Заряжаем на 10 тиков до переполнения
000215 ef06                      	ldi r16, 246
000216 bf02                          out TCNT0, r16
000217 e005                          ldi r16, (1<<CS02)|(0<<CS01)|(1<<CS00) ; Предделитель 1024 (Запуск)
000218 bf03                          out TCCR0, r16
                                 
                                 	
                                 	; Чистим флаг INT1 (дребезг при отпускании)
                                 	; 1. Сначала сбрасываем флаг INT1 (записью единицы!)
000219 e800                          ldi r16, (1<<INTF1)
00021a bf0a                          out GIFR, r16    ; Запись '1' в флаг прерывания очищает его    
                                     
                                 	; 2. Теперь безопасно включаем INT1
00021b b70b                          in r16, GICR
00021c 6800                          ori r16, (1<<INT1)
00021d bf0b                          out GICR, r16        ; Снова включаем ожидание нажатия (INT1)
                                 
00021e 910f                      	pop r16
00021f be6f                          out SREG, r6
                                 
                                 	.include "button.asm"
                                 
                                  * button.asm
                                  *
                                  *  Created: 09.02.2026 20:48:56
                                  *   Author: ar_user
                                  */ 
                                  TIMER0_ISR:
                                 	;sbi PORTB, PB0        ; ПОДНЯТЬ PB0 (Начало импульса)  для осцилла
                                 
000220 b67f                      	in r7, SREG         ; Быстро сохраняем статус в R7 (1 такт)
000221 930f                          push r16
000222 934f                      	push r20
                                 	
                                 	; 1. Перезапуск таймера (Т0 требует ручной дозагрузки)
000223 ef06                          ldi r16, 246
000224 bf02                          out TCNT0, r16
                                 
                                 	; 1. Читаем и инвертируем
000225 b340                          in   rBtn_now, BTN_PIN	; Считываем весь порт D
000226 9540                          com  rBtn_now			; Инвертируем (нажатая кнопка теперь "1")
000227 7f40                          andi rBtn_now, BTN_MASK	; Оставляем только PD4-PD7 (BTN_MASK=0xF0)
                                 
                                     ; 2. Если ничего не нажато — сброс счетчика и выход (или выключение)
000228 2344                          tst  rBtn_now
000229 f071                          breq BTN_RESET_CNT		; Перейти если равно 0 — кнопка отпущена
                                 
                                     ; 3. Кнопка нажата — увеличиваем счетчик
00022a 9483                          inc  rDebounce
00022b e005                      	ldi r16, T_SHORT 
00022c 1680                          cp  rDebounce, r16
00022d f090                          brlo TIM0_EXIT          ; Если еще не накопили 3 такта — просто выходим
                                 
                                     ; --- Кнопка подтверждена (нажата стабильно ~45-50 мс) ---
00022e 6074                          sbr  rFlags, (1<<rFlag_short)
                                     
                                     ; Перевод в индекс (0-3)
00022f 9542                          swap rBtn_now
000230 e050                          ldi  rBtn_Index, 0
                                 FIND_IDX:
000231 fd43                          sbrc rBtn_now, 3
000232 c003                          rjmp BTN_SAVE
000233 9553                          inc  rBtn_Index
000234 0f44                          lsl  rBtn_now
000235 cffb                          rjmp FIND_IDX
                                 
                                 BTN_SAVE:
000236 9350 006d                     sts  rBtn_Save, rBtn_Index
                                     ; Теперь выключаем таймер, чтобы не частил
                                     ;rjmp STOP_TIMER
                                 
                                 BTN_RESET_CNT:
000238 2488                          clr  rDebounce
                                     ; Если кнопка пропала сразу (помеха), выключаем таймер
                                     ; Если хотим ловить длинные нажатия — логика меняется
                                 
                                 STOP_TIMER:
000239 e000                          ldi  r16, 0
00023a bf03                          out  TCCR0, r16 ; ВЫКЛЮЧАЕМ ТАЙМЕР 0 
                                     ; Чистим флаг INT1 (дребезг при отпускании)
                                 	; 1. Сначала сбрасываем флаг INT1 (записью единицы!)
00023b e800                          ldi r16, (1<<INTF1)
00023c bf0a                          out GIFR, r16    ; Запись '1' в флаг прерывания очищает его    
                                     
                                 	; 2. Теперь безопасно включаем INT1
00023d b70b                          in r16, GICR
00023e 6800                          ori r16, (1<<INT1)
00023f bf0b                          out GICR, r16        ; Снова включаем ожидание нажатия (INT1)
                                 
                                 TIM0_EXIT:
                                    
000240 914f                      	pop r20
000241 910f                          pop r16
000242 be7f                          out SREG, r7
                                 
                                 	;cbi PORTB, PB0        ; ОПУСТИТЬ PB0 (Конец импульса) для осцилла
000243 9518                      reti
                                 
                                 
                                 Press_Short:
000244 930f                      	push r16
000245 d00a                      	rcall Progra_Short
000246 7f7b                      	cbr rFlags, (1<<rFlag_Short)
000247 6078                      	sbr rFlags, (1<<rFlag_TimeOut) ; установка флага
000248 e302                      	ldi r16,Sec_TimeOut		;вот они 50 секунд для TimeOut
000249 9300 006e                 	sts timeout_cnt, r16
00024b 2700                      	clr r16
00024c 9300 006d                 	sts rBtn_Save, r16
00024e 910f                      	pop r16
00024f 9508                      	ret
                                 
                                  
                                  Progra_Short:
000250 9100 006d                 	lds r16, rBtn_Save
                                 	;mov r16, rBtn_index
                                 	; Используем табличный переход
                                 	; Загружаем базовый адрес таблицы
000252 e2ea                          ldi  ZL, low(TABLSHORT) 
000253 e0f0                          ldi  ZH, high(TABLSHORT)
                                     ; Прибавляем индекс к адресу (Z = Z + r16)
000254 0fe0                          add  ZL, r16
000255 2711                          clr  r17
000256 1ff1                          adc  ZH, r17              ; Учитываем перенос
                                 
000257 9409                          ijmp                      ; ПРЫЖОК в обработчики табличных переходов по адресу в Z 
                                 
000258 9508                       ret
                                 
                                 
                                 CHANGE_MO:
000259 9100 0061                 	lds r16, edit_mode
00025b 2300                          tst r16
00025c f011                          breq MODE_NEXT		   ; Перейти если равно 0, т.е. мы не в режиме редактирования
00025d d021                          rcall SAVE_TO_RTC      ; Если были в редактировании времени - сохраняем
00025e 9508                          ret
                                 MODE_NEXT:
00025f 9100 0060                     lds r16, display_mode
000261 9503                          inc r16
000262 3006                          cpi r16, 6
000263 f008                          brlo MO_ST			; Перейти если меньше
000264 2700                          clr r16
                                 MO_ST:
000265 9300 0060                     sts display_mode, r16
000267 9508                       ret
                                 
                                 CHANGE_ED:
000268 9100 0061                 	lds r16, edit_mode
00026a 9503                          inc r16
00026b 3008                          cpi r16, 8             ; 7 параметров + 1 выход
00026c f008                          brlo ED_ST
00026d 2700                          clr r16
                                 ED_ST:
00026e 9300 0061                     sts edit_mode, r16
000270 9300 0060                 	sts display_mode, r16
                                     
000272 9508                      ret
                                 
                                 PLUS:
000273 9100 0061                 	lds  r16, edit_mode
000275 2300                          tst  r16
000276 f009                          breq Pl_DONE           ; Если не в режиме настройки — Плюс ничего не делает
000277 d010                          rcall VALUE_UP         ; Вызываем наш универсальный инкремент через X
                                 Pl_DONE:
                                     
000278 9508                      ret
                                 
                                 MINUS:
000279 9100 0061                 	lds  r16, edit_mode
00027b 2300                          tst  r16
00027c f009                          breq Mi_DONE           ; Если не в режиме настройки — Плюс ничего не делает
00027d d024                          rcall VALUE_DOWN         ; Вызываем наш универсальный инкремент через X
                                 Mi_DONE:
                                     
00027e 9508                      ret
                                 
                                  
                                  SAVE_TO_RTC:
00027f 9100 0061                 	lds r16, edit_mode
000281 df1e                      	rcall WRITE_SPECIFIC_TIME
000282 2700                      	clr r16
000283 9300 0061                 	sts edit_mode, r16
000285 9300 0060                 	sts display_mode, r16
000287 9508                       ret
                                 
                                  VALUE_UP:
                                 	
000288 9100 0061                 	lds  r16, edit_mode
00028a 2300                          tst  r16
00028b f0a9                          breq VU_EXIT            ; Если 0 — мы не в режиме настройки, выходим
                                 
                                     ; Вычисляем адрес нужного байта в i2c_buffer
00028c e6a6                          ldi  XL, low(i2c_buffer)
00028d e0b0                          ldi  XH, high(i2c_buffer)
                                     
                                     ; Смещение: DS3231 имеет порядок Сек(0), Мин(1), Час(2)...
                                     ; Настраиваем указатель: X = i2c_buffer + (edit_mode - 1)
00028e 2f10                          mov  r17, r16
00028f 951a                          dec  r17                ; Делаем из 1..7 -> 0..6
000290 0fa1                          add  XL, r17
000291 2711                          clr  r17
000292 1fb1                          adc  XH, r17            ; Указатель X теперь смотрит прямо на байт в SRAM
                                 
000293 910c                          ld   r16, X             ; Загружаем значение (например, минуты)
                                     
                                     ; Определяем предел для текущего параметра
000294 d02d                          rcall GET_LIMIT         ; Возвращает предел в r17 (напр. 0x60 для минут)
                                     
                                     ; Инкремент BCD
000295 5f0f                          subi r16, -1            ; +1
000296 2f20                          mov  r18, r16
000297 702f                          andi r18, 0x0F
000298 302a                          cpi  r18, 0x0A          ; Проверка полупереноса
000299 f008                          brlo VU_CHECK_LIMIT
00029a 5f0a                          subi r16, -6            ; Коррекция BCD (+6)
                                 
                                 VU_CHECK_LIMIT:
00029b 1701                          cp   r16, r17           ; Проверка достижения максимума
00029c f008                          brlo VU_SAVE
00029d e000                          ldi  r16, 0x00          ; Сброс в ноль
                                 
                                 VU_SAVE:
00029e 930c                          st   X, r16             ; Сохраняем обратно в i2c_buffer
00029f 7f7d                      	cbr rFlags, (1<<rFlag_dot)
0002a0 de54                          rcall DISPLAY_EDIT ; Сразу обновляем экран для отклика
                                 VU_EXIT:
0002a1 9508                       ret
                                 
                                 
                                  VALUE_DOWN:
                                 
0002a2 9110 0061                 	lds  r17, edit_mode
0002a4 2311                          tst  r17
0002a5 f0d9                          breq VD_EXIT            ; Если 0 — выходим
                                 
                                     ; Настройка указателя X на нужный байт в i2c_buffer
0002a6 e6a6                          ldi  XL, low(i2c_buffer)
0002a7 e0b0                          ldi  XH, high(i2c_buffer)
0002a8 951a                          dec  r17                ; Смещение (0..6)
0002a9 0fa1                          add  XL, r17
0002aa 2711                          clr  r17
0002ab 1fb1                          adc  XH, r17
                                 
0002ac 910c                          ld   r16, X             ; Загружаем значение (напр. 0x10)
                                 
                                     
                                     ; --- Сама логика декремента BCD ---
0002ad 2300                          tst  r16                ; Проверяем, не ноль ли уже?
0002ae f039                          breq VD_SET_MAX         ; Если 0x00, переходим к максимальному пределу
                                     
0002af 5001                          subi r16, 1             ; Вычитаем 1 (0x10 -> 0x0F)
0002b0 2f20                          mov  r18, r16
0002b1 702f                          andi r18, 0x0F          ; Изолируем младшую тетраду
0002b2 302f                          cpi  r18, 0x0F          ; Был ли переход через ноль (заем)?
0002b3 f459                          brne VD_SAVE            ; Если нет (результат 0..8) — всё ок
                                     
0002b4 5006                          subi r16, 6             ; Коррекция: 0x0F - 0x06 = 0x09
0002b5 c009                          rjmp VD_SAVE
                                 
                                 VD_SET_MAX:
0002b6 d00b                          rcall GET_LIMIT         ; Получаем предел (напр. 0x60 для минут) в r17
0002b7 2f01                          mov  r16, r17
                                     ; Нужно уменьшить предел на 1 шаг BCD, так как предел 0x60 — это уже "перебор"
                                     ; Чтобы получить 0x59 из 0x60:
0002b8 5001                          subi r16, 1
0002b9 2f20                          mov  r18, r16
0002ba 702f                          andi r18, 0x0F
0002bb 302f                          cpi  r18, 0x0F
0002bc f411                          brne VD_SAVE
0002bd 5006                          subi r16, 6             ; 0x5F -> 0x59
0002be c000                          rjmp VD_SAVE
                                 
                                 VD_SAVE:
0002bf 930c                          st   X, r16             ; Сохраняем результат
0002c0 de34                          rcall DISPLAY_EDIT ; Сразу обновляем экран для отклика
                                 
                                 VD_EXIT:
                                    
0002c1 9508                       ret
                                 
                                  GET_LIMIT:
0002c2 9130 0061                     lds  r19, edit_mode
0002c4 3031                          cpi  r19, 1             ; Секунды
0002c5 f069                          breq LIM_60
0002c6 3032                          cpi  r19, 2             ; Минуты
0002c7 f059                          breq LIM_60
0002c8 3033                          cpi  r19, 3             ; Часы
0002c9 f079                          breq LIM_24
0002ca 3034                          cpi  r19, 4             ; День недели
0002cb f049                          breq LIM_8	
0002cc 3035                          cpi  r19, 5             ; Дата (упрощенно до 31)
0002cd f069                          breq LIM_32
0002ce 3036                      	cpi  r19, 6             ; Месяц
0002cf f039                          breq LIM_13
0002d0 3037                      	cpi  r19, 7             ; Год (упрощенно до 99)
0002d1 f059                          breq LIM_99
0002d2 9508                          ret
                                 
                                 LIM_60:
0002d3 e610                      	ldi r17, 0x60
0002d4 9508                      	ret
                                 LIM_8:
0002d5 e018                      	ldi r17, 0x08
0002d6 9508                      	ret
                                 LIM_13:
0002d7 e113                      	ldi r17, 0x13
0002d8 9508                      	ret
                                 LIM_24:
0002d9 e214                      	ldi r17, 0x24
0002da 9508                      	ret
                                 LIM_32:
0002db e312                      	ldi r17, 0x32
0002dc 9508                      	ret
                                 LIM_99:
0002dd e919                      	ldi r17, 0x99
0002de 9508                      


