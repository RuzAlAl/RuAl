                                 .equ	PORTB0	= 0	; Port B Data Register bit 0
                                 .equ	PB0	= 0	; For compatibility
                                 .equ	PORTB1	= 1	; Port B Data Register bit 1
                                 .equ	PB1	= 1	; For compatibility
                                 .equ	PORTB2	= 2	; Port B Data Register bit 2
                                 .equ	PB2	= 2	; For compatibility
                                 .equ	PORTB3	= 3	; Port B Data Register bit 3
                                 .equ	PB3	= 3	; For compatibility
                                 .equ	PORTB4	= 4	; Port B Data Register bit 4
                                 .equ	PB4	= 4	; For compatibility
                                 .equ	PORTB5	= 5	; Port B Data Register bit 5
                                 .equ	PB5	= 5	; For compatibility
                                 .equ	PORTB6	= 6	; Port B Data Register bit 6
                                 .equ	PB6	= 6	; For compatibility
                                 .equ	PORTB7	= 7	; Port B Data Register bit 7
                                 .equ	PB7	= 7	; For compatibility
                                 
                                 ; DDRB - Port B Data Direction Register
                                 .equ	DDB0	= 0	; Port B Data Direction Register bit 0
                                 .equ	DDB1	= 1	; Port B Data Direction Register bit 1
                                 .equ	DDB2	= 2	; Port B Data Direction Register bit 2
                                 .equ	DDB3	= 3	; Port B Data Direction Register bit 3
                                 .equ	DDB4	= 4	; Port B Data Direction Register bit 4
                                 .equ	DDB5	= 5	; Port B Data Direction Register bit 5
                                 .equ	DDB6	= 6	; Port B Data Direction Register bit 6
                                 .equ	DDB7	= 7	; Port B Data Direction Register bit 7
                                 
                                 ; PINB - Port B Input Pins
                                 .equ	PINB0	= 0	; Port B Input Pins bit 0
                                 .equ	PINB1	= 1	; Port B Input Pins bit 1
                                 .equ	PINB2	= 2	; Port B Input Pins bit 2
                                 .equ	PINB3	= 3	; Port B Input Pins bit 3
                                 .equ	PINB4	= 4	; Port B Input Pins bit 4
                                 .equ	PINB5	= 5	; Port B Input Pins bit 5
                                 .equ	PINB6	= 6	; Port B Input Pins bit 6
                                 .equ	PINB7	= 7	; Port B Input Pins bit 7
                                 
                                 
                                 ; ***** PORTC ************************
                                 ; PORTC - Port C Data Register
                                 .equ	PORTC0	= 0	; Port C Data Register bit 0
                                 .equ	PC0	= 0	; For compatibility
                                 .equ	PORTC1	= 1	; Port C Data Register bit 1
                                 .equ	PC1	= 1	; For compatibility
                                 .equ	PORTC2	= 2	; Port C Data Register bit 2
                                 .equ	PC2	= 2	; For compatibility
                                 .equ	PORTC3	= 3	; Port C Data Register bit 3
                                 .equ	PC3	= 3	; For compatibility
                                 .equ	PORTC4	= 4	; Port C Data Register bit 4
                                 .equ	PC4	= 4	; For compatibility
                                 .equ	PORTC5	= 5	; Port C Data Register bit 5
                                 .equ	PC5	= 5	; For compatibility
                                 .equ	PORTC6	= 6	; Port C Data Register bit 6
                                 .equ	PC6	= 6	; For compatibility
                                 
                                 ; DDRC - Port C Data Direction Register
                                 .equ	DDC0	= 0	; Port C Data Direction Register bit 0
                                 .equ	DDC1	= 1	; Port C Data Direction Register bit 1
                                 .equ	DDC2	= 2	; Port C Data Direction Register bit 2
                                 .equ	DDC3	= 3	; Port C Data Direction Register bit 3
                                 .equ	DDC4	= 4	; Port C Data Direction Register bit 4
                                 .equ	DDC5	= 5	; Port C Data Direction Register bit 5
                                 .equ	DDC6	= 6	; Port C Data Direction Register bit 6
                                 
                                 ; PINC - Port C Input Pins
                                 .equ	PINC0	= 0	; Port C Input Pins bit 0
                                 .equ	PINC1	= 1	; Port C Input Pins bit 1
                                 .equ	PINC2	= 2	; Port C Input Pins bit 2
                                 .equ	PINC3	= 3	; Port C Input Pins bit 3
                                 .equ	PINC4	= 4	; Port C Input Pins bit 4
                                 .equ	PINC5	= 5	; Port C Input Pins bit 5
                                 .equ	PINC6	= 6	; Port C Input Pins bit 6
                                 
                                 
                                 ; ***** PORTD ************************
                                 ; PORTD - Port D Data Register
                                 .equ	PORTD0	= 0	; Port D Data Register bit 0
                                 .equ	PD0	= 0	; For compatibility
                                 .equ	PORTD1	= 1	; Port D Data Register bit 1
                                 .equ	PD1	= 1	; For compatibility
                                 .equ	PORTD2	= 2	; Port D Data Register bit 2
                                 .equ	PD2	= 2	; For compatibility
                                 .equ	PORTD3	= 3	; Port D Data Register bit 3
                                 .equ	PD3	= 3	; For compatibility
                                 .equ	PORTD4	= 4	; Port D Data Register bit 4
                                 .equ	PD4	= 4	; For compatibility
                                 .equ	PORTD5	= 5	; Port D Data Register bit 5
                                 .equ	PD5	= 5	; For compatibility
                                 .equ	PORTD6	= 6	; Port D Data Register bit 6
                                 .equ	PD6	= 6	; For compatibility
                                 .equ	PORTD7	= 7	; Port D Data Register bit 7
                                 .equ	PD7	= 7	; For compatibility
                                 
                                 ; DDRD - Port D Data Direction Register
                                 .equ	DDD0	= 0	; Port D Data Direction Register bit 0
                                 .equ	DDD1	= 1	; Port D Data Direction Register bit 1
                                 .equ	DDD2	= 2	; Port D Data Direction Register bit 2
                                 .equ	DDD3	= 3	; Port D Data Direction Register bit 3
                                 .equ	DDD4	= 4	; Port D Data Direction Register bit 4
                                 .equ	DDD5	= 5	; Port D Data Direction Register bit 5
                                 .equ	DDD6	= 6	; Port D Data Direction Register bit 6
                                 .equ	DDD7	= 7	; Port D Data Direction Register bit 7
                                 
                                 ; PIND - Port D Input Pins
                                 .equ	PIND0	= 0	; Port D Input Pins bit 0
                                 .equ	PIND1	= 1	; Port D Input Pins bit 1
                                 .equ	PIND2	= 2	; Port D Input Pins bit 2
                                 .equ	PIND3	= 3	; Port D Input Pins bit 3
                                 .equ	PIND4	= 4	; Port D Input Pins bit 4
                                 .equ	PIND5	= 5	; Port D Input Pins bit 5
                                 .equ	PIND6	= 6	; Port D Input Pins bit 6
                                 .equ	PIND7	= 7	; Port D Input Pins bit 7
                                 
                                 
                                 ; ***** EEPROM ***********************
                                 ; EEDR - EEPROM Data Register
                                 .equ	EEDR0	= 0	; EEPROM Data Register bit 0
                                 .equ	EEDR1	= 1	; EEPROM Data Register bit 1
                                 .equ	EEDR2	= 2	; EEPROM Data Register bit 2
                                 .equ	EEDR3	= 3	; EEPROM Data Register bit 3
                                 .equ	EEDR4	= 4	; EEPROM Data Register bit 4
                                 .equ	EEDR5	= 5	; EEPROM Data Register bit 5
                                 .equ	EEDR6	= 6	; EEPROM Data Register bit 6
                                 .equ	EEDR7	= 7	; EEPROM Data Register bit 7
                                 
                                 ; EECR - EEPROM Control Register
                                 .equ	EERE	= 0	; EEPROM Read Enable
                                 .equ	EEWE	= 1	; EEPROM Write Enable
                                 .equ	EEMWE	= 2	; EEPROM Master Write Enable
                                 .equ	EEWEE	= EEMWE	; For compatibility
                                 .equ	EERIE	= 3	; EEPROM Ready Interrupt Enable
                                 
                                 
                                 ; ***** CPU **************************
                                 ; SREG - Status Register
                                 .equ	SREG_C	= 0	; Carry Flag
                                 .equ	SREG_Z	= 1	; Zero Flag
                                 .equ	SREG_N	= 2	; Negative Flag
                                 .equ	SREG_V	= 3	; Two's Complement Overflow Flag
                                 .equ	SREG_S	= 4	; Sign Bit
                                 .equ	SREG_H	= 5	; Half Carry Flag
                                 .equ	SREG_T	= 6	; Bit Copy Storage
                                 .equ	SREG_I	= 7	; Global Interrupt Enable
                                 
                                 ; MCUCR - MCU Control Register
                                 ;.equ	ISC00	= 0	; Interrupt Sense Control 0 Bit 0
                                 ;.equ	ISC01	= 1	; Interrupt Sense Control 0 Bit 1
                                 ;.equ	ISC10	= 2	; Interrupt Sense Control 1 Bit 0
                                 ;.equ	ISC11	= 3	; Interrupt Sense Control 1 Bit 1
                                 .equ	SM0	= 4	; Sleep Mode Select
                                 .equ	SM1	= 5	; Sleep Mode Select
                                 .equ	SM2	= 6	; Sleep Mode Select
                                 .equ	SE	= 7	; Sleep Enable
                                 
                                 ; MCUCSR - MCU Control And Status Register
                                 .equ	MCUSR	= MCUCSR	; For compatibility
                                 .equ	PORF	= 0	; Power-on reset flag
                                 .equ	EXTRF	= 1	; External Reset Flag
                                 .equ	BORF	= 2	; Brown-out Reset Flag
                                 .equ	WDRF	= 3	; Watchdog Reset Flag
                                 
                                 ; OSCCAL - Oscillator Calibration Value
                                 .equ	CAL0	= 0	; Oscillator Calibration Value Bit0
                                 .equ	CAL1	= 1	; Oscillator Calibration Value Bit1
                                 .equ	CAL2	= 2	; Oscillator Calibration Value Bit2
                                 .equ	CAL3	= 3	; Oscillator Calibration Value Bit3
                                 .equ	CAL4	= 4	; Oscillator Calibration Value Bit4
                                 .equ	CAL5	= 5	; Oscillator Calibration Value Bit5
                                 .equ	CAL6	= 6	; Oscillator Calibration Value Bit6
                                 .equ	CAL7	= 7	; Oscillator Calibration Value Bit7
                                 
                                 ; SPMCR - Store Program Memory Control Register
                                 .equ	SPMEN	= 0	; Store Program Memory Enable
                                 .equ	PGERS	= 1	; Page Erase
                                 .equ	PGWRT	= 2	; Page Write
                                 .equ	BLBSET	= 3	; Boot Lock Bit Set
                                 .equ	RWWSRE	= 4	; Read-While-Write Section Read Enable
                                 .equ	RWWSB	= 6	; Read-While-Write Section Busy
                                 .equ	SPMIE	= 7	; SPM Interrupt Enable
                                 
                                 ; SFIOR - Special Function IO Register
                                 .equ	PSR10	= 0	; Prescaler Reset Timer/Counter1 and Timer/Counter0
                                 .equ	PUD	= 2	; Pull-up Disable
                                 .equ	ADHSM	= 4	; ADC High Speed Mode
                                 
                                 
                                 ; ***** AD_CONVERTER *****************
                                 ; ADMUX - The ADC multiplexer Selection Register
                                 .equ	MUX0	= 0	; Analog Channel and Gain Selection Bits
                                 .equ	MUX1	= 1	; Analog Channel and Gain Selection Bits
                                 .equ	MUX2	= 2	; Analog Channel and Gain Selection Bits
                                 .equ	MUX3	= 3	; Analog Channel and Gain Selection Bits
                                 .equ	ADLAR	= 5	; Left Adjust Result
                                 .equ	REFS0	= 6	; Reference Selection Bit 0
                                 .equ	REFS1	= 7	; Reference Selection Bit 1
                                 
                                 ; ADCSRA - The ADC Control and Status register
                                 .equ	ADCSR	= ADCSRA	; For compatibility
                                 .equ	ADPS0	= 0	; ADC  Prescaler Select Bits
                                 .equ	ADPS1	= 1	; ADC  Prescaler Select Bits
                                 .equ	ADPS2	= 2	; ADC  Prescaler Select Bits
                                 .equ	ADIE	= 3	; ADC Interrupt Enable
                                 .equ	ADIF	= 4	; ADC Interrupt Flag
                                 .equ	ADFR	= 5	; ADC  Free Running Select
                                 .equ	ADSC	= 6	; ADC Start Conversion
                                 .equ	ADEN	= 7	; ADC Enable
                                 
                                 
                                 
                                 ; ***** LOCKSBITS ********************************************************
                                 .equ	LB1	= 0	; Lock bit
                                 .equ	LB2	= 1	; Lock bit
                                 .equ	BLB01	= 2	; Boot Lock bit
                                 .equ	BLB02	= 3	; Boot Lock bit
                                 .equ	BLB11	= 4	; Boot lock bit
                                 .equ	BLB12	= 5	; Boot lock bit
                                 
                                 
                                 ; ***** FUSES ************************************************************
                                 ; LOW fuse bits
                                 .equ	CKSEL0	= 0	; Select Clock Source
                                 .equ	CKSEL1	= 1	; Select Clock Source
                                 .equ	CKSEL2	= 2	; Select Clock Source
                                 .equ	CKSEL3	= 3	; Select Clock Source
                                 .equ	SUT0	= 4	; Select start-up time
                                 .equ	SUT1	= 5	; Select start-up time
                                 .equ	BODEN	= 6	; Brown out detector enable
                                 .equ	BODLEVEL	= 7	; Brown out detector trigger level
                                 
                                 ; HIGH fuse bits
                                 .equ	BOOTRST	= 0	; Select Reset Vector
                                 .equ	BOOTSZ0	= 1	; Select Boot Size
                                 .equ	BOOTSZ1	= 2	; Select Boot Size
                                 .equ	EESAVE	= 3	; EEPROM memory is preserved through chip erase
                                 .equ	CKOPT	= 4	; Oscillator Options
                                 .equ	SPIEN	= 5	; Enable Serial programming and Data Downloading
                                 .equ	WTDON	= 6	; Enable watchdog
                                 .equ	RSTDISBL	= 7	; Disable reset
                                 
                                 
                                 
                                 ; ***** CPU REGISTER DEFINITIONS *****************************************
                                 .def	XH	= r27
                                 .def	XL	= r26
                                 .def	YH	= r29
                                 .def	YL	= r28
                                 .def	ZH	= r31
                                 .def	ZL	= r30
                                 
                                 
                                 
                                 ; ***** DATA MEMORY DECLARATIONS *****************************************
                                 .equ	FLASHEND	= 0x0fff	; Note: Word address
                                 .equ	IOEND	= 0x003f
                                 .equ	SRAM_START	= 0x0060
                                 .equ	SRAM_SIZE	= 1024
                                 .equ	RAMEND	= 0x045f
                                 .equ	XRAMEND	= 0x0000
                                 .equ	E2END	= 0x01ff
                                 .equ	EEPROMEND	= 0x01ff
                                 .equ	EEADRBITS	= 9
                                 #pragma AVRPART MEMORY PROG_FLASH 8192
                                 #pragma AVRPART MEMORY EEPROM 512
                                 #pragma AVRPART MEMORY INT_SRAM SIZE 1024
                                 #pragma AVRPART MEMORY INT_SRAM START_ADDR 0x60
                                 
                                 
                                 
                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0xc00
                                 .equ	NRWW_STOP_ADDR	= 0xfff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0xbff
                                 .equ	PAGESIZE	= 32
                                 .equ	FIRSTBOOTSTART	= 0xf80
                                 .equ	SECONDBOOTSTART	= 0xf00
                                 .equ	THIRDBOOTSTART	= 0xe00
                                 .equ	FOURTHBOOTSTART	= 0xc00
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0001	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0002	; External Interrupt Request 1
                                 .equ	OC2addr	= 0x0003	; Timer/Counter2 Compare Match
                                 .equ	OVF2addr	= 0x0004	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0005	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0006	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0007	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x0008	; Timer/Counter1 Overflow
                                 .equ	OVF0addr	= 0x0009	; Timer/Counter0 Overflow
                                 .equ	SPIaddr	= 0x000a	; Serial Transfer Complete
                                 .equ	URXCaddr	= 0x000b	; USART, Rx Complete
                                 .equ	UDREaddr	= 0x000c	; USART Data Register Empty
                                 .equ	UTXCaddr	= 0x000d	; USART, Tx Complete
                                 .equ	ADCCaddr	= 0x000e	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x000f	; EEPROM Ready
                                 .equ	ACIaddr	= 0x0010	; Analog Comparator
                                 .equ	TWIaddr	= 0x0011	; 2-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0012	; Store Program Memory Ready
                                 
                                 .equ	INT_VECTORS_SIZE	= 19	; size in words
                                 
                                 #pragma AVRPART CORE INSTRUCTIONS_NOT_SUPPORTED break
                                 
                                 #endif  /* _M8DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; Step_03.asm
                                 ;
                                 ; Created: 20.02.2026 13:30:00
                                 ; Author : ar_user
                                 ;
                                 
                                 .include "m8def.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega8.xml *************
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m8def.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega8
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega8
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M8DEF_INC_
                                 #endif  /* _M8DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 .list
                                 .include "define.inc"	; Наши все определения переменных тут
                                 
                                  * define.inc
                                  */ 
                                 
                                 .equ F_CPU = 1000000
                                 
                                 ; SPI для 74HC595
                                 .equ SPI_PORT    = PORTB
                                 .equ SPI_DDR     = DDRB		; направление 1 -выход, 0 -вход
                                 .equ SPI_PIN     = PINB		; информация только читается
                                 .equ SCK         = PB5     ; CLOCK
                                 .equ MISO        = PB4     ; не используется
                                 .equ DATA        = PB3     ; DATA (SER)
                                 .equ LATCH       = PB2     ; LATCH (CS)
                                 .equ OE          = PB1     ; ШИМ для яркости (Output Enable, активный низкий)
                                 
                                 .equ BEEPER_PIN  = PB0	   ; Выход для бипера
                                 
                                 ; Кнопки на PD7-PD4 с внешней подтяжкой
                                 .equ BTN_PORT    = PORTD
                                 .equ BTN_DDR     = DDRD
                                 .equ BTN_PIN     = PIND
                                 .equ BTN_MASK    = 0xF0		; PD7-PD4
                                 .equ BTN1        = 7		;PD7 Минус
                                 .equ BTN2        = 6		;PD6 Плюс
                                 .equ BTN3        = 5		;PD5 Вход в настройку (Edit)
                                 .equ BTN4        = 4		;PD4 Режимы дисплея/ Запись времени
                                 
                                 .equ BEEP_LEN   = 5     ; Длительность работы БИППЕРА (3 * 10мс = 30мс)
                                 .def rBeepTimer = r9     ; Счетчик длительности звука (в младших регистрах)
                                 
                                 .equ T_SHORT	= 5        ; 50 мс : Дребезг 5 проходов по 10 мс
                                 .equ Sec_TimeOut     = 50	   ; 50 сек : Время для перехода в режим отображения по умолчанию
                                 
                                 .def rDebounce	 = r8     ; Счетчик антидребезга
                                 .def rBtn_now    = r20    ; Текущее чтение PIND
                                 .def rBtn_Index  = r21	  ; Индекс нажатой кнопки
                                 
                                 ; Кнопки через диоды (на INT1)
                                 .equ BTN_INT   = PD3     ; INT1
                                 
                                 ; DS3231 (на INT0)
                                 .equ DS3231_INT   = PD2     ; INT0
                                 
                                 ; I2C для DS3231
                                 .equ SDA          = PC4
                                 .equ SCL          = PC5
                                 
                                 ; Флаги
                                 .def rFlags = r23		  ; R23 регистр флагов
                                 .equ rFlag_int0   = 0	  ; Бит 0: Событие INT0 (от DS3231)
                                 .equ rFlag_dot  = 1		 ; Бит 1: Фаза мигания точки
                                 .equ rFlag_short  = 2     ; Бит 2: Короткое нажатие
                                 .equ rFlag_TimeOut = 3	  ; Бит 3: TimeOut режимов 
                                 .equ rFlag_beep   = 4     ; Бит 4: Активность бипера (1 - звучит)
                                 .equ rFlag_Reg10h   = 5     ; Бит 5: Выполнено чтение регистра 10H DS3231
                                 
                                 
                                 
                                 ; Сегменты цифр 0b dp,g,f,e,d,c,b,a
                                 			
                                 .equ SEG_0 = 0b00111111
                                 .equ SEG_1 = 0b00000110
                                 .equ SEG_2 = 0b01011011
                                 .equ SEG_3 = 0b01001111
                                 .equ SEG_4 = 0b01100110
                                 .equ SEG_5 = 0b01101101
                                 .equ SEG_6 = 0b01111101
                                 .equ SEG_7 = 0b00000111
                                 .equ SEG_8 = 0b01111111
                                 .equ SEG_9 = 0b01101111
                                 .equ SEG_C = 0b00111001
                                 .equ SEG_E = 0b01111001
                                 .equ SEG_ho = 0b01100011
                                 .equ SEG_lo = 0b01011100
                                 .equ SEG_OFF  = 0b00000000
                                 
                                 
                                 ; =========== Сегмент данных ===========
                                 .dseg
                                 .org SRAM_START
                                 
                                 ; Режимы дисплея
000060                           display_mode: .byte 1
                                 .equ MODE_HM     = 0      ; Часы-минуты
                                 .equ MODE_MS     = 1      ; Минуты-секунды
                                 .equ MODE_DM     = 2      ; Число-месяц
                                 .equ MODE_DAY    = 3      ; День недели
                                 .equ MODE_YEAR   = 4      ; Год (2 последние цифры)
                                 
                                 
000061                           edit_mode:    .byte 1
                                 .equ edit_off		= 0      ; редактирование отключено
                                 .equ edit_sec		= 1      ; секунды
                                 .equ edit_min		= 2      ; минуты
                                 .equ edit_hours     = 3      ; часы
                                 .equ edit_weekday   = 4      ; день недели
                                 .equ edit_day		= 5      ; день месяца
                                 .equ edit_mouth		= 6      ; месяц
                                 .equ edit_year		= 7      ; год
                                 .equ edit_crystal	= 8      ; смещение старения кварцевого резонатора
                                 
                                 
                                 ; Буферы
000062                           display_buf:  .byte 4
                                 .equ display_1		= display_buf       ; байт первого индикатора
                                 .equ display_2		= display_buf+1     ; байт второго индикатора
                                 .equ display_3		= display_buf+2     ; байт третьего индикатора
                                 .equ display_4		= display_buf+3     ; байт четвертого индикатора
                                 
000066                           i2c_buffer:   .byte 7      ; Буфер для I2C (секунды, минуты, часы, день, дата, месяц, год)
                                 .equ i2c_sec		= i2c_buffer     ; байт секунд в формате BCD 
                                 .equ i2c_min		= i2c_buffer+1   ; байт минут в формате BCD
                                 .equ i2c_hours		= i2c_buffer+2   ; байт часов в формате BCD 
                                 .equ i2c_weekday	= i2c_buffer+3   ; байт дня недели в формате BCD 
                                 .equ i2c_day		= i2c_buffer+4   ; байт дня месяца в формате BCD 
                                 .equ i2c_month		= i2c_buffer+5   ; байт месяца в формате BCD 
                                 .equ i2c_year		= i2c_buffer+6   ; байт года в формате BCD 
                                 
00006d                           i2c_crystal: .byte 1    ; байт с регистра смещения старения кварцевого резонатора
                                 
00006e                           rBtn_Save:   .byte 1    ; состояние нажатой кнопки
00006f                           timeout_cnt:  .byte 1    ; счетчик сброса режимов
                                 
                                 .cseg
                                 ; =========== Векторы прерывания ===========
                                 .include "vectors.inc"
                                 
                                 			;.CSEG
                                 			.ORG 	0x0000			; Проц стартует с нуля, но дальше идут вектора 
000000 c02d                      			RJMP 	Reset			; прерываний, поэтому отсюда сразу же прыгаем на начало программы. На метку Reset
                                 			.ORG	INT0addr		; External Interrupt Request 0 = 0x0001
000001 c281                      			RJMP 	INT0_ISR		; Вектор INT0 (DS3231)
                                 			.ORG	INT1addr		; External Interrupt Request 1 = 0x0002
000002 c286                      			RJMP 	INT1_ISR		; Вектор INT1
                                 			.ORG	OC2addr			; Timer/Counter2 Compare Match = 0x0003
000003 9518                      			RETI	
                                 			.ORG	OVF2addr		; Timer/Counter2 Overflow	= 0x0004
000004 9518                      			RETI
                                 			.ORG	ICP1addr		; Timer/Counter1 Capture Event = 0x0005
000005 9518                      			RETI
                                 			.ORG	OC1Aaddr		; Timer/Counter1 Compare Match A = 0x0006
000006 9518                      			RETI
                                 			.ORG	OC1Baddr		; Timer/Counter1 Compare Match B = 0x0007
000007 9518                      			RETI
                                 			.ORG	OVF1addr		; Timer/Counter1 Overflow = 0x0008
000008 9518                      			RETI
                                 			.ORG	OVF0addr		; Timer/Counter0 Overflow = 0x0009
000009 c28f                      			RJMP	TIMER0_ISR		; Jump to Timer0 overflow ISR
                                 			.ORG	SPIaddr			; Serial Transfer Complete = 0x000a
00000a 9518                      			RETI
                                 			.ORG	URXCaddr		; USART, Rx Complete = 0x000b
00000b 9518                      			RETI	
                                 			.ORG	UDREaddr		; USART Data Register Empty = 0x000c
00000c 9518                      			RETI
                                 			.ORG	UTXCaddr		; USART, Tx Complete = 0x000d
00000d 9518                      			RETI
                                 			.ORG	ADCCaddr		; ADC Conversion Complete = 0x000e
00000e 9518                      			RETI
                                 			.ORG	ERDYaddr		; EEPROM Ready = 0x000f
00000f 9518                      			RETI
                                 			.ORG	ACIaddr			; Analog Comparator = 0x0010
000010 9518                      			RETI
                                 			.ORG	TWIaddr			; 2-wire Serial Interface = 0x0011
000011 9518                      			RETI
                                 			.ORG	SPMRaddr		; Store Program Memory Ready = 0x0012
000012 9518                      			RETI
                                 
                                 .org 0x0020
                                 
                                 ; =========== Таблицы ===========
                                 SEG_TABLE:
000020 063f
000021 4f5b
000022 6d66
000023 077d
000024 6f7f                          .db SEG_0, SEG_1, SEG_2, SEG_3, SEG_4, SEG_5, SEG_6, SEG_7, SEG_8, SEG_9
                                 
                                 TABLDISP:
000025 c06f                      	rjmp SHOW_HM      ; Индекс 0
000026 c073                      	rjmp SHOW_MS      ; Индекс 1
000027 c078                      	rjmp SHOW_DM      ; Индекс 2
000028 c076                      	rjmp SHOW_DAY     ; Индекс 3
000029 c07b                      	rjmp SHOW_YEAR    ; Индекс 4
                                 
                                 TABLSHORT:
00002a c2cd                      	rjmp MINUS		    ; Индекс 0
00002b c2c0                      	rjmp PLUS	        ; Индекс 1
00002c c2b4                      	rjmp CHANGE_ED      ; Индекс 2
00002d c2a4                      	rjmp CHANGE_MO      ; Индекс 3
                                 
                                 Reset:
                                     ; Инициализация стека
00002e e004                          ldi r16, high(RAMEND)
00002f bf0e                          out SPH, r16
000030 e50f                          ldi r16, low(RAMEND)
000031 bf0d                          out SPL, r16
                                 
                                 	; Инициализация портов
000032 d01e                          rcall INIT_PORTS
                                 
                                 	; Инициализация переменных
000033 d00b                      	rcall INIT_VARIABLES
                                 
                                 	; Инициализация прерываний
000034 d031                      	rcall INIT_INTERRUPTS
                                 
                                 	; Инициализация DS3231
000035 d14c                      	rcall INIT_DS3231
                                 
                                 	; Инициализация SPI
000036 d235                      	rcall INIT_SPI
                                 	 
                                 	; Инициализация ШИМ
000037 d024                      	rcall INIT_PWM
                                 
                                 	; rcall WRITE_REGISTER_10H
                                 
                                 	; Разрешение прерываний
000038 9478                      	sei
                                 
                                 
                                 
                                 MAIN_LOOP:
                                 	; 1. Событие INT0 (RTC секунда прошла)
000039 fd70                          sbrc rFlags, rFlag_int0 ; Пропустить следующую команду если бит в регистре очищен
00003a d039                      	rcall SELECT_DISP
                                 
                                 	; 2. Кнопки
00003b fd72                      	sbrc rFlags, rFlag_short ; Пропустить следующую команду если бит в регистре очищен
00003c d280                      	rcall Press_Short
                                 	
                                 SLEEP_ALL:	
                                 	; Режим сна
00003d 9588                      	 sleep                 ; Перевести МК в режим энергосбережения
                                 
00003e cffa                      	rjmp MAIN_LOOP
                                 
                                 .include "initialization.asm"
                                 
                                  * initialization.asm
                                  *
                                  *  Created: 02.02.2026 16:11:17
                                  *   Author: ar_user
                                  */ 
                                  ; =========== Инициализация переменных ===========
                                 INIT_VARIABLES:
00003f 2411                      	clr r1 ; R1: Всегда 0x00 (ускоряет очистку регистров и портов)
000040 2455                          clr r5	; Используем в прерывании INT0 для сохранения SREG
000041 2466                      	clr r6	; Используем в прерывании INT1 для сохранения SREG
000042 2477                      	clr r7	; Используем в прерывании TIMER0 OVF для сохранения SREG
000043 2488                      	clr r8	; Счетчик антидребезга
000044 2499                      	clr r9  ; Счетчик длительности звука (в младших регистрах)
000045 2755                      	clr r21	; Индекс нажатой кнопки
                                 	
                                 	; Флаги
000046 2777                           clr rflags ; регистр r23
                                 	     
                                     ; Режимы
000047 e000                      	ldi r16,0
000048 9300 0061                 	sts edit_mode, r16
                                 
00004a e000                      	ldi r16,0
00004b 9300 0060                 	sts display_mode, r16
                                 	
                                 
                                 	;ldi r16,0x9A ; на индикаторе - 102
                                 	;ldi r16,0x74
00004d 2700                      	clr r16
00004e 9300 006d                 	sts i2c_crystal, r16
                                 
000050 9508                      	ret
                                 
                                 ; =========== Инициализация портов ===========
                                 INIT_PORTS:
                                     
                                 	; SPI порты (MOSI, SCK, SS, OE, MR как выходы) и BEEPER_PIN
000051 ea0f                          ldi r16, (1<<DATA)|(1<<SCK)|(1<<LATCH)|(1<<OE)|(1<<BEEPER_PIN)|(1<<PB7)
000052 bb07                          out SPI_DDR, r16
                                     
                                    /* ; OE (яркость) - низкий уровень по умолчанию (максимальная яркость)
                                     cbi SPI_PORT, OE*/
                                 
                                 	; OE (ШИМ) - низкий уровень по умолчанию (максимальная яркость)    
                                 	    
                                     ; Порт для DS3231 (INT0)
000053 988a                          cbi DDRD, DS3231_INT      ; Вход
000054 9a92                          sbi PORTD, DS3231_INT     ; Подтяжка
                                     
                                     ; Порты для I2C
000055 98a4                          cbi DDRC, SDA             ; SDA - вход
000056 98a5                          cbi DDRC, SCL             ; SCL - вход
000057 9aac                          sbi PORTC, SDA            ; Подтяжка
000058 9aad                          sbi PORTC, SCL            ; Подтяжка
                                 
                                 	; Порты подключенных кнопок как входы и PD3 для INT1, без подтяжки (внешние резисторы на 5в)
000059 e000                          ldi r16, (0<<BTN1)|(0<<BTN2)|(0<<BTN3)|(0<<BTN4)|(0<<BTN_INT); BTN1 это PD7, BTN2 это PD6, BTN3 это PD5, BTN4 это PD4, BTN_INT это PD3
00005a bb01                          out BTN_DDR, r16
                                     
00005b 9508                          ret
                                 
                                 ; =========== Инициализация ШИМ ===========
                                 INIT_PWM:
                                 	; Настройка TCCR1A:
                                     ; COM1A1=1, COM1A0=0 -> Clear OC1A on Compare Match (неинвертированный ШИМ)
                                     ; WGM10=1, WGM11=0 -> Режим Fast PWM, 8-bit
00005c e801                          ldi r16, (1 << COM1A1) | (1 << WGM10)
00005d bd0f                          out TCCR1A, r16
                                 
                                     ; Настройка TCCR1B:
                                     ; WGM12=1 -> Дополнение для Fast PWM, 8-bit
                                     ; CS10=1  -> Предделитель = 1, частота 1МГц/256 = 3906 Гц (запуск таймера)
00005e e009                          ldi r16, (1 << WGM12) | (1 << CS10)
00005f bd0e                          out TCCR1B, r16
                                 
                                 
                                 	; Установка начальной яркости (0 - макс, 255 - мин, т.к. OE инверсный)
                                 	;Для записи 16-битного значения старший байт должен быть записан перед младшим.
                                 	;Для чтения 16-битного значения младший байт должен быть прочитан перед старшим.
                                     ;ldi r16, 128 ; 50% яркости
000060 2700                      	clr r16
000061 bd0b                          out OCR1AH, r16 ; Старший байт в 8-битном режиме всегда 0
000062 ec08                      	ldi r16, 200
000063 bd0a                          out OCR1AL, r16
                                     
000064 9508                          ret
000065 9508                      ret
                                 
                                 ; =========== Инициализация прерываний ===========
                                 INIT_INTERRUPTS:
                                 	/*ISC01 ISC00 Описание
                                 	0 		0 Низкий уровень INT0 генерирует запрос прерывания.
                                 	0 		1 Любое логическое изменение на INT0 генерирует запрос прерывания.
                                 	1 		0 Спадающий фронт INT0 генерирует запрос прерывания.
                                 	1 		1 Восходящий фронт INT0 генерирует запрос прерывания.*/
                                     ; INT0 - От DS3231 восходящий фронт генерирует запрос прерывания
000066 e002                          ldi r16, (1<<ISC01)|(0<<ISC00)
000067 bf05                          out MCUCR, r16
000068 e400                          ldi r16, (1<<INT0)
000069 bf0b                          out GICR, r16
                                 
                                 	; INT1 - прерывание от кнопок по нажатию 
                                     ; (нажатие = 1->0 на INT1, отпускание = 0->1)
00006a b705                         in r16, MCUCR
                                     ;ldi r16, (1<<ISC11)|(0<<ISC10)  ; нажатие = 1->0 по спаду (Falling Edge)
00006b 6008                      	ori r16, (1<<ISC11)|(0<<ISC10)  ; нажатие = 1->0 по спаду (Falling Edge) добавляем два бита
00006c bf05                          out MCUCR, r16
                                 	; ВКЛЮЧИТЬ INT1 (установить бит INT1, сохранив INT0)
00006d b70b                      	in  r16, GICR        ; Читаем текущее состояние
00006e 6800                      	ori r16, (1<<INT1)   ; Устанавливаем только бит INT1 (Разрешение INT1)
00006f bf0b                      	out GICR, r16        ; Записываем обратно, включаем INT1
                                 
                                 	; Разрешаем прерывание по переполнению Таймера 0
000070 b709                          in r16, TIMSK
000071 6001                          ori r16, (1 << TOIE0)
000072 bf09                          out TIMSK, r16
                                     
000073 9508                      
                                 SELECT_DISP:
000074 fd73                      	sbrc rFlags, rFlag_TimeOut ; Пропустить следующую команду если бит в регистре очищен
000075 d009                      	rcall TimeOut
000076 7f7e                      	cbr rFlags, (1<<rFlag_int0) ; сброс флага
                                 	;rcall TEST_A
                                 	;проверка на режим редактирования
000077 9120 0061                 	lds r18, edit_mode
000079 2322                          tst r18
00007a f011                          breq DiWo       ; Переход если равно т.е.если 0 — работаем как обычно
00007b d088                      	rcall DISPLAY_EDIT	;переход в показ режима редактирования
                                 	;rcall TEST_C
00007c c001                      	rjmp OUT_SeDi
                                 DiWo:
00007d d02b                      	rcall DISPLAY_WORK ;переход в показ времени
                                 OUT_SeDi:
00007e 9508                      	ret
                                 
                                 TimeOut:
00007f 930f                      	push r16
000080 932f                      	push r18
                                 	; --- Логика таймаута ---
000081 9120 006f                     lds r18, timeout_cnt
000083 952a                          dec r18             ; Уменьшаем каждую секунду
000084 9320 006f                     sts timeout_cnt, r18
000086 f431                          brne Out_TO  ; Если еще не ноль, продолжаем (Проверяется флаг нулевого значения (Z) регистра статуса, сдесь реагирует на dec r19)
                                 
000087 2700                          clr r16             ; Если ноль — сброс режима
000088 7f77                      	cbr rFlags, (1<<rFlag_TimeOut) ; сброс флага
000089 9300 0061                     sts edit_mode, r16	
00008b 9300 0060                 	sts display_mode, r16
                                 
                                 Out_TO:
00008d 912f                      	pop r18
00008e 910f                      	pop r16
00008f 9508                       ret
                                 
                                  TEST_A:
000090 b308                      	in  r16, PORTB
000091 e810                      	ldi r17,(1<<PB7)
000092 2701                      	eor r16, r17  ; Исключающее ИЛИ: если был 0 — станет 1, если 1 — станет 0
000093 bb08                      	out PORTB,r16
                                 out_te:
000094 9508                      	ret	
                                 
                                 
                                 .include "displaywork.asm"
                                 
                                  * displayrtc.asm
                                  *
                                  *  Created: 02.02.2026 16:20:48
                                  *   Author: ar_user
                                  */ 
                                  ; --- Обработчики табличных переходов ---
                                 SHOW_HM:
000095 9100 0068                     lds  r16, i2c_hours
000097 9110 0067                     lds  r17, i2c_min
000099 c023                          rjmp Buffer_disp
                                 
                                 SHOW_MS:
00009a 9100 0067                     lds  r16, i2c_min
00009c 9110 0066                     lds  r17, i2c_sec
00009e c01e                          rjmp Buffer_disp
                                 
                                 SHOW_DAY:
                                 	;ldi  r16, 0x00
                                     ;lds  r17, i2c_weekday
00009f c01d                          rjmp Buffer_disp
                                 
                                 SHOW_DM:
0000a0 9100 006a                 	lds  r16, i2c_day
0000a2 9110 006b                     lds  r17, i2c_month
0000a4 c018                          rjmp Buffer_disp
                                 
                                 SHOW_YEAR:
0000a5 e200                      	ldi  r16, 0x20
0000a6 9110 006c                     lds  r17, i2c_year
0000a8 c014                          rjmp Buffer_disp
                                 
                                 
                                 DISPLAY_WORK:
0000a9 930f                      	push r16
0000aa 931f                      	push r17
0000ab 932f                      	push r18
0000ac 93ef                      	push r30
0000ad 93ff                      	push r31
                                 
                                 NORMAL_VIEW:
0000ae d0de                      	rcall RTC_ADAPTIVE
0000af 9100 0060                 	lds r16, display_mode
0000b1 3005                      	cpi R16, 5          ; Проверяем, что индекс меньше 5
0000b2 f430                          brsh Error1     ; Если R16 >= 5, уходим на обработку ошибки
                                 
                                     ; Используем табличный переход
                                 	; Загружаем базовый адрес таблицы
0000b3 e2e5                          ldi  ZL, low(TABLDISP) 
0000b4 e0f0                          ldi  ZH, high(TABLDISP)
                                     ; Прибавляем индекс к адресу (Z = Z + r16)
0000b5 0fe0                          add  ZL, r16
0000b6 2711                          clr  r17
0000b7 1ff1                          adc  ZH, r17              ; Учитываем перенос
                                 
0000b8 9409                          ijmp                      ; ПРЫЖОК в обработчики табличных переходов по адресу в Z 
                                 
                                 Error1:
0000b9 2700                      	clr r16					; обнуляем "мусор" переводим на режим по дефолту
0000ba 9300 0060                 	sts display_mode, r16
0000bc cff1                      	rjmp NORMAL_VIEW
                                 	
                                 		
                                 Buffer_disp:
                                 		
                                 	; Переход для формирования дня недели
0000bd 9120 0060                     lds r18, display_mode
0000bf 3023                      	cpi r18, MODE_DAY
0000c0 f109                      	BREQ MD3
                                 	
                                 			    
                                     ; Формируем 4 цифры:
                                     ; Индикатор 1 (левый): десятки часов
0000c1 2f20                      	mov r18, r16
0000c2 9522                          swap r18
0000c3 702f                          andi r18, 0x0F        ; Десятки часов (0-2)
0000c4 d1b1                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
0000c5 9320 0062                 	sts display_1, r18     ;  Сохраняем в буфер для левого (первого) индикатора
                                 	    
                                     ; Индикатор 2: единицы часов + точка
0000c7 2f20                          mov r18, r16
0000c8 702f                          andi r18, 0x0F        ; Единицы часов (0-9)
0000c9 d1ac                          rcall DIGIT_TO_SEGMENT ; преобразуем цифру в код сегментов
                                 
                                     ; Добавляем мигающую точку (между часами и минутами) работает только в режиме НМ
0000ca 9100 0060                 	lds r16, display_mode
0000cc 3000                      	cpi R16, MODE_HM
0000cd f431                      	brne OUT_DI2 ; Перейти если не равно
                                 	;SBRS rFlags, rFlag_dot ; проверяет состояние одного бита в регистре и пропускает следующую команду если этот бит установлен
0000ce fd71                      	SBRC rFlags, rFlag_dot ; проверяет состояние одного бита в регистре и пропускает следующую команду если этот бит очищен
0000cf c003                      	rjmp OUT_DI1
0000d0 6820                      	ori r18, (1<<7) ; устанавливаем 7 бит (это точка на 2-ом индикаторе) без изменения остальных
0000d1 6072                      	sbr rFlags, (1<<rFlag_dot)
0000d2 c001                      	rjmp OUT_DI2
                                 OUT_DI1:
0000d3 7f7d                      	cbr rFlags, (1<<rFlag_dot)
                                 OUT_DI2:
0000d4 9320 0063                 	sts display_2, r18     ; Сохраняем в буфер для второго индикатора
                                 
                                 
                                     ; Индикатор 3: Десятки минут
0000d6 2f21                          mov r18, r17
0000d7 9522                          swap r18
0000d8 702f                          andi r18, 0x0F        ; Десятки минут (0-5)
0000d9 d19c                          rcall DIGIT_TO_SEGMENT
0000da 9320 0064                     sts display_3, r18     ; третий индикатор
                                     
                                     ; 4. Единицы минут
0000dc 2f21                          mov r18, r17
0000dd 702f                          andi r18, 0x0F        ; Единицы минут (0-9)
0000de d197                          rcall DIGIT_TO_SEGMENT
0000df 9320 0065                     sts display_4, r18     ; четвертый индикатор
                                 	
0000e1 c00e                      	rjmp UPDATE_DISPLAY
                                 
                                 MD3:; формирование дня недели
0000e2 e400                      	ldi r16, 0b01000000
0000e3 9300 0062                 	sts display_1, r16
0000e5 9300 0063                 	sts display_2, r16
0000e7 9300 0065                 	sts display_4, r16	 ; четвертый индикатор
0000e9 9110 0069                 	lds  r17, i2c_weekday
0000eb 2f21                      	mov r18, r17
0000ec 702f                          andi r18, 0x0F        ; дни (1-7)
0000ed d188                          rcall DIGIT_TO_SEGMENT
0000ee 9320 0064                     sts display_3, r18   ; третий индикатор  
                                 	
                                 	
                                 UPDATE_DISPLAY:	 
                                 	    
                                     ; ВАЖНО: передаем данные в обратном порядке!
                                     ; Первым выводим правый разряд (последний в цепочке 74HC595)
                                     
0000f0 9100 0065                 	lds r16,display_4
0000f2 d17e                      	rcall spi_send
0000f3 9100 0064                 	lds r16,display_3
0000f5 d17b                      	rcall spi_send
0000f6 9100 0063                 	lds r16,display_2
0000f8 d178                      	rcall spi_send
0000f9 9100 0062                 	lds r16,display_1
0000fb d175                      	rcall spi_send
                                 
                                 	    
                                     ; Защелкиваем данные (импульс на SS/CS)
0000fc 9ac2                      	sbi SPI_PORT, LATCH
                                 	;nop
0000fd 98c2                      	cbi SPI_PORT, LATCH 
                                 
                                 	;rcall TEST_A
                                 
0000fe 91ff                      	pop r31
0000ff 91ef                      	pop r30
000100 912f                      	pop r18
000101 911f                      	pop r17
000102 910f                      	pop r16
                                 
000103 9508                          ret
                                 	
                                 
                                 
                                 .include "displayedit.asm"
                                 
                                  * displayedit.asm
                                  *
                                  *  Created: 04.02.2026 13:29:19
                                  *   Author: ar_user
                                  */ 
                                 
                                 
                                  DISPLAY_EDIT:
000104 930f                      	push r16
000105 931f                      	push r17
000106 932f                      	push r18
000107 93ef                      	push r30
000108 93ff                      	push r31
                                 
000109 9100 0061                 	lds r16, edit_mode
                                 	;cpi R16, 8          ; Проверяем, что индекс меньше 8
00010b 3009                      	cpi R16, 9          ; Проверяем, что индекс меньше 9
00010c f438                          brsh Error2     ; Если R16 >= 8, уходим на обработку ошибки
00010d 3008                      	cpi R16, 8		; Проверяем, что индекс равен 8
00010e f139                      	breq Cryst		;Перейти если равно
00010f 2f20                      	mov r18,r16
000110 d165                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
000111 9320 0062                 	sts display_1, r18     ;  Сохраняем в буфер для левого (первого) индикатора
000113 c004                      	rjmp DE1
                                 Error2:
000114 2722                      	clr r18					; обнуляем "мусор" переводим на режим по дефолту
000115 9320 0061                 	sts edit_mode, r18
000117 c02e                      	rjmp OUT_UD2
                                 DE1:
000118 d013                      	rcall Disp_2 ; анимация 2-ого идикатора
                                 	
                                 
                                 	;Находим нужный байт времени
000119 e6a6                      	ldi  XL, low(i2c_buffer)
00011a e0b0                          ldi  XH, high(i2c_buffer)
00011b 950a                          dec  r16                ;делаю декримент для правильной работы мне надо чтобы индекс edit_mode начинался с нуля Делаем из 1..7 -> 0..6
00011c 0fa0                          add  XL, r16
00011d 2700                          clr  r16
00011e 1fb0                          adc  XH, r16
                                 
00011f 911c                          ld   r17, X             ; Загружаем в r17 значение нужного байта по адресу Х
                                 
000120 2f21                      	mov r18, r17
000121 9522                          swap r18
000122 702f                          andi r18, 0x0F        ; Десятки
000123 d152                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
000124 9320 0064                 	sts display_3, r18     ;  Сохраняем в буфер для третьего индикатора
                                 	    
                                     ; Индикатор 4: единицы
000126 2f21                          mov r18, r17
000127 702f                          andi r18, 0x0F        ; Единицы
000128 d14d                          rcall DIGIT_TO_SEGMENT ; преобразуем цифру в код сегментов
000129 9320 0065                 	sts display_4, r18
                                 
00012b c00b                      	rjmp UPDATE_DISPLAY_2
                                 
                                 
                                 ; анимация 2-ого идикатора
                                 disp_2:
                                 
00012c fd71                      	sbrc rflags, rflag_dot ; проверяет состояние одного бита в регистре и пропускает следующую команду если этот бит очищен
00012d c003                      	rjmp holo
00012e e52c                      	ldi  r18,seg_lo
00012f 6072                      	sbr rFlags, (1<<rFlag_dot)
000130 c002                      	rjmp loho
                                 holo:
000131 e623                      	ldi  r18,seg_ho
000132 7f7d                      	cbr rFlags, (1<<rFlag_dot)
                                 loho:	
000133 9320 0063                 	sts display_2, r18
                                 	/*ldi r18,0b01001001
                                 	sts display_2, r18*/
000135 9508                      	ret
                                 
                                 Cryst:
000136 d015                      	rcall Crystall
                                 	
                                 
                                 
                                 	/*rjmp UPDATE_DISPLAY_2
                                 ret*/
                                 
                                 UPDATE_DISPLAY_2:	 
                                 	    
000137 9100 0065                 	lds r16,display_4
000139 d137                      	rcall spi_send
00013a 9100 0064                 	lds r16,display_3
00013c d134                      	rcall spi_send
00013d 9100 0063                 	lds r16,display_2
00013f d131                      	rcall spi_send
000140 9100 0062                 	lds r16,display_1
000142 d12e                      	rcall spi_send
                                 
                                 	    
                                     ; Защелкиваем данные (импульс на SS/CS)
000143 9ac2                      	sbi SPI_PORT, LATCH
000144 0000                      	nop
000145 98c2                      	cbi SPI_PORT, LATCH 
                                 OUT_UD2:
000146 91ff                      	pop r31
000147 91ef                      	pop r30
000148 912f                      	pop r18
000149 911f                      	pop r17
00014a 910f                      	pop r16
00014b 9508                      ret
                                 
                                 Crystall:
00014c 930f                      	push r16
00014d 931f                      	push r17
00014e 932f                      	push r18
00014f 933f                      	push r19
000150 934f                      	push r20
000151 ff75                      	sbrs rFlags, rFlag_Reg10h ; Пропустить следующую команду если бит в регистре в 1
000152 d083                      	rcall READ_REGISTER_10H
000153 9100 006d                 	lds r16, i2c_crystal
                                 	; Преобразование знакового байта в модуль и разряды
                                 	; Вход: r16 = исходное значение
                                 	; Выход: r17 = 0 если положительное, 1 если отрицательное
                                 	; r18 = сотни (0-1), r19 = десятки (0-9), r20 = единицы (0-9)
000155 2711                      	clr   r17               ; предполагаем положительное
                                 	; Проверяем знак
000156 ff07                          sbrs  r16, 7            ; пропустить, если бит 7 сброшен (положительное)
000157 c003                          rjmp  conv_pos
                                     ; Отрицательное: преобразуем в положительное (инвертировать +1)
000158 9500                          com   r16                ; инвертируем все биты
000159 9503                          inc   r16                ; +1
00015a e011                          ldi   r17, 1             ; признак отрицательного
                                 conv_pos:
                                 	; Теперь в r16 модуль числа (0..127)
                                     ; Разбиваем на сотни, десятки, единицы
                                     ; Для 0..127: сотни = 0 или 1
00015b e020                          ldi   r18, 0
00015c e030                          ldi   r19, 0
00015d e040                          ldi   r20, 0
                                 
                                 	; Вычитаем сотни (100)
00015e 3604                          cpi   r16, 100
00015f f010                          brlo  conv_no100
000160 5604                          subi  r16, 100
000161 e021                          ldi   r18, 1	;сотни
                                 conv_no100:
                                 	; Теперь десятки (0..9)
000162 e050                          ldi   r21, 0            ; счётчик десятков
                                 conv_dec_loop:
000163 300a                          cpi   r16, 10
000164 f018                          brlo  conv_dec_done
000165 500a                          subi  r16, 10
000166 9553                          inc   r21
000167 cffb                          rjmp  conv_dec_loop
                                 conv_dec_done:
000168 2f35                      	mov   r19, r21		;десятки
000169 2f40                          mov   r20, r16          ; остаток = единицы
                                 
00016a d10b                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
                                 	;ori r18, (1<<7) ; устанавливаем 7 бит (это точка) без изменения остальных
00016b 9320 0063                 	sts display_2, r18
00016d 2f23                      	mov r18,r19
00016e d107                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
                                 	;ori r18, (1<<7) ; устанавливаем 7 бит (это точка) без изменения остальных
00016f 9320 0064                 	sts display_3, r18
000171 2f24                      	mov r18,r20
000172 d103                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
                                 	;ori r18, (1<<7) ; устанавливаем 7 бит (это точка) без изменения остальных
000173 9320 0065                 	sts display_4, r18
                                 
000175 3011                      	cpi   r17, 1
000176 f011                      	breq negativ		;переход если равно, подставляем знак минус
000177 e010                      	ldi r17, SEG_OFF
000178 c001                      	rjmp DISP_1
                                 NEGATIV:
000179 e410                      	ldi r17, 0b01000000 ; Знак минус
                                 DISP_1:
00017a 9310 0062                 	sts display_1, r17
                                 
00017c 914f                      	pop r20
00017d 913f                      	pop r19
00017e 912f                      	pop r18
00017f 911f                      	pop r17
000180 910f                      	pop r16
                                 .include "i2c.asm"	
000181 9508                      
                                  * i2c.asm
                                 */ 
                                 ; =========== Инициализация DS3231 ===========
                                 INIT_DS3231:
000182 d0d1                          rcall I2C_INIT
                                     
000183 d0d5                          rcall I2C_START
000184 ed00                          ldi r16, 0xD0		;адрес DS3231
000185 d0d9                          rcall I2C_WRITE
                                     
000186 e00e                          ldi r16, 0x0E		; адресс Control Register (0Eh) DS3231 
000187 d0d7                          rcall I2C_WRITE
                                     
000188 e000                          ldi r16, 0x00		; запись в Control Register (0Eh) DS3231 Установка SQW на 1 Гц
000189 d0d5                          rcall I2C_WRITE
                                     
00018a d0de                          rcall I2C_STOP
                                 
00018b d022                      	rcall READ_DATETIME_FULL
                                 	;rcall READ_DATETIME
                                 
00018c 9508                          ret
                                 
                                 ; Подстраиваем глубину опроса времени.
                                 ; В режимах показа часов-минут, минут-секунд читаем только первые 3 байта (Сек, Мин, Час)
                                 ; В режимах день недели, день-месяц, год читаем 7 байт
                                 RTC_ADAPTIVE:
00018d 9100 0060                 	lds r16, display_mode
00018f 3002                          cpi r16, MODE_DM          ; Если режим Дата, День или Год
000190 f410                          brsh READ_FULL            ; Переход если больше или равно (Читаем все 7 байт)
                                 
                                     ; Иначе (HM или MS) — читаем только первые 3 байта (Сек, Мин, Час)
                                     ;ldi r17, 3
000191 d003                          rcall READ_DATETIME
000192 c001                          rjmp OUT_RTC
                                 
                                 READ_FULL:
                                     ;ldi r17, 7
000193 d01a                          rcall READ_DATETIME_FULL
                                 OUT_RTC:
000194 9508                      	ret
                                 
                                 ;============== Чтение времени из DS3231 ==================================
                                 
                                 READ_DATETIME:
000195 930f                          push r16
000196 7f7e                      	 cbr rFlags, (1<<rFlag_int0)       
                                     ;rcall I2C_INIT
                                     
000197 d0c1                          rcall I2C_START
                                     ; Адрес DS3231 для записи
000198 ed00                          ldi r16, 0xD0
000199 d0c5                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x00 (секунды)
00019a e000                          ldi r16, 0x00
00019b d0c3                          rcall I2C_WRITE
                                     
00019c d0bc                      	rcall I2C_START
                                     ; Повторный START для чтения
00019d ed01                          ldi r16, 0xD1
00019e d0c0                          rcall I2C_WRITE
                                 		
00019f d0c3                      	rcall I2C_READ_ACK
0001a0 b103                      	in r16, TWDR
0001a1 9300 0066                 	sts i2c_sec,r16
                                 	
0001a3 d0bf                      	rcall I2C_READ_ACK
0001a4 b103                      	in r16, TWDR
0001a5 9300 0067                 	sts i2c_min,r16
                                 	
0001a7 d0be                      	rcall I2C_READ_NACK
0001a8 b103                      	in r16, TWDR
0001a9 9300 0068                 	sts i2c_hours,r16
                                 		
0001ab d0bd                      	rcall I2C_STOP
                                 	
0001ac 910f                      	pop r16
0001ad 9508                         ret
                                 
                                 ;============== Чтение времени из DS3231 ==================================
                                 
                                 READ_DATETIME_FULL:
0001ae 930f                          push r16
                                 	        
                                         
0001af d0a9                          rcall I2C_START
                                     ; Адрес DS3231 для записи
0001b0 ed00                          ldi r16, 0xD0
0001b1 d0ad                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x00 (секунды)
0001b2 e000                          ldi r16, 0x00
0001b3 d0ab                          rcall I2C_WRITE
                                     
0001b4 d0a4                      	rcall I2C_START
                                     ; Повторный START для чтения
0001b5 ed01                          ldi r16, 0xD1
0001b6 d0a8                          rcall I2C_WRITE
                                 		
0001b7 d0ab                      	rcall I2C_READ_ACK
0001b8 b103                      	in r16, TWDR
0001b9 9300 0066                 	sts i2c_sec,r16
                                 	
0001bb d0a7                      	rcall I2C_READ_ACK
0001bc b103                      	in r16, TWDR
0001bd 9300 0067                 	sts i2c_min,r16
                                 
0001bf d0a3                      	rcall I2C_READ_ACK
0001c0 b103                      	in r16, TWDR
0001c1 9300 0068                 	sts i2c_hours,r16
                                 
0001c3 d09f                      	rcall I2C_READ_ACK
0001c4 b103                      	in r16, TWDR
0001c5 9300 0069                 	sts i2c_weekday,r16
                                 
0001c7 d09b                      	rcall I2C_READ_ACK
0001c8 b103                      	in r16, TWDR
0001c9 9300 006a                 	sts i2c_day,r16
                                 
0001cb d097                      	rcall I2C_READ_ACK
0001cc b103                      	in r16, TWDR
0001cd 9300 006b                 	sts i2c_month,r16
                                 	
0001cf d096                      	rcall I2C_READ_NACK
0001d0 b103                      	in r16, TWDR
0001d1 9300 006c                 	sts i2c_year,r16
                                 		
0001d3 d095                      	rcall I2C_STOP
                                 	
0001d4 910f                      	pop r16
0001d5 9508                         ret
                                 
                                  ;=========== Чтение регистра смещения старения кварцевого резонатора ===========
                                  READ_REGISTER_10H:
0001d6 930f                      	push r16
                                 	  
                                     ;rcall I2C_INIT
                                     
0001d7 d081                          rcall I2C_START
                                     ; Адрес DS3231 для записи
0001d8 ed00                          ldi r16, 0xD0
0001d9 d085                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x10 (Crystal Aging Offset (10h))
0001da e100                          ldi r16, 0x10
0001db d083                          rcall I2C_WRITE
                                     
0001dc d07c                      	rcall I2C_START
                                     ; Повторный START для чтения
0001dd ed01                          ldi r16, 0xD1
0001de d080                          rcall I2C_WRITE
                                 		
0001df d086                      	rcall I2C_READ_NACK
0001e0 b103                      	in r16, TWDR
0001e1 9300 006d                 	sts i2c_crystal,r16
                                 		
0001e3 d085                      	rcall I2C_STOP
                                 
0001e4 6270                      	sbr rFlags, (1<<rFlag_Reg10h) ; устанавливаем флаг
                                 
0001e5 910f                      	pop r16
0001e6 9508                         ret
                                 
                                  ;=========== Запись в регистр смещения старения кварцевого резонатора ===========
                                  WRITE_REGISTER_10H:
0001e7 930f                      	push r16
                                 	  
                                     ;rcall I2C_INIT
                                     
0001e8 d070                          rcall I2C_START
                                     ; Адрес DS3231 для записи
0001e9 ed00                          ldi r16, 0xD0
0001ea d074                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x10 (Crystal Aging Offset (10h))
0001eb e100                          ldi r16, 0x10
0001ec d072                          rcall I2C_WRITE
                                     
0001ed 9100 006d                 	lds r16, i2c_crystal ; наше новое значение
0001ef d06f                          rcall I2C_WRITE
                                 		
0001f0 d078                      	rcall I2C_STOP
                                 	
                                 	; Теперь запускаем принудительное преобразование температуры и тем самым применения изменений в регистре 10H
                                     ; (если не хотим ждать 64 секунды)
0001f1 d067                          rcall I2C_START
0001f2 ed00                          ldi   r16, 0xD0
0001f3 d06b                          rcall I2C_WRITE
0001f4 e00e                          ldi   r16, 0x0E          ; регистр управления
0001f5 d069                          rcall I2C_WRITE
                                     ; Читаем текущее значение регистра управления (опционально)
0001f6 d062                          rcall I2C_START
0001f7 ed01                          ldi   r16, 0xD1
0001f8 d066                          rcall I2C_WRITE
0001f9 d06c                          rcall I2C_READ_NACK      ; прочитали байт, он в TWDR
                                     ; Устанавливаем бит CONV (бит 5)
0001fa b103                          in    r16, TWDR
0001fb 6200                          sbr   r16, (1<<5)        ; установить бит 5
0001fc 930f                          push  r16	; в стек
                                     ; Записать обратно
0001fd d05b                          rcall I2C_START
0001fe ed00                          ldi   r16, 0xD0
0001ff d05f                          rcall I2C_WRITE
000200 e00e                          ldi   r16, 0x0E
000201 d05d                          rcall I2C_WRITE
000202 910f                          pop   r16	;из стека
000203 d05b                          rcall I2C_WRITE
000204 d064                          rcall I2C_STOP
                                 	; бит CONV (бит 5) Обнулится после преобразования
000205 910f                      	pop r16
000206 9508                         ret
                                 ; =========== Запись времени в DS3231 ===========
                                 WRITE_DATETIME:
000207 930f                          push r16
                                     
                                     ;rcall I2C_INIT
                                     
000208 d050                      	rcall I2C_START
000209 ed00                          ldi r16, 0xD0
00020a d054                          rcall I2C_WRITE
                                     
00020b e000                          ldi r16, 0x00
00020c d052                          rcall I2C_WRITE
                                     
00020d 9100 0066                     lds r16, i2c_sec
00020f d04f                          rcall I2C_WRITE
                                     
000210 9100 0067                     lds r16, i2c_min
000212 d04c                          rcall I2C_WRITE
                                     
000213 9100 0068                     lds r16, i2c_hours
000215 d049                          rcall I2C_WRITE
                                     
000216 d052                          rcall I2C_STOP
                                 
000217 910f                          pop r16
000218 9508                          ret
                                 
                                 ;============== Запись определенных параметров времени в DS3231 ====================
                                 	WRITE_SPECIFIC_TIME:
000219 930f                      	push r16
                                 
00021a d03e                      	rcall I2C_START
00021b ed00                          ldi r16, 0xD0
00021c d042                          rcall I2C_WRITE
                                 
00021d 9100 0061                 	lds r16, edit_mode
                                 ;запись секунд
00021f 3001                      	cpi r16,1		;
000220 f429                      	BRNE M_Wr		;Перейти если не равно
000221 e000                      	ldi r16, 0x00	; адрес регистра секенд
000222 d03c                      	rcall I2C_WRITE
000223 9100 0066                 	lds r16, i2c_sec
000225 c02a                          rjmp WR_T
                                 ;запись минут
                                 M_Wr:
000226 3002                      	cpi r16,2		;
000227 f429                      	BRNE H_Wr		;Перейти если не равно
000228 e001                      	ldi r16, 0x01	; адрес регистра минут
000229 d035                      	rcall I2C_WRITE
00022a 9100 0067                 	lds r16, i2c_min
00022c c023                          rjmp WR_T
                                 ;запись часов
                                 H_Wr:
00022d 3003                      	cpi r16,3		;
00022e f429                      	BRNE WD_Wr		;Перейти если не равно
00022f e002                      	ldi r16, 0x02	; адрес регистра часов
000230 d02e                      	rcall I2C_WRITE
000231 9100 0068                 	lds r16, i2c_hours
000233 c01c                          rjmp WR_T
                                 ;запись дня недели
                                 WD_Wr:
000234 3004                      	cpi r16,4		;
000235 f429                      	BRNE D_Wr		;Перейти если не равно
000236 e003                      	ldi r16, 0x03	; адрес регистра дня недели
000237 d027                      	rcall I2C_WRITE
000238 9100 0069                 	lds r16, i2c_weekday
00023a c015                      	rjmp WR_T
                                 ;запись дня месяца
                                 D_Wr:
00023b 3005                      	cpi r16,5		;
00023c f429                      	BRNE MO_Wr		;Перейти если не равно
00023d e004                      	ldi r16, 0x04	; адрес регистра дня месяца
00023e d020                      	rcall I2C_WRITE
00023f 9100 006a                 	lds r16, i2c_day
000241 c00e                          rjmp WR_T
                                 ;запись месяца
                                 MO_Wr:
000242 3006                      	cpi r16,6		;
000243 f429                      	BRNE Y_Wr		;Перейти если не равно
000244 e005                      	ldi r16, 0x05	; адрес регистра месяца
000245 d019                      	rcall I2C_WRITE
000246 9100 006b                 	lds r16, i2c_month
000248 c007                      	rjmp WR_T
                                 ;запись года
                                 Y_Wr:
000249 3007                      	cpi r16,7		;
00024a f439                      	BRNE St_Wr		;Перейти если не равно
00024b e006                      	ldi r16, 0x06	; адрес регистра года
00024c d012                      	rcall I2C_WRITE
00024d 9100 006c                 	lds r16, i2c_year
00024f c000                          rjmp WR_T
                                 
                                 WR_T:	
000250 d00e                      	rcall I2C_WRITE
000251 d017                          rcall I2C_STOP
                                 St_Wr:
000252 910f                      	pop r16
000253 9508                          ret
                                 
                                 
                                 ; =========== I2C процедуры ===========
                                 I2C_INIT:
000254 e00b                          ldi r16, 11
000255 b900                          out TWBR, r16 ; TWI Bit Rate Register  коэффициент деления для генератора скорости передачи данных
000256 e000                          ldi r16, (0<<TWPS1)|(0<<TWPS0) ; биты предварительного делителя в регистр TWSR (PrescalerValue = 1)
000257 b901                          out TWSR, r16
000258 9508                          ret
                                 
                                 	; TWINT  устанавливается аппаратно, когда TWI завершил свою текущую работу и ожидает ответа 
                                 	; TWEN разрешает работу TWI и активирует интерфейс TWI
                                 	; TWSTA генерирует условие START
                                 I2C_START:
000259 ea04                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTA)
00025a bf06                          out TWCR, r16
                                 
                                 I2C_WAIT:
00025b b706                          in r16, TWCR
00025c ff07                          sbrs r16, TWINT ;  проверяет состояние 7 бита TWINT в регистре и, если этот бит установлен, пропускает следующую команду
00025d cffd                          rjmp I2C_WAIT
00025e 9508                          ret
                                 
                                 I2C_WRITE:
00025f b903                          out TWDR, r16
000260 e804                          ldi r16, (1<<TWINT)|(1<<TWEN)
000261 bf06                          out TWCR, r16
000262 cff8                          rjmp I2C_WAIT
                                 
                                 	; TWEA: TWI Enable Acknowledge Bit 
                                 I2C_READ_ACK:
000263 ec04                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWEA)
000264 bf06                          out TWCR, r16
000265 cff5                          rjmp I2C_WAIT
                                 
                                 I2C_READ_NACK:
000266 e804                          ldi r16, (1<<TWINT)|(1<<TWEN)
000267 bf06                          out TWCR, r16
000268 cff2                          rjmp I2C_WAIT
                                 
                                 	; TWSTO: TWI STOP Condition Bit 
                                 I2C_STOP:
000269 e904                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
00026a bf06                          out TWCR, r16
00026b 9508                          ret
                                 
                                 .include "spi.asm"
                                 
                                  * spi_1.asm
                                  *
                                  *  Created: 07.01.2026 22:45:59
                                  *   Author: ar_user
                                  */ 
                                  INIT_SPI:
                                 ; Включение SPI, режим Master, частота F_CPU/16
00026c e501                          ldi r16, (1<<SPE)|(1<<MSTR)|(0<<SPR1)|(1<<SPR0)
00026d b90d                          out SPCR, r16
                                     ;ldi r16, (0<<SPI2X); этот бит в нуль для полного спокойствия
00026e e001                      	ldi r16, (1<<SPI2X); Бит удвоения скорости SPI
00026f b90e                          out SPSR, r16
000270 9508                          ret
                                 
                                 
                                 ;=================== SPI_SEND (ОТПРАВКА БАЙТА ЧЕРЕЗ SPI)===================
                                 
                                 SPI_SEND:
                                     ; Вход: r16 = данные для отправки
                                     ; Выход: данные отправлены через аппаратный SPI
                                     
000271 b90f                          out SPDR, r16          ; Записываем данные в регистр SPI
                                 
                                 SPI_WAIT:
000272 b10e                          in r16, SPSR           ; Читаем статус SPI
000273 ff07                          sbrs r16, SPIF         ; Пропустить следующую команду если бит в регистре установлен. Проверяем флаг завершения передачи
000274 cffd                      	rjmp SPI_WAIT          ; Ждем завершения
                                     
000275 9508                          ret
                                 
                                 DIGIT_TO_SEGMENT:
                                     ; Вход: r18 = цифра (0-9)
                                     ; Выход: r18 = код сегментов для этой цифры
                                     ; Использует: Z, r17
                                 
000276 93ef                          push ZL
000277 93ff                          push ZH
000278 931f                          push r17
                                    
000279 e4e0                          ldi ZL, low(SEG_TABLE*2)
00027a e0f0                          ldi ZH, high(SEG_TABLE*2)
00027b 0fe2                          add ZL, r18
00027c 2711                          clr r17
00027d 1ff1                          adc ZH, r17
00027e 9124                          lpm r18, Z
                                 
00027f 911f                          pop r17
000280 91ff                          pop ZH
000281 91ef                          pop ZL
000282 9508                          ret
                                 
                                  ;=========== Прерывание от DS3231 (INT0) ===========
                                 INT0_ISR:
                                 
000283 b65f                          in r5, SREG
000284 930f                          push r16
                                 	
000285 6071                      	sbr rFlags, (1<<rFlag_int0) ; устанавливаем флаг
                                    	
000286 910f                      	pop r16
000287 be5f                          out SREG, r5
                                 	
000288 9518                          reti
                                 
                                 INT1_ISR:
000289 b66f                      	in r6, SREG
00028a 930f                          push r16
                                 
                                 	; ВЫКЛЮЧИТЬ INT1, чтобы не частил (сбросить бит INT1, сохранив INT0)
                                 	/*in  r16, GICR			; Читаем текущее состояние прерываний
                                 	andi r16, ~(1<<INT1)	; Сбрасываем только бит INT1 (это способ создать маску для инвертирования нужного бита в регистре микроконтроллера)
                                 	out GICR, r16			; Выключаем INT1*/
                                 
00028b b70b                      	in r16, GICR
00028c 770f                          cbr r16, (1<<INT1)
00028d bf0b                          out GICR, r16
                                 
                                 	; Запуск Таймера 0
                                 	/*; Устанавливаем предделитель (для 10мс)
                                 	Частота МК: 1 000 000 Гц.
                                 	Максимальный предделитель: 1024.
                                 	Частота таймера: 1000000/1024=976,5 Гц.
                                 	Период одного тика: =1,024 мс.
                                 	Количество тиков для 10 мс: 10/1,024=9,76.
                                 	10 мс — это почти ровно 10 тиков таймера при предделителе 1024.
                                 	Это дает погрешность около 2.4% (реально будет 10.24 мс), что для кнопок абсолютно не критично.
                                 	Чтобы таймер срабатывал каждые 10 тиков, мы будем использовать прерывание по переполнению (OVF) и при каждом входе догружать в счетчик значение, чтобы он быстрее добегал до 256.
                                  	Расчет: 256-10=246  (0xF6).*/
                                 	;ldi r16, 246        ; Заряжаем на 10 тиков до переполнения
00028e ef06                      	ldi r16, 246
00028f bf02                          out TCNT0, r16
000290 e005                          ldi r16, (1<<CS02)|(0<<CS01)|(1<<CS00) ; Предделитель 1024 (Запуск)
000291 bf03                          out TCCR0, r16
                                 
                                 	
                                 	; Чистим флаг INT1 (дребезг при отпускании)
                                 	; 1. Сначала сбрасываем флаг INT1 (записью единицы!)
000292 e800                          ldi r16, (1<<INTF1)
000293 bf0a                          out GIFR, r16    ; Запись '1' в флаг прерывания очищает его    
                                     
                                 	; 2. Теперь безопасно включаем INT1
000294 b70b                          in r16, GICR
000295 6800                          ori r16, (1<<INT1)
000296 bf0b                          out GICR, r16        ; Снова включаем ожидание нажатия (INT1)
                                 
000297 910f                      	pop r16
000298 be6f                          out SREG, r6
                                 
                                 	.include "button.asm"
                                 
                                  * button.asm
                                  *
                                  *  Created: 09.02.2026 20:48:56
                                  *   Author: ar_user
                                  */ 
                                  TIMER0_ISR:
                                 	;sbi PORTB, PB0        ; ПОДНЯТЬ PB0 (Начало импульса)  для осцилла
                                 
000299 b67f                      	in r7, SREG         ; Быстро сохраняем статус в R7 (1 такт)
00029a 930f                          push r16
00029b 934f                      	push r20
                                 	
                                 	; 1. Перезапуск таймера (Т0 требует ручной дозагрузки)
00029c ef06                          ldi r16, 246
00029d bf02                          out TCNT0, r16
                                 
                                 	; 1. Читаем и инвертируем
00029e b340                          in   rBtn_now, BTN_PIN	; Считываем весь порт D
00029f 9540                          com  rBtn_now			; Инвертируем (нажатая кнопка теперь "1")
0002a0 7f40                          andi rBtn_now, BTN_MASK	; Оставляем только PD4-PD7 (BTN_MASK=0xF0)
                                 
                                     ; 2. Если ничего не нажато — сброс счетчика и выход (или выключение)
0002a1 2344                          tst  rBtn_now
0002a2 f071                          breq BTN_RESET_CNT		; Перейти если равно 0 — кнопка отпущена
                                 
                                     ; 3. Кнопка нажата — увеличиваем счетчик
0002a3 9483                          inc  rDebounce
0002a4 e005                      	ldi r16, T_SHORT 
0002a5 1680                          cp  rDebounce, r16
0002a6 f090                          brlo TIM0_EXIT          ; Если еще не накопили 3 такта — просто выходим
                                 
                                     ; --- Кнопка подтверждена (нажата стабильно ~45-50 мс) ---
0002a7 6074                          sbr  rFlags, (1<<rFlag_short)
                                     
                                     ; Перевод в индекс (0-3)
0002a8 9542                          swap rBtn_now
0002a9 e050                          ldi  rBtn_Index, 0
                                 FIND_IDX:
0002aa fd43                          sbrc rBtn_now, 3
0002ab c003                          rjmp BTN_SAVE
0002ac 9553                          inc  rBtn_Index
0002ad 0f44                          lsl  rBtn_now
0002ae cffb                          rjmp FIND_IDX
                                 
                                 BTN_SAVE:
0002af 9350 006e                     sts  rBtn_Save, rBtn_Index
                                     ; Теперь выключаем таймер, чтобы не частил
                                     ;rjmp STOP_TIMER
                                 
                                 BTN_RESET_CNT:
0002b1 2488                          clr  rDebounce
                                     ; Если кнопка пропала сразу (помеха), выключаем таймер
                                     ; Если хотим ловить длинные нажатия — логика меняется
                                 
                                 STOP_TIMER:
0002b2 e000                          ldi  r16, 0
0002b3 bf03                          out  TCCR0, r16 ; ВЫКЛЮЧАЕМ ТАЙМЕР 0 
                                     ; Чистим флаг INT1 (дребезг при отпускании)
                                 	; 1. Сначала сбрасываем флаг INT1 (записью единицы!)
0002b4 e800                          ldi r16, (1<<INTF1)
0002b5 bf0a                          out GIFR, r16    ; Запись '1' в флаг прерывания очищает его    
                                     
                                 	; 2. Теперь безопасно включаем INT1
0002b6 b70b                          in r16, GICR
0002b7 6800                          ori r16, (1<<INT1)
0002b8 bf0b                          out GICR, r16        ; Снова включаем ожидание нажатия (INT1)
                                 
                                 TIM0_EXIT:
                                    
0002b9 914f                      	pop r20
0002ba 910f                          pop r16
0002bb be7f                          out SREG, r7
                                 
                                 	;cbi PORTB, PB0        ; ОПУСТИТЬ PB0 (Конец импульса) для осцилла
0002bc 9518                      reti
                                 
                                 
                                 Press_Short:
0002bd 930f                      	push r16
0002be d00a                      	rcall Progra_Short
0002bf 7f7b                      	cbr rFlags, (1<<rFlag_Short)
0002c0 6078                      	sbr rFlags, (1<<rFlag_TimeOut) ; установка флага
0002c1 e302                      	ldi r16,Sec_TimeOut		;вот они 50 секунд для TimeOut
0002c2 9300 006f                 	sts timeout_cnt, r16
0002c4 2700                      	clr r16
0002c5 9300 006e                 	sts rBtn_Save, r16
0002c7 910f                      	pop r16
0002c8 9508                      	ret
                                 
                                  
                                  Progra_Short:
0002c9 9100 006e                 	lds r16, rBtn_Save
                                 	;mov r16, rBtn_index
                                 	; Используем табличный переход
                                 	; Загружаем базовый адрес таблицы
0002cb e2ea                          ldi  ZL, low(TABLSHORT) 
0002cc e0f0                          ldi  ZH, high(TABLSHORT)
                                     ; Прибавляем индекс к адресу (Z = Z + r16)
0002cd 0fe0                          add  ZL, r16
0002ce 2711                          clr  r17
0002cf 1ff1                          adc  ZH, r17              ; Учитываем перенос
                                 
0002d0 9409                          ijmp                      ; ПРЫЖОК в обработчики табличных переходов по адресу в Z 
                                 
0002d1 9508                       ret
                                 
                                 
                                 CHANGE_MO:
0002d2 9100 0061                 	lds r16, edit_mode
0002d4 2300                          tst r16
0002d5 f011                          breq MODE_NEXT		   ; Перейти если равно 0, т.е. мы не в режиме редактирования
0002d6 d043                          rcall SAVE_TO_RTC      ; Если были в редактировании времени - сохраняем
0002d7 9508                          ret
                                 MODE_NEXT:
0002d8 9100 0060                     lds r16, display_mode
0002da 9503                          inc r16
0002db 3006                          cpi r16, 6
0002dc f008                          brlo MO_ST			; Перейти если меньше
0002dd 2700                          clr r16
                                 MO_ST:
0002de 9300 0060                     sts display_mode, r16
0002e0 9508                       ret
                                 
                                 CHANGE_ED:
0002e1 9100 0061                 	lds r16, edit_mode
0002e3 9503                          inc r16
                                     ;cpi r16, 8             ; 7 параметров + 1 выход
0002e4 3009                      	cpi r16, 9             ; 8 параметров + 1 выход
0002e5 f008                          brlo ED_ST
0002e6 2700                          clr r16
                                 ED_ST:
0002e7 9300 0061                     sts edit_mode, r16
0002e9 9300 0060                 	sts display_mode, r16
                                     
0002eb 9508                      ret
                                 
                                 PLUS:
0002ec 9100 0061                 	lds  r16, edit_mode
0002ee 2300                          tst  r16
0002ef f031                          breq PL_BRIGHT           ; Если не в режиме настройки — Увеличиваем яркость
0002f0 3008                      	cpi r16,8
0002f1 f011                      	breq Pl_CRUS		   ; Перейти если равно, работаем с изменение регистра кварца
0002f2 d030                          rcall VALUE_UP			; Вызываем наш универсальный инкремент через X
0002f3 c003                      	rjmp  Pl_DONE
                                 Pl_CRUS:
0002f4 d087                      	rcall Pl_CRUSTAL
0002f5 c001                      	rjmp  Pl_DONE       
                                 PL_BRIGHT:
0002f6 d00d                      	rcall BRIGHT_UP
                                 Pl_DONE:
                                 
0002f7 9508                      ret
                                 
                                 MINUS:
0002f8 9100 0061                 	lds  r16, edit_mode
0002fa 2300                          tst  r16
0002fb f031                          breq MI_BRIGHT           ; Если не в режиме настройки — Уменьшаем яркость
0002fc 3008                      	cpi r16,8
0002fd f011                      	breq MI_CRUS		   ; Перейти если равно, работаем с изменение регистра кварца 
0002fe d03f                          rcall VALUE_DOWN		; Вызываем наш универсальный инкремент через X
0002ff c003                      	rjmp  Mi_DONE
                                 MI_CRUS:
000300 d085                      	rcall MI_CRUSTAL
000301 c001                      	rjmp  Mi_DONE        
                                 MI_BRIGHT:
000302 d00c                      	rcall BRIGHT_DOWN
                                 Mi_DONE:
                                     
000303 9508                      ret
                                 
                                 BRIGHT_UP:
000304 b50a                      	in r16, OCR1AL
000305 b51b                      	in r17, OCR1AH
000306 300a                      	cpi r16, 10   ; Проверка нижней границы (макс. яркость)
000307 f010                          brlo LIMIT_UP    ; Перейти если меньше Не уменьшаем дальше
000308 5005                          subi r16, 5  ; Уменьшаем значение OCR1A (свет станет ярче)
000309 c001                      	rjmp BRU_OUT
                                 LIMIT_UP:
00030a e70d                      	ldi r16, 125
                                 BRU_OUT:
00030b 2711                          clr r17
00030c bd1b                          out OCR1AH, r17
00030d bd0a                      	out OCR1AL, r16
00030e 9508                      ret
                                 
                                 BRIGHT_DOWN:
00030f b50a                      	in r16, OCR1AL
000310 b51b                      	in r17, OCR1AH
000311 3f0a                      	cpi r16, 250	; Проверка верхней границы (мин. яркость)
000312 f410                          brsh LIMIT_DOWN    ; Перейти если больше или равно  Не увеличиваем дальше
000313 5f0b                          subi r16, -5	; Увеличиваем значение OCR1A (свет станет тусклее)
000314 c001                      	rjmp BRD_OUT
                                 LIMIT_DOWN:
000315 e70d                      	ldi r16, 125
                                 BRD_OUT:
000316 2711                          clr r17
000317 bd1b                          out OCR1AH, r17
000318 bd0a                      	out OCR1AL, r16
000319 9508                      ret
                                 
                                  
                                  SAVE_TO_RTC:
00031a 9100 0061                 	lds r16, edit_mode
00031c defc                      	rcall WRITE_SPECIFIC_TIME
00031d 2700                      	clr r16
00031e 9300 0061                 	sts edit_mode, r16
000320 9300 0060                 	sts display_mode, r16
000322 9508                       ret
                                 
                                  VALUE_UP:
                                 	
000323 9100 0061                 	lds  r16, edit_mode
000325 2300                          tst  r16
000326 f0b1                          breq VU_EXIT            ; Если 0 — мы не в режиме настройки, выходим
                                 	
                                     ; Вычисляем адрес нужного байта в i2c_buffer
000327 e6a6                          ldi  XL, low(i2c_buffer)
000328 e0b0                          ldi  XH, high(i2c_buffer)
                                     
                                     ; Смещение: DS3231 имеет порядок Сек(0), Мин(1), Час(2)...
                                     ; Настраиваем указатель: X = i2c_buffer + (edit_mode - 1)
000329 2f10                          mov  r17, r16
00032a 951a                          dec  r17                ; Делаем из 1..7 -> 0..6
00032b 0fa1                          add  XL, r17
00032c 2711                          clr  r17
00032d 1fb1                          adc  XH, r17            ; Указатель X теперь смотрит прямо на байт в SRAM
                                 
00032e 910c                          ld   r16, X             ; Загружаем значение (например, минуты)
                                     
                                     ; Определяем предел для текущего параметра
00032f d02f                          rcall GET_LIMIT         ; Возвращает предел в r17 (напр. 0x60 для минут)
                                     
                                     ; Инкремент BCD
000330 5f0f                          subi r16, -1            ; +1
000331 2f20                          mov  r18, r16
000332 702f                          andi r18, 0x0F
000333 302a                          cpi  r18, 0x0A          ; Проверка полупереноса
000334 f008                          brlo VU_CHECK_LIMIT
000335 5f0a                          subi r16, -6            ; Коррекция BCD (+6)
                                 
                                 VU_CHECK_LIMIT:
000336 1701                          cp   r16, r17           ; Проверка достижения максимума
000337 f008                          brlo VU_SAVE
000338 e000                          ldi  r16, 0x00          ; Сброс в ноль
                                 
                                 VU_SAVE:
000339 930c                          st   X, r16             ; Сохраняем обратно в i2c_buffer
00033a 7f7d                      	cbr rFlags, (1<<rFlag_dot)
00033b ddc8                          rcall DISPLAY_EDIT ; Сразу обновляем экран для отклика
00033c c000                      	rjmp VU_EXIT
                                 
                                 VU_EXIT:
00033d 9508                       ret
                                 
                                 
                                  VALUE_DOWN:
                                 
00033e 9110 0061                 	lds  r17, edit_mode
000340 2311                          tst  r17
000341 f0e1                          breq VD_EXIT            ; Если 0 — выходим
                                 	
                                     ; Настройка указателя X на нужный байт в i2c_buffer
000342 e6a6                          ldi  XL, low(i2c_buffer)
000343 e0b0                          ldi  XH, high(i2c_buffer)
000344 951a                          dec  r17                ; Смещение (0..6)
000345 0fa1                          add  XL, r17
000346 2711                          clr  r17
000347 1fb1                          adc  XH, r17
                                 
000348 910c                          ld   r16, X             ; Загружаем значение (напр. 0x10)
                                 
                                     
                                     ; --- Сама логика декремента BCD ---
000349 2300                          tst  r16                ; Проверяем, не ноль ли уже?
00034a f039                          breq VD_SET_MAX         ; Если 0x00, переходим к максимальному пределу
                                     
00034b 5001                          subi r16, 1             ; Вычитаем 1 (0x10 -> 0x0F)
00034c 2f20                          mov  r18, r16
00034d 702f                          andi r18, 0x0F          ; Изолируем младшую тетраду
00034e 302f                          cpi  r18, 0x0F          ; Был ли переход через ноль (заем)?
00034f f459                          brne VD_SAVE            ; Если нет (результат 0..8) — всё ок
                                     
000350 5006                          subi r16, 6             ; Коррекция: 0x0F - 0x06 = 0x09
000351 c009                          rjmp VD_SAVE
                                 
                                 VD_SET_MAX:
000352 d00c                          rcall GET_LIMIT         ; Получаем предел (напр. 0x60 для минут) в r17
000353 2f01                          mov  r16, r17
                                     ; Нужно уменьшить предел на 1 шаг BCD, так как предел 0x60 — это уже "перебор"
                                     ; Чтобы получить 0x59 из 0x60:
000354 5001                          subi r16, 1
000355 2f20                          mov  r18, r16
000356 702f                          andi r18, 0x0F
000357 302f                          cpi  r18, 0x0F
000358 f411                          brne VD_SAVE
000359 5006                          subi r16, 6             ; 0x5F -> 0x59
00035a c000                          rjmp VD_SAVE
                                 
                                 VD_SAVE:
00035b 930c                          st   X, r16             ; Сохраняем результат
00035c dda7                          rcall DISPLAY_EDIT ; Сразу обновляем экран для отклика
00035d c000                      	rjmp VD_EXIT
                                 
                                 VD_EXIT:
                                    
00035e 9508                       ret
                                 
                                  GET_LIMIT:
00035f 9130 0061                     lds  r19, edit_mode
000361 3031                          cpi  r19, 1             ; Секунды
000362 f069                          breq LIM_60
000363 3032                          cpi  r19, 2             ; Минуты
000364 f059                          breq LIM_60
000365 3033                          cpi  r19, 3             ; Часы
000366 f079                          breq LIM_24
000367 3034                          cpi  r19, 4             ; День недели
000368 f049                          breq LIM_8	
000369 3035                          cpi  r19, 5             ; Дата (упрощенно до 31)
00036a f069                          breq LIM_32
00036b 3036                      	cpi  r19, 6             ; Месяц
00036c f039                          breq LIM_13
00036d 3037                      	cpi  r19, 7             ; Год (упрощенно до 99)
00036e f059                          breq LIM_99
00036f 9508                          ret
                                 
                                 LIM_60:
000370 e610                      	ldi r17, 0x60
000371 9508                      	ret
                                 LIM_8:
000372 e018                      	ldi r17, 0x08
000373 9508                      	ret
                                 LIM_13:
000374 e113                      	ldi r17, 0x13
000375 9508                      	ret
                                 LIM_24:
000376 e214                      	ldi r17, 0x24
000377 9508                      	ret
                                 LIM_32:
000378 e312                      	ldi r17, 0x32
000379 9508                      	ret
                                 LIM_99:
00037a e919                      	ldi r17, 0x99
00037b 9508                      	ret
                                 
                                 
