                                 ; ***** PORTB ************************
                                 ; PORTB - Port B Data Register
                                 .equ	PORTB0	= 0	; Port B Data Register bit 0
                                 .equ	PB0	= 0	; For compatibility
                                 .equ	PORTB1	= 1	; Port B Data Register bit 1
                                 .equ	PB1	= 1	; For compatibility
                                 .equ	PORTB2	= 2	; Port B Data Register bit 2
                                 .equ	PB2	= 2	; For compatibility
                                 .equ	PORTB3	= 3	; Port B Data Register bit 3
                                 .equ	PB3	= 3	; For compatibility
                                 .equ	PORTB4	= 4	; Port B Data Register bit 4
                                 .equ	PB4	= 4	; For compatibility
                                 .equ	PORTB5	= 5	; Port B Data Register bit 5
                                 .equ	PB5	= 5	; For compatibility
                                 .equ	PORTB6	= 6	; Port B Data Register bit 6
                                 .equ	PB6	= 6	; For compatibility
                                 .equ	PORTB7	= 7	; Port B Data Register bit 7
                                 .equ	PB7	= 7	; For compatibility
                                 
                                 ; DDRB - Port B Data Direction Register
                                 .equ	DDB0	= 0	; Port B Data Direction Register bit 0
                                 .equ	DDB1	= 1	; Port B Data Direction Register bit 1
                                 .equ	DDB2	= 2	; Port B Data Direction Register bit 2
                                 .equ	DDB3	= 3	; Port B Data Direction Register bit 3
                                 .equ	DDB4	= 4	; Port B Data Direction Register bit 4
                                 .equ	DDB5	= 5	; Port B Data Direction Register bit 5
                                 .equ	DDB6	= 6	; Port B Data Direction Register bit 6
                                 .equ	DDB7	= 7	; Port B Data Direction Register bit 7
                                 
                                 ; PINB - Port B Input Pins
                                 .equ	PINB0	= 0	; Port B Input Pins bit 0
                                 .equ	PINB1	= 1	; Port B Input Pins bit 1
                                 .equ	PINB2	= 2	; Port B Input Pins bit 2
                                 .equ	PINB3	= 3	; Port B Input Pins bit 3
                                 .equ	PINB4	= 4	; Port B Input Pins bit 4
                                 .equ	PINB5	= 5	; Port B Input Pins bit 5
                                 .equ	PINB6	= 6	; Port B Input Pins bit 6
                                 .equ	PINB7	= 7	; Port B Input Pins bit 7
                                 
                                 
                                 ; ***** PORTC ************************
                                 ; PORTC - Port C Data Register
                                 .equ	PORTC0	= 0	; Port C Data Register bit 0
                                 .equ	PC0	= 0	; For compatibility
                                 .equ	PORTC1	= 1	; Port C Data Register bit 1
                                 .equ	PC1	= 1	; For compatibility
                                 .equ	PORTC2	= 2	; Port C Data Register bit 2
                                 .equ	PC2	= 2	; For compatibility
                                 .equ	PORTC3	= 3	; Port C Data Register bit 3
                                 .equ	PC3	= 3	; For compatibility
                                 .equ	PORTC4	= 4	; Port C Data Register bit 4
                                 .equ	PC4	= 4	; For compatibility
                                 .equ	PORTC5	= 5	; Port C Data Register bit 5
                                 .equ	PC5	= 5	; For compatibility
                                 .equ	PORTC6	= 6	; Port C Data Register bit 6
                                 .equ	PC6	= 6	; For compatibility
                                 
                                 ; DDRC - Port C Data Direction Register
                                 .equ	DDC0	= 0	; Port C Data Direction Register bit 0
                                 .equ	DDC1	= 1	; Port C Data Direction Register bit 1
                                 .equ	DDC2	= 2	; Port C Data Direction Register bit 2
                                 .equ	DDC3	= 3	; Port C Data Direction Register bit 3
                                 .equ	DDC4	= 4	; Port C Data Direction Register bit 4
                                 .equ	DDC5	= 5	; Port C Data Direction Register bit 5
                                 .equ	DDC6	= 6	; Port C Data Direction Register bit 6
                                 
                                 ; PINC - Port C Input Pins
                                 .equ	PINC0	= 0	; Port C Input Pins bit 0
                                 .equ	PINC1	= 1	; Port C Input Pins bit 1
                                 .equ	PINC2	= 2	; Port C Input Pins bit 2
                                 .equ	PINC3	= 3	; Port C Input Pins bit 3
                                 .equ	PINC4	= 4	; Port C Input Pins bit 4
                                 .equ	PINC5	= 5	; Port C Input Pins bit 5
                                 .equ	PINC6	= 6	; Port C Input Pins bit 6
                                 
                                 
                                 ; ***** PORTD ************************
                                 ; PORTD - Port D Data Register
                                 .equ	PORTD0	= 0	; Port D Data Register bit 0
                                 .equ	PD0	= 0	; For compatibility
                                 .equ	PORTD1	= 1	; Port D Data Register bit 1
                                 .equ	PD1	= 1	; For compatibility
                                 .equ	PORTD2	= 2	; Port D Data Register bit 2
                                 .equ	PD2	= 2	; For compatibility
                                 .equ	PORTD3	= 3	; Port D Data Register bit 3
                                 .equ	PD3	= 3	; For compatibility
                                 .equ	PORTD4	= 4	; Port D Data Register bit 4
                                 .equ	PD4	= 4	; For compatibility
                                 .equ	PORTD5	= 5	; Port D Data Register bit 5
                                 .equ	PD5	= 5	; For compatibility
                                 .equ	PORTD6	= 6	; Port D Data Register bit 6
                                 .equ	PD6	= 6	; For compatibility
                                 .equ	PORTD7	= 7	; Port D Data Register bit 7
                                 .equ	PD7	= 7	; For compatibility
                                 
                                 ; DDRD - Port D Data Direction Register
                                 .equ	DDD0	= 0	; Port D Data Direction Register bit 0
                                 .equ	DDD1	= 1	; Port D Data Direction Register bit 1
                                 .equ	DDD2	= 2	; Port D Data Direction Register bit 2
                                 .equ	DDD3	= 3	; Port D Data Direction Register bit 3
                                 .equ	DDD4	= 4	; Port D Data Direction Register bit 4
                                 .equ	DDD5	= 5	; Port D Data Direction Register bit 5
                                 .equ	DDD6	= 6	; Port D Data Direction Register bit 6
                                 .equ	DDD7	= 7	; Port D Data Direction Register bit 7
                                 
                                 ; PIND - Port D Input Pins
                                 .equ	PIND0	= 0	; Port D Input Pins bit 0
                                 .equ	PIND1	= 1	; Port D Input Pins bit 1
                                 .equ	PIND2	= 2	; Port D Input Pins bit 2
                                 .equ	PIND3	= 3	; Port D Input Pins bit 3
                                 .equ	PIND4	= 4	; Port D Input Pins bit 4
                                 .equ	PIND5	= 5	; Port D Input Pins bit 5
                                 .equ	PIND6	= 6	; Port D Input Pins bit 6
                                 .equ	PIND7	= 7	; Port D Input Pins bit 7
                                 
                                 
                                 ; ***** EEPROM ***********************
                                 ; EEDR - EEPROM Data Register
                                 .equ	EEDR0	= 0	; EEPROM Data Register bit 0
                                 .equ	EEDR1	= 1	; EEPROM Data Register bit 1
                                 .equ	EEDR2	= 2	; EEPROM Data Register bit 2
                                 .equ	EEDR3	= 3	; EEPROM Data Register bit 3
                                 .equ	EEDR4	= 4	; EEPROM Data Register bit 4
                                 .equ	EEDR5	= 5	; EEPROM Data Register bit 5
                                 .equ	EEDR6	= 6	; EEPROM Data Register bit 6
                                 .equ	EEDR7	= 7	; EEPROM Data Register bit 7
                                 
                                 ; EECR - EEPROM Control Register
                                 .equ	EERE	= 0	; EEPROM Read Enable
                                 .equ	EEWE	= 1	; EEPROM Write Enable
                                 .equ	EEMWE	= 2	; EEPROM Master Write Enable
                                 .equ	EEWEE	= EEMWE	; For compatibility
                                 .equ	EERIE	= 3	; EEPROM Ready Interrupt Enable
                                 
                                 
                                 ; ***** CPU **************************
                                 ; SREG - Status Register
                                 .equ	SREG_C	= 0	; Carry Flag
                                 .equ	SREG_Z	= 1	; Zero Flag
                                 .equ	SREG_N	= 2	; Negative Flag
                                 .equ	SREG_V	= 3	; Two's Complement Overflow Flag
                                 .equ	SREG_S	= 4	; Sign Bit
                                 .equ	SREG_H	= 5	; Half Carry Flag
                                 .equ	SREG_T	= 6	; Bit Copy Storage
                                 .equ	SREG_I	= 7	; Global Interrupt Enable
                                 
                                 ; MCUCR - MCU Control Register
                                 ;.equ	ISC00	= 0	; Interrupt Sense Control 0 Bit 0
                                 ;.equ	ISC01	= 1	; Interrupt Sense Control 0 Bit 1
                                 ;.equ	ISC10	= 2	; Interrupt Sense Control 1 Bit 0
                                 ;.equ	ISC11	= 3	; Interrupt Sense Control 1 Bit 1
                                 .equ	SM0	= 4	; Sleep Mode Select
                                 .equ	SM1	= 5	; Sleep Mode Select
                                 .equ	SM2	= 6	; Sleep Mode Select
                                 .equ	SE	= 7	; Sleep Enable
                                 
                                 ; MCUCSR - MCU Control And Status Register
                                 .equ	MCUSR	= MCUCSR	; For compatibility
                                 .equ	PORF	= 0	; Power-on reset flag
                                 .equ	EXTRF	= 1	; External Reset Flag
                                 .equ	BORF	= 2	; Brown-out Reset Flag
                                 .equ	WDRF	= 3	; Watchdog Reset Flag
                                 
                                 ; OSCCAL - Oscillator Calibration Value
                                 .equ	CAL0	= 0	; Oscillator Calibration Value Bit0
                                 .equ	CAL1	= 1	; Oscillator Calibration Value Bit1
                                 .equ	CAL2	= 2	; Oscillator Calibration Value Bit2
                                 .equ	CAL3	= 3	; Oscillator Calibration Value Bit3
                                 .equ	CAL4	= 4	; Oscillator Calibration Value Bit4
                                 .equ	CAL5	= 5	; Oscillator Calibration Value Bit5
                                 .equ	CAL6	= 6	; Oscillator Calibration Value Bit6
                                 .equ	CAL7	= 7	; Oscillator Calibration Value Bit7
                                 
                                 ; SPMCR - Store Program Memory Control Register
                                 .equ	SPMEN	= 0	; Store Program Memory Enable
                                 .equ	PGERS	= 1	; Page Erase
                                 .equ	PGWRT	= 2	; Page Write
                                 .equ	BLBSET	= 3	; Boot Lock Bit Set
                                 .equ	RWWSRE	= 4	; Read-While-Write Section Read Enable
                                 .equ	RWWSB	= 6	; Read-While-Write Section Busy
                                 .equ	SPMIE	= 7	; SPM Interrupt Enable
                                 
                                 ; SFIOR - Special Function IO Register
                                 .equ	PSR10	= 0	; Prescaler Reset Timer/Counter1 and Timer/Counter0
                                 .equ	PUD	= 2	; Pull-up Disable
                                 .equ	ADHSM	= 4	; ADC High Speed Mode
                                 
                                 
                                 ; ***** AD_CONVERTER *****************
                                 ; ADMUX - The ADC multiplexer Selection Register
                                 .equ	MUX0	= 0	; Analog Channel and Gain Selection Bits
                                 .equ	MUX1	= 1	; Analog Channel and Gain Selection Bits
                                 .equ	MUX2	= 2	; Analog Channel and Gain Selection Bits
                                 .equ	MUX3	= 3	; Analog Channel and Gain Selection Bits
                                 .equ	ADLAR	= 5	; Left Adjust Result
                                 .equ	REFS0	= 6	; Reference Selection Bit 0
                                 .equ	REFS1	= 7	; Reference Selection Bit 1
                                 
                                 ; ADCSRA - The ADC Control and Status register
                                 .equ	ADCSR	= ADCSRA	; For compatibility
                                 .equ	ADPS0	= 0	; ADC  Prescaler Select Bits
                                 .equ	ADPS1	= 1	; ADC  Prescaler Select Bits
                                 .equ	ADPS2	= 2	; ADC  Prescaler Select Bits
                                 .equ	ADIE	= 3	; ADC Interrupt Enable
                                 .equ	ADIF	= 4	; ADC Interrupt Flag
                                 .equ	ADFR	= 5	; ADC  Free Running Select
                                 .equ	ADSC	= 6	; ADC Start Conversion
                                 .equ	ADEN	= 7	; ADC Enable
                                 
                                 
                                 
                                 ; ***** LOCKSBITS ********************************************************
                                 .equ	LB1	= 0	; Lock bit
                                 .equ	LB2	= 1	; Lock bit
                                 .equ	BLB01	= 2	; Boot Lock bit
                                 .equ	BLB02	= 3	; Boot Lock bit
                                 .equ	BLB11	= 4	; Boot lock bit
                                 .equ	BLB12	= 5	; Boot lock bit
                                 
                                 
                                 ; ***** FUSES ************************************************************
                                 ; LOW fuse bits
                                 .equ	CKSEL0	= 0	; Select Clock Source
                                 .equ	CKSEL1	= 1	; Select Clock Source
                                 .equ	CKSEL2	= 2	; Select Clock Source
                                 .equ	CKSEL3	= 3	; Select Clock Source
                                 .equ	SUT0	= 4	; Select start-up time
                                 .equ	SUT1	= 5	; Select start-up time
                                 .equ	BODEN	= 6	; Brown out detector enable
                                 .equ	BODLEVEL	= 7	; Brown out detector trigger level
                                 
                                 ; HIGH fuse bits
                                 .equ	BOOTRST	= 0	; Select Reset Vector
                                 .equ	BOOTSZ0	= 1	; Select Boot Size
                                 .equ	BOOTSZ1	= 2	; Select Boot Size
                                 .equ	EESAVE	= 3	; EEPROM memory is preserved through chip erase
                                 .equ	CKOPT	= 4	; Oscillator Options
                                 .equ	SPIEN	= 5	; Enable Serial programming and Data Downloading
                                 .equ	WTDON	= 6	; Enable watchdog
                                 .equ	RSTDISBL	= 7	; Disable reset
                                 
                                 
                                 
                                 ; ***** CPU REGISTER DEFINITIONS *****************************************
                                 .def	XH	= r27
                                 .def	XL	= r26
                                 .def	YH	= r29
                                 .def	YL	= r28
                                 .def	ZH	= r31
                                 .def	ZL	= r30
                                 
                                 
                                 
                                 ; ***** DATA MEMORY DECLARATIONS *****************************************
                                 .equ	FLASHEND	= 0x0fff	; Note: Word address
                                 .equ	IOEND	= 0x003f
                                 .equ	SRAM_START	= 0x0060
                                 .equ	SRAM_SIZE	= 1024
                                 .equ	RAMEND	= 0x045f
                                 .equ	XRAMEND	= 0x0000
                                 .equ	E2END	= 0x01ff
                                 .equ	EEPROMEND	= 0x01ff
                                 .equ	EEADRBITS	= 9
                                 #pragma AVRPART MEMORY PROG_FLASH 8192
                                 #pragma AVRPART MEMORY EEPROM 512
                                 #pragma AVRPART MEMORY INT_SRAM SIZE 1024
                                 #pragma AVRPART MEMORY INT_SRAM START_ADDR 0x60
                                 
                                 
                                 
                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0xc00
                                 .equ	NRWW_STOP_ADDR	= 0xfff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0xbff
                                 .equ	PAGESIZE	= 32
                                 .equ	FIRSTBOOTSTART	= 0xf80
                                 .equ	SECONDBOOTSTART	= 0xf00
                                 .equ	THIRDBOOTSTART	= 0xe00
                                 .equ	FOURTHBOOTSTART	= 0xc00
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0001	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0002	; External Interrupt Request 1
                                 .equ	OC2addr	= 0x0003	; Timer/Counter2 Compare Match
                                 .equ	OVF2addr	= 0x0004	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0005	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0006	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0007	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x0008	; Timer/Counter1 Overflow
                                 .equ	OVF0addr	= 0x0009	; Timer/Counter0 Overflow
                                 .equ	SPIaddr	= 0x000a	; Serial Transfer Complete
                                 .equ	URXCaddr	= 0x000b	; USART, Rx Complete
                                 .equ	UDREaddr	= 0x000c	; USART Data Register Empty
                                 .equ	UTXCaddr	= 0x000d	; USART, Tx Complete
                                 .equ	ADCCaddr	= 0x000e	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x000f	; EEPROM Ready
                                 .equ	ACIaddr	= 0x0010	; Analog Comparator
                                 .equ	TWIaddr	= 0x0011	; 2-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0012	; Store Program Memory Ready
                                 
                                 .equ	INT_VECTORS_SIZE	= 19	; size in words
                                 
                                 #pragma AVRPART CORE INSTRUCTIONS_NOT_SUPPORTED break
                                 
                                 #endif  /* _M8DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; Step_03.asm
                                 ;
                                 ; Created: 20.02.2026 13:30:00
                                 ; Author : ar_user
                                 ;
                                 
                                 .include "m8def.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega8.xml *************
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m8def.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega8
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega8
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M8DEF_INC_
                                 #endif  /* _M8DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 .list
                                 .include "define.inc"	; Наши все определения переменных тут
                                 
                                  * define.inc
                                  */ 
                                 
                                 .equ F_CPU = 1000000
                                 
                                 ; SPI для 74HC595
                                 .equ SPI_PORT    = PORTB
                                 .equ SPI_DDR     = DDRB		; направление 1 -выход, 0 -вход
                                 .equ SPI_PIN     = PINB		; информация только читается
                                 .equ SCK         = PB5     ; CLOCK
                                 .equ MISO        = PB4     ; не используется
                                 .equ DATA        = PB3     ; DATA (SER)
                                 .equ LATCH       = PB2     ; LATCH (CS)
                                 .equ OE          = PB1     ; ШИМ для яркости (Output Enable, активный низкий)
                                 
                                 .equ BEEPER_PIN  = PB0	   ; Выход для бипера
                                 
                                 ; Кнопки на PD7-PD4 с внешней подтяжкой
                                 .equ BTN_PORT    = PORTD
                                 .equ BTN_DDR     = DDRD
                                 .equ BTN_PIN     = PIND
                                 .equ BTN_MASK    = 0xF0		; PD7-PD4
                                 .equ BTN1        = 7		;PD7 Минус
                                 .equ BTN2        = 6		;PD6 Плюс
                                 .equ BTN3        = 5		;PD5 Вход в настройку (Edit)
                                 .equ BTN4        = 4		;PD4 Режимы дисплея/ Запись времени
                                 
                                 .equ BEEP_LEN   = 5     ; Длительность работы БИППЕРА (3 * 10мс = 30мс)
                                 .def rBeepTimer = r9     ; Счетчик длительности звука (в младших регистрах)
                                 
                                 .equ T_SHORT	= 5        ; 50 мс : Дребезг 5 проходов по 10 мс
                                 .equ Sec_TimeOut     = 50	   ; 50 сек : Время для перехода в режим отображения по умолчанию
                                 
                                 .def rDebounce	 = r8     ; Счетчик антидребезга
                                 .def rBtn_now    = r20    ; Текущее чтение PIND
                                 .def rBtn_Index  = r21	  ; Индекс нажатой кнопки
                                 
                                 ; Кнопки через диоды (на INT1)
                                 .equ BTN_INT   = PD3     ; INT1
                                 
                                 ; DS3231 (на INT0)
                                 .equ DS3231_INT   = PD2     ; INT0
                                 
                                 ; I2C для DS3231
                                 .equ SDA          = PC4
                                 .equ SCL          = PC5
                                 
                                 ; Флаги
                                 .def rFlags = r23		  ; R23 регистр флагов
                                 .equ rFlag_int0   = 0	  ; Бит 0: Событие INT0 (от DS3231)
                                 .equ rFlag_dot  = 1		 ; Бит 1: Фаза мигания точки
                                 .equ rFlag_short  = 2     ; Бит 2: Короткое нажатие
                                 .equ rFlag_TimeOut = 3	  ; Бит 3: TimeOut режимов 
                                 .equ rFlag_beep   = 4     ; Бит 4: Активность бипера (1 - звучит)
                                 .equ rFlag_Reg10h   = 5     ; Бит 5: Выполнено чтение регистра 10H DS3231
                                 .equ rFlag_5sec   = 6     ; Бит 6: Пять секунд обнулены
                                 .equ rFlag_500   = 7     ; Бит 7: 500 мс
                                 
                                 
                                 ; Сегменты цифр 0b dp,g,f,e,d,c,b,a
                                 			
                                 .equ SEG_0 = 0b00111111
                                 .equ SEG_1 = 0b00000110
                                 .equ SEG_2 = 0b01011011
                                 .equ SEG_3 = 0b01001111
                                 .equ SEG_4 = 0b01100110
                                 .equ SEG_5 = 0b01101101
                                 .equ SEG_6 = 0b01111101
                                 .equ SEG_7 = 0b00000111
                                 .equ SEG_8 = 0b01111111
                                 .equ SEG_9 = 0b01101111
                                 .equ SEG_C = 0b00111001
                                 .equ SEG_E = 0b01111001
                                 .equ SEG_ho = 0b01100011
                                 .equ SEG_lo = 0b01011100
                                 .equ SEG_OFF  = 0b00000000
                                 
                                 
                                 ; =========== Сегмент данных ===========
                                 .dseg
                                 .org SRAM_START
                                 
                                 ; Режимы дисплея
000060                           display_mode: .byte 1
                                 .equ MODE_HM     = 0      ; Часы-минуты
                                 .equ MODE_MS     = 1      ; Минуты-секунды
                                 .equ MODE_DM     = 2      ; Число-месяц
                                 .equ MODE_DAY    = 3      ; День недели
                                 .equ MODE_YEAR   = 4      ; Год (2 последние цифры)
                                 
                                 
000061                           edit_mode:    .byte 1
                                 .equ edit_off		= 0      ; редактирование отключено
                                 .equ edit_sec		= 1      ; секунды
                                 .equ edit_min		= 2      ; минуты
                                 .equ edit_hours     = 3      ; часы
                                 .equ edit_weekday   = 4      ; день недели
                                 .equ edit_day		= 5      ; день месяца
                                 .equ edit_mouth		= 6      ; месяц
                                 .equ edit_year		= 7      ; год
                                 .equ edit_crystal	= 8      ; смещение старения кварцевого резонатора
                                 
                                 
                                 ; Буферы
000062                           display_buf:  .byte 4
                                 .equ display_1		= display_buf       ; байт первого индикатора
                                 .equ display_2		= display_buf+1     ; байт второго индикатора
                                 .equ display_3		= display_buf+2     ; байт третьего индикатора
                                 .equ display_4		= display_buf+3     ; байт четвертого индикатора
                                 
000066                           i2c_buffer:   .byte 7      ; Буфер для I2C (секунды, минуты, часы, день, дата, месяц, год)
                                 .equ i2c_sec		= i2c_buffer     ; байт секунд в формате BCD 
                                 .equ i2c_min		= i2c_buffer+1   ; байт минут в формате BCD
                                 .equ i2c_hours		= i2c_buffer+2   ; байт часов в формате BCD 
                                 .equ i2c_weekday	= i2c_buffer+3   ; байт дня недели в формате BCD 
                                 .equ i2c_day		= i2c_buffer+4   ; байт дня месяца в формате BCD 
                                 .equ i2c_month		= i2c_buffer+5   ; байт месяца в формате BCD 
                                 .equ i2c_year		= i2c_buffer+6   ; байт года в формате BCD 
                                 
00006d                           i2c_crystal: .byte 1    ; байт с регистра смещения старения кварцевого резонатора
                                 
00006e                           adc_date:	.byte 1    ; байт регистра ADCH ацп, информация о освещенности
                                 
00006f                           rBtn_Save:   .byte 1    ; состояние нажатой кнопки
                                 
000070                           timeout_cnt:  .byte 1    ; счетчик сброса режимов
                                 
000071                           sec5_auto:  .byte 1    ; счетчик 5 секунд
                                 
                                 .cseg
                                 ; =========== Векторы прерывания ===========
                                 .include "vectors.inc"
                                 
                                 			;.CSEG
                                 			.ORG 	0x0000			; Проц стартует с нуля, но дальше идут вектора 
000000 c02d                      			RJMP 	Reset			; прерываний, поэтому отсюда сразу же прыгаем на начало программы. На метку Reset
                                 			.ORG	INT0addr		; External Interrupt Request 0 = 0x0001
000001 c2b1                      			RJMP 	INT0_ISR		; Вектор INT0 (DS3231)
                                 			.ORG	INT1addr		; External Interrupt Request 1 = 0x0002
000002 c2b7                      			RJMP 	INT1_ISR		; Вектор INT1
                                 			.ORG	OC2addr			; Timer/Counter2 Compare Match = 0x0003
000003 9518                      			RETI	
                                 			.ORG	OVF2addr		; Timer/Counter2 Overflow	= 0x0004
000004 9518                      			RETI
                                 			.ORG	ICP1addr		; Timer/Counter1 Capture Event = 0x0005
000005 9518                      			RETI
                                 			.ORG	OC1Aaddr		; Timer/Counter1 Compare Match A = 0x0006
000006 9518                      			RETI
                                 			.ORG	OC1Baddr		; Timer/Counter1 Compare Match B = 0x0007
000007 9518                      			RETI
                                 			.ORG	OVF1addr		; Timer/Counter1 Overflow = 0x0008
000008 9518                      			RETI
                                 			.ORG	OVF0addr		; Timer/Counter0 Overflow = 0x0009
000009 c2c0                      			RJMP	TIMER0_ISR		; Jump to Timer0 overflow ISR
                                 			.ORG	SPIaddr			; Serial Transfer Complete = 0x000a
00000a 9518                      			RETI
                                 			.ORG	URXCaddr		; USART, Rx Complete = 0x000b
00000b 9518                      			RETI	
                                 			.ORG	UDREaddr		; USART Data Register Empty = 0x000c
00000c 9518                      			RETI
                                 			.ORG	UTXCaddr		; USART, Tx Complete = 0x000d
00000d 9518                      			RETI
                                 			.ORG	ADCCaddr		; ADC Conversion Complete = 0x000e
00000e 9518                      			RETI
                                 			.ORG	ERDYaddr		; EEPROM Ready = 0x000f
00000f 9518                      			RETI
                                 			.ORG	ACIaddr			; Analog Comparator = 0x0010
000010 9518                      			RETI
                                 			.ORG	TWIaddr			; 2-wire Serial Interface = 0x0011
000011 9518                      			RETI
                                 			.ORG	SPMRaddr		; Store Program Memory Ready = 0x0012
000012 9518                      			RETI
                                 
                                 .org 0x0020
                                 
                                 ; =========== Таблицы ===========
                                 SEG_TABLE:
000020 063f
000021 4f5b
000022 6d66
000023 077d
000024 6f7f                          .db SEG_0, SEG_1, SEG_2, SEG_3, SEG_4, SEG_5, SEG_6, SEG_7, SEG_8, SEG_9
                                 
                                 TABLDISP:
000025 c09e                      	rjmp SHOW_HM      ; Индекс 0
000026 c0a2                      	rjmp SHOW_MS      ; Индекс 1
000027 c0a7                      	rjmp SHOW_DM      ; Индекс 2
000028 c0a5                      	rjmp SHOW_DAY     ; Индекс 3
000029 c0aa                      	rjmp SHOW_YEAR    ; Индекс 4
                                 
                                 TABLSHORT:
00002a c30a                      	rjmp MINUS		    ; Индекс 0
00002b c2fd                      	rjmp PLUS	        ; Индекс 1
00002c c2f1                      	rjmp CHANGE_ED      ; Индекс 2
00002d c2d5                      	rjmp CHANGE_MO      ; Индекс 3
                                 
                                 Reset:
                                     ; Инициализация стека
00002e e004                          ldi r16, high(RAMEND)
00002f bf0e                          out SPH, r16
000030 e50f                          ldi r16, low(RAMEND)
000031 bf0d                          out SPL, r16
                                 
                                 	; Инициализация портов
000032 d023                          rcall INIT_PORTS
                                 
                                 	; Инициализация переменных
000033 d00e                      	rcall INIT_VARIABLES
                                 
                                 	; Инициализация прерываний
000034 d03a                      	rcall INIT_INTERRUPTS
                                 
                                 	; Инициализация DS3231
000035 d17b                      	rcall INIT_DS3231
                                 
                                 	; Инициализация SPI
000036 d264                      	rcall INIT_SPI
                                 	 
                                 	; Инициализация ШИМ
000037 d029                      	rcall INIT_PWM
                                 
                                 	; Инициализация АЦП
000038 d031                      	rcall INIT_ADC
                                 	
                                 	; Разрешение прерываний
000039 9478                      	sei
                                 
                                 
                                 
                                 MAIN_LOOP:
                                 	; 1. Работаю с флагом 500 мс
00003a 9982                      	sbic PIND, 2      ; Проверяем вход PD2 (INT0). Если там 0, пропускаем установку флага
00003b 6870                      	sbr rFlags, (1<<rFlag_500) ; устанавливаем флаг 500 мс
                                 		
                                 	; 2. Событие INT0 (RTC секунда прошла)
00003c fd70                          sbrc rFlags, rFlag_int0 ; Пропустить следующую команду если бит в регистре очищен
00003d d03f                      	rcall SELECT_DISP
                                 
                                 	; 3. Кнопки
00003e fd72                      	sbrc rFlags, rFlag_short ; Пропустить следующую команду если бит в регистре очищен
00003f d2ae                      	rcall Press_Short
                                 	
                                 SLEEP_ALL:	
                                 	; Режим сна
000040 9588                      	 sleep                 ; Перевести МК в режим энергосбережения
                                 
000041 cff8                      	rjmp MAIN_LOOP
                                 
                                 .include "initialization.asm"
                                 
                                  * initialization.asm
                                  *
                                  *  Created: 02.02.2026 16:11:17
                                  *   Author: ar_user
                                  */ 
                                  ; =========== Инициализация переменных ===========
                                 INIT_VARIABLES:
000042 2411                      	clr r1 ; R1: Всегда 0x00 (ускоряет очистку регистров и портов)
000043 2455                          clr r5	; Используем в прерывании INT0 для сохранения SREG
000044 2466                      	clr r6	; Используем в прерывании INT1 для сохранения SREG
000045 2477                      	clr r7	; Используем в прерывании TIMER0 OVF для сохранения SREG
000046 2488                      	clr r8	; Счетчик антидребезга
000047 2499                      	clr r9  ; Счетчик длительности звука (в младших регистрах)
000048 2755                      	clr r21	; Индекс нажатой кнопки
                                 	
                                 	; Флаги
000049 2777                           clr rflags ; регистр r23
                                 	     
                                     ; Режимы
00004a e000                      	ldi r16,0
00004b 9300 0061                 	sts edit_mode, r16
                                 
00004d e000                      	ldi r16,0
00004e 9300 0060                 	sts display_mode, r16
                                 	
                                 
                                 	;ldi r16,0x9A ; на индикаторе - 102
                                 	;ldi r16,0x74
000050 2700                      	clr r16
000051 9300 006d                 	sts i2c_crystal, r16
000053 9300 0071                 	sts sec5_auto, r16
                                 
000055 9508                      	ret
                                 
                                 ; =========== Инициализация портов ===========
                                 INIT_PORTS:
                                     
                                 	; SPI порты (MOSI, SCK, SS, OE, MR как выходы) и BEEPER_PIN
000056 ea0f                          ldi r16, (1<<DATA)|(1<<SCK)|(1<<LATCH)|(1<<OE)|(1<<BEEPER_PIN)|(1<<PB7)
000057 bb07                          out SPI_DDR, r16
                                     
                                    /* ; OE (яркость) - низкий уровень по умолчанию (максимальная яркость)
                                     cbi SPI_PORT, OE*/
                                 
                                 	; OE (ШИМ) - низкий уровень по умолчанию (максимальная яркость)    
                                 	    
                                     ; Порт для DS3231 (INT0)
000058 988a                          cbi DDRD, DS3231_INT      ; Вход
000059 9a92                          sbi PORTD, DS3231_INT     ; Подтяжка
                                     
                                     ; Порты для I2C
00005a 98a4                          cbi DDRC, SDA             ; SDA - вход
00005b 98a5                          cbi DDRC, SCL             ; SCL - вход
00005c 9aac                          sbi PORTC, SDA            ; Подтяжка
00005d 9aad                          sbi PORTC, SCL            ; Подтяжка
                                 
                                 	; Порты подключенных кнопок как входы и PD3 для INT1, без подтяжки (внешние резисторы на 5в)
00005e e000                          ldi r16, (0<<BTN1)|(0<<BTN2)|(0<<BTN3)|(0<<BTN4)|(0<<BTN_INT); BTN1 это PD7, BTN2 это PD6, BTN3 это PD5, BTN4 это PD4, BTN_INT это PD3
00005f bb01                          out BTN_DDR, r16
                                     
000060 9508                          ret
                                 
                                 ; =========== Инициализация ШИМ ===========
                                 INIT_PWM:
                                 	; Настройка TCCR1A:
                                     ; COM1A1=1, COM1A0=0 -> Clear OC1A on Compare Match (неинвертированный ШИМ)
                                     ; WGM10=1, WGM11=0 -> Режим Fast PWM, 8-bit
000061 e801                          ldi r16, (1 << COM1A1) | (1 << WGM10)
000062 bd0f                          out TCCR1A, r16
                                 
                                     ; Настройка TCCR1B:
                                     ; WGM12=1 -> Дополнение для Fast PWM, 8-bit
                                     ; CS10=1  -> Предделитель = 1, частота 1МГц/256 = 3906 Гц (запуск таймера)
000063 e009                          ldi r16, (1 << WGM12) | (1 << CS10)
000064 bd0e                          out TCCR1B, r16
                                 
                                 
                                 	; Установка начальной яркости (0 - макс, 255 - мин, т.к. OE инверсный)
                                 	;Для записи 16-битного значения старший байт должен быть записан перед младшим.
                                 	;Для чтения 16-битного значения младший байт должен быть прочитан перед старшим.
                                     ;ldi r16, 128 ; 50% яркости
000065 2700                      	clr r16
000066 bd0b                          out OCR1AH, r16 ; Старший байт в 8-битном режиме всегда 0
000067 ec08                      	ldi r16, 200
000068 bd0a                          out OCR1AL, r16
                                     
000069 9508                          ret
                                 
                                 ; =========== Инициализация АЦП ===========
                                 INIT_ADC:
                                 	; REFS0=1 (Опорное напряжение AVCC)
                                     ; ADLAR=1 (Левое выравнивание результата - читаем только ADCH)
                                     ; MUX3..0=0 (Канал ADC0 / PC0)
00006a e600                          ldi r16, (1 << REFS0) | (1 << ADLAR)
00006b b907                          out ADMUX, r16
                                 
                                     ; ADEN=1 (Вкл АЦП), ADPS1..0=1 (Делитель 8 для точности на 1МГц)
00006c e803                          ldi r16, (1 << ADEN) | (1 << ADPS1) | (1 << ADPS0)
00006d b906                          out ADCSRA, r16
                                 	
00006e 9508                      	ret  
                                 
                                 ; =========== Инициализация прерываний ===========
                                 INIT_INTERRUPTS:
                                 	/*ISC01 ISC00 Описание
                                 	0 		0 Низкий уровень INT0 генерирует запрос прерывания.
                                 	0 		1 Любое логическое изменение на INT0 генерирует запрос прерывания.
                                 	1 		0 Спадающий фронт INT0 генерирует запрос прерывания.
                                 	1 		1 Восходящий фронт INT0 генерирует запрос прерывания.*/
                                     ; INT0 - От DS3231 восходящий фронт генерирует запрос прерывания
00006f e002                          ldi r16, (1<<ISC01)|(0<<ISC00)
000070 bf05                          out MCUCR, r16
000071 e400                          ldi r16, (1<<INT0)
000072 bf0b                          out GICR, r16
                                 
                                 	; INT1 - прерывание от кнопок по нажатию 
                                     ; (нажатие = 1->0 на INT1, отпускание = 0->1)
000073 b705                         in r16, MCUCR
                                     ;ldi r16, (1<<ISC11)|(0<<ISC10)  ; нажатие = 1->0 по спаду (Falling Edge)
000074 6008                      	ori r16, (1<<ISC11)|(0<<ISC10)  ; нажатие = 1->0 по спаду (Falling Edge) добавляем два бита
000075 bf05                          out MCUCR, r16
                                 	; ВКЛЮЧИТЬ INT1 (установить бит INT1, сохранив INT0)
000076 b70b                      	in  r16, GICR        ; Читаем текущее состояние
000077 6800                      	ori r16, (1<<INT1)   ; Устанавливаем только бит INT1 (Разрешение INT1)
000078 bf0b                      	out GICR, r16        ; Записываем обратно, включаем INT1
                                 
                                 	; Разрешаем прерывание по переполнению Таймера 0
000079 b709                          in r16, TIMSK
00007a 6001                          ori r16, (1 << TOIE0)
00007b bf09                          out TIMSK, r16
                                     
00007c 9508                      
                                 SELECT_DISP:
00007d fd73                      	sbrc rFlags, rFlag_TimeOut ; Пропустить следующую команду если бит в регистре очищен
00007e d00b                      	rcall TimeOut
00007f d028                      	rcall BTN_NEW
000080 7f7e                      	cbr rFlags, (1<<rFlag_int0) ; сброс флага
000081 d019                      	rcall Update_ADC ; запуск АЦП
                                 	;проверка на режим редактирования
000082 9120 0061                 	lds r18, edit_mode
000084 2322                          tst r18
000085 f011                          breq DiWo       ; Переход если равно т.е.если 0 — работаем как обычно
000086 d0ac                      	rcall DISPLAY_EDIT	;переход в показ режима редактирования
000087 c001                      	rjmp OUT_SeDi
                                 DiWo:
000088 d04f                      	rcall DISPLAY_WORK ;переход в показ времени
                                 OUT_SeDi:
000089 9508                      	ret
                                 
                                 TimeOut:
00008a 930f                      	push r16
00008b 932f                      	push r18
                                 	; --- Логика таймаута ---
00008c 9120 0070                     lds r18, timeout_cnt
00008e 952a                          dec r18             ; Уменьшаем каждую секунду
00008f 9320 0070                     sts timeout_cnt, r18
000091 f431                          brne Out_TO  ; Если еще не ноль, продолжаем (Проверяется флаг нулевого значения (Z) регистра статуса, сдесь реагирует на dec r19)
                                 
000092 2700                          clr r16             ; Если ноль — сброс режима
000093 7f77                      	cbr rFlags, (1<<rFlag_TimeOut) ; сброс флага
000094 9300 0061                     sts edit_mode, r16	
000096 9300 0060                 	sts display_mode, r16
                                 
                                 Out_TO:
000098 912f                      	pop r18
000099 910f                      	pop r16
00009a 9508                       ret
                                 
                                 Update_ADC:
00009b 930f                      	push r16
00009c 931f                      	push r17
                                 
00009d 9a36                      	sbi ADCSRA, ADSC    ; Запуск АЦП
                                 wait_adc:
00009e 9936                          sbic ADCSRA, ADSC   ; Ждем окончания
00009f cffe                          rjmp wait_adc
                                 
0000a0 b105                          in r16, ADCH        ; Получаем освещенность (0-255)
                                 
0000a1 ef1f                      	ldi r17, 255
0000a2 1b10                          sub r17, r16        ; Инвертируем: яркость = 255 - освещенность
0000a3 9310 006e                 	sts adc_date, r17
                                 
0000a5 911f                      	pop r17
0000a6 910f                      	pop r16
0000a7 9508                      ret
                                 
                                 BTN_NEW:
0000a8 930f                      	push r16
0000a9 9987                      	SBIC PIND,BTN1 ; Пропустить если бит в регистре ввода/вывода очищен Проверяю нажатую кнопку МИНУС (нажата - логический ноль)
0000aa c00a                      	rjmp OUT_BN1
0000ab 7b7f                      	cbr rFlags, (1<<rFlag_5sec) ; сброс флага
0000ac 9100 0071                 	Lds   r16, sec5_auto
0000ae 9503                      	inc r16
0000af 3005                      	cpi r16,5 ; вот проверка 5 сек на включение какой либо задачи
0000b0 f019                      	BREQ START_PR ; Переход если равно
0000b1 9300 0071                 	sts sec5_auto, r16
0000b3 c007                      	rjmp OUT_BN
                                 START_PR:
0000b4 d008                      	rcall TEST_A ; Вот запуск проги
                                 OUT_BN1:
0000b5 fd76                      	sbrc rFlags, rFlag_5sec ; Пропустить следующую команду если бит в регистре очищен
0000b6 c004                      	rjmp OUT_BN
0000b7 2700                      	clr r16
0000b8 9300 0071                 	sts   sec5_auto, r16
                                 	; Добавил флаг обнуления 5 сек для того чтобы не выполнять каждую секунду две предыдущих команды
0000ba 6470                      	sbr rFlags, (1<<rFlag_5sec) ; устанавливаем флаг	
                                 OUT_BN:
0000bb 910f                      	pop r16
0000bc 9508                      	ret
                                 
                                  TEST_A:
0000bd 930f                      	push r16
0000be b308                      	in  r16, PORTB
0000bf e810                      	ldi r17,(1<<PB7)
0000c0 2701                      	eor r16, r17  ; Исключающее ИЛИ: если был 0 — станет 1, если 1 — станет 0
0000c1 bb08                      	out PORTB,r16
                                 out_te:
0000c2 910f                      	pop r16
0000c3 9508                      	ret	
                                 
                                 
                                 .include "displaywork.asm"
                                 
                                  * displayrtc.asm
                                  *
                                  *  Created: 02.02.2026 16:20:48
                                  *   Author: ar_user
                                  */ 
                                  ; --- Обработчики табличных переходов ---
                                 SHOW_HM:
0000c4 9100 0068                     lds  r16, i2c_hours
0000c6 9110 0067                     lds  r17, i2c_min
0000c8 c023                          rjmp Buffer_disp
                                 
                                 SHOW_MS:
0000c9 9100 0067                     lds  r16, i2c_min
0000cb 9110 0066                     lds  r17, i2c_sec
0000cd c01e                          rjmp Buffer_disp
                                 
                                 SHOW_DAY:
                                 	;ldi  r16, 0x00
                                     ;lds  r17, i2c_weekday
0000ce c01d                          rjmp Buffer_disp
                                 
                                 SHOW_DM:
0000cf 9100 006a                 	lds  r16, i2c_day
0000d1 9110 006b                     lds  r17, i2c_month
0000d3 c018                          rjmp Buffer_disp
                                 
                                 SHOW_YEAR:
0000d4 e200                      	ldi  r16, 0x20
0000d5 9110 006c                     lds  r17, i2c_year
0000d7 c014                          rjmp Buffer_disp
                                 
                                 
                                 DISPLAY_WORK:
0000d8 930f                      	push r16
0000d9 931f                      	push r17
0000da 932f                      	push r18
0000db 93ef                      	push r30
0000dc 93ff                      	push r31
                                 
                                 NORMAL_VIEW:
0000dd d0de                      	rcall RTC_ADAPTIVE
0000de 9100 0060                 	lds r16, display_mode
0000e0 3005                      	cpi R16, 5          ; Проверяем, что индекс меньше 5
0000e1 f430                          brsh Error1     ; Если R16 >= 5, уходим на обработку ошибки
                                 
                                     ; Используем табличный переход
                                 	; Загружаем базовый адрес таблицы
0000e2 e2e5                          ldi  ZL, low(TABLDISP) 
0000e3 e0f0                          ldi  ZH, high(TABLDISP)
                                     ; Прибавляем индекс к адресу (Z = Z + r16)
0000e4 0fe0                          add  ZL, r16
0000e5 2711                          clr  r17
0000e6 1ff1                          adc  ZH, r17              ; Учитываем перенос
                                 
0000e7 9409                          ijmp                      ; ПРЫЖОК в обработчики табличных переходов по адресу в Z 
                                 
                                 Error1:
0000e8 2700                      	clr r16					; обнуляем "мусор" переводим на режим по дефолту
0000e9 9300 0060                 	sts display_mode, r16
0000eb cff1                      	rjmp NORMAL_VIEW
                                 	
                                 		
                                 Buffer_disp:
                                 		
                                 	; Переход для формирования дня недели
0000ec 9120 0060                     lds r18, display_mode
0000ee 3023                      	cpi r18, MODE_DAY
0000ef f109                      	BREQ MD3
                                 	
                                 			    
                                     ; Формируем 4 цифры:
                                     ; Индикатор 1 (левый): десятки часов
0000f0 2f20                      	mov r18, r16
0000f1 9522                          swap r18
0000f2 702f                          andi r18, 0x0F        ; Десятки часов (0-2)
0000f3 d1b2                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
0000f4 9320 0062                 	sts display_1, r18     ;  Сохраняем в буфер для левого (первого) индикатора
                                 	    
                                     ; Индикатор 2: единицы часов + точка
0000f6 2f20                          mov r18, r16
0000f7 702f                          andi r18, 0x0F        ; Единицы часов (0-9)
0000f8 d1ad                          rcall DIGIT_TO_SEGMENT ; преобразуем цифру в код сегментов
                                 
                                     ; Добавляем мигающую точку (между часами и минутами) работает только в режиме НМ
0000f9 9100 0060                 	lds r16, display_mode
0000fb 3000                      	cpi R16, MODE_HM
0000fc f431                      	brne OUT_DI2 ; Перейти если не равно
                                 	;SBRS rFlags, rFlag_dot ; проверяет состояние одного бита в регистре и пропускает следующую команду если этот бит установлен
0000fd fd71                      	SBRC rFlags, rFlag_dot ; проверяет состояние одного бита в регистре и пропускает следующую команду если этот бит очищен
0000fe c003                      	rjmp OUT_DI1
0000ff 6820                      	ori r18, (1<<7) ; устанавливаем 7 бит (это точка на 2-ом индикаторе) без изменения остальных
000100 6072                      	sbr rFlags, (1<<rFlag_dot)
000101 c001                      	rjmp OUT_DI2
                                 OUT_DI1:
000102 7f7d                      	cbr rFlags, (1<<rFlag_dot)
                                 OUT_DI2:
000103 9320 0063                 	sts display_2, r18     ; Сохраняем в буфер для второго индикатора
                                 
                                 
                                     ; Индикатор 3: Десятки минут
000105 2f21                          mov r18, r17
000106 9522                          swap r18
000107 702f                          andi r18, 0x0F        ; Десятки минут (0-5)
000108 d19d                          rcall DIGIT_TO_SEGMENT
000109 9320 0064                     sts display_3, r18     ; третий индикатор
                                     
                                     ; 4. Единицы минут
00010b 2f21                          mov r18, r17
00010c 702f                          andi r18, 0x0F        ; Единицы минут (0-9)
00010d d198                          rcall DIGIT_TO_SEGMENT
00010e 9320 0065                     sts display_4, r18     ; четвертый индикатор
                                 	
000110 c00e                      	rjmp UPDATE_DISPLAY
                                 
                                 MD3:; формирование дня недели
000111 e400                      	ldi r16, 0b01000000
000112 9300 0062                 	sts display_1, r16
000114 9300 0063                 	sts display_2, r16
000116 9300 0065                 	sts display_4, r16	 ; четвертый индикатор
000118 9110 0069                 	lds  r17, i2c_weekday
00011a 2f21                      	mov r18, r17
00011b 702f                          andi r18, 0x0F        ; дни (1-7)
00011c d189                          rcall DIGIT_TO_SEGMENT
00011d 9320 0064                     sts display_3, r18   ; третий индикатор  
                                 	
                                 	
                                 UPDATE_DISPLAY:	 
                                 	    
                                     ; ВАЖНО: передаем данные в обратном порядке!
                                     ; Первым выводим правый разряд (последний в цепочке 74HC595)
                                     
00011f 9100 0065                 	lds r16,display_4
000121 d17f                      	rcall spi_send
000122 9100 0064                 	lds r16,display_3
000124 d17c                      	rcall spi_send
000125 9100 0063                 	lds r16,display_2
000127 d179                      	rcall spi_send
000128 9100 0062                 	lds r16,display_1
00012a d176                      	rcall spi_send
                                 
                                 	    
                                     ; Защелкиваем данные (импульс на SS/CS)
00012b 9ac2                      	sbi SPI_PORT, LATCH
                                 	;nop
00012c 98c2                      	cbi SPI_PORT, LATCH 
                                 
                                 	;rcall TEST_A
                                 
00012d 91ff                      	pop r31
00012e 91ef                      	pop r30
00012f 912f                      	pop r18
000130 911f                      	pop r17
000131 910f                      	pop r16
                                 
000132 9508                          ret
                                 	
                                 
                                 
                                 .include "displayedit.asm"
                                 
                                  * displayedit.asm
                                  *
                                  *  Created: 04.02.2026 13:29:19
                                  *   Author: ar_user
                                  */ 
                                 
                                 
                                  DISPLAY_EDIT:
000133 930f                      	push r16
000134 931f                      	push r17
000135 932f                      	push r18
000136 93ef                      	push r30
000137 93ff                      	push r31
                                 
000138 9100 0061                 	lds r16, edit_mode
                                 	;cpi R16, 8          ; Проверяем, что индекс меньше 8
00013a 3009                      	cpi R16, 9          ; Проверяем, что индекс меньше 9
00013b f438                          brsh Error2     ; Если R16 >= 8, уходим на обработку ошибки
00013c 3008                      	cpi R16, 8		; Проверяем, что индекс равен 8
00013d f139                      	breq Cryst		;Перейти если равно
00013e 2f20                      	mov r18,r16
00013f d166                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
000140 9320 0062                 	sts display_1, r18     ;  Сохраняем в буфер для левого (первого) индикатора
000142 c004                      	rjmp DE1
                                 Error2:
000143 2722                      	clr r18					; обнуляем "мусор" переводим на режим по дефолту
000144 9320 0061                 	sts edit_mode, r18
000146 c02e                      	rjmp OUT_UD2
                                 DE1:
000147 d013                      	rcall Disp_2 ; анимация 2-ого идикатора
                                 	
                                 
                                 	;Находим нужный байт времени
000148 e6a6                      	ldi  XL, low(i2c_buffer)
000149 e0b0                          ldi  XH, high(i2c_buffer)
00014a 950a                          dec  r16                ;делаю декримент для правильной работы мне надо чтобы индекс edit_mode начинался с нуля Делаем из 1..7 -> 0..6
00014b 0fa0                          add  XL, r16
00014c 2700                          clr  r16
00014d 1fb0                          adc  XH, r16
                                 
00014e 911c                          ld   r17, X             ; Загружаем в r17 значение нужного байта по адресу Х
                                 
00014f 2f21                      	mov r18, r17
000150 9522                          swap r18
000151 702f                          andi r18, 0x0F        ; Десятки
000152 d153                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
000153 9320 0064                 	sts display_3, r18     ;  Сохраняем в буфер для третьего индикатора
                                 	    
                                     ; Индикатор 4: единицы
000155 2f21                          mov r18, r17
000156 702f                          andi r18, 0x0F        ; Единицы
000157 d14e                          rcall DIGIT_TO_SEGMENT ; преобразуем цифру в код сегментов
000158 9320 0065                 	sts display_4, r18
                                 
00015a c00b                      	rjmp UPDATE_DISPLAY_2
                                 
                                 
                                 ; анимация 2-ого идикатора
                                 disp_2:
                                 
00015b fd71                      	sbrc rflags, rflag_dot ; проверяет состояние одного бита в регистре и пропускает следующую команду если этот бит очищен
00015c c003                      	rjmp holo
00015d e52c                      	ldi  r18,seg_lo
00015e 6072                      	sbr rFlags, (1<<rFlag_dot)
00015f c002                      	rjmp loho
                                 holo:
000160 e623                      	ldi  r18,seg_ho
000161 7f7d                      	cbr rFlags, (1<<rFlag_dot)
                                 loho:	
000162 9320 0063                 	sts display_2, r18
                                 	/*ldi r18,0b01001001
                                 	sts display_2, r18*/
000164 9508                      	ret
                                 
                                 Cryst:
000165 d015                      	rcall Crystall
                                 	
                                 
                                 
                                 	/*rjmp UPDATE_DISPLAY_2
                                 ret*/
                                 
                                 UPDATE_DISPLAY_2:	 
                                 	    
000166 9100 0065                 	lds r16,display_4
000168 d138                      	rcall spi_send
000169 9100 0064                 	lds r16,display_3
00016b d135                      	rcall spi_send
00016c 9100 0063                 	lds r16,display_2
00016e d132                      	rcall spi_send
00016f 9100 0062                 	lds r16,display_1
000171 d12f                      	rcall spi_send
                                 
                                 	    
                                     ; Защелкиваем данные (импульс на SS/CS)
000172 9ac2                      	sbi SPI_PORT, LATCH
000173 0000                      	nop
000174 98c2                      	cbi SPI_PORT, LATCH 
                                 OUT_UD2:
000175 91ff                      	pop r31
000176 91ef                      	pop r30
000177 912f                      	pop r18
000178 911f                      	pop r17
000179 910f                      	pop r16
00017a 9508                      ret
                                 
                                 Crystall:
00017b 930f                      	push r16
00017c 931f                      	push r17
00017d 932f                      	push r18
00017e 933f                      	push r19
00017f 934f                      	push r20
000180 ff75                      	sbrs rFlags, rFlag_Reg10h ; Пропустить следующую команду если бит в регистре в 1
000181 d083                      	rcall READ_REGISTER_10H
000182 9100 006d                 	lds r16, i2c_crystal
                                 	; Преобразование знакового байта в модуль и разряды
                                 	; Вход: r16 = исходное значение
                                 	; Выход: r17 = 0 если положительное, 1 если отрицательное
                                 	; r18 = сотни (0-1), r19 = десятки (0-9), r20 = единицы (0-9)
000184 2711                      	clr   r17               ; предполагаем положительное
                                 	; Проверяем знак
000185 ff07                          sbrs  r16, 7            ; пропустить, если бит 7 сброшен (положительное)
000186 c003                          rjmp  conv_pos
                                     ; Отрицательное: преобразуем в положительное (инвертировать +1)
000187 9500                          com   r16                ; инвертируем все биты
000188 9503                          inc   r16                ; +1
000189 e011                          ldi   r17, 1             ; признак отрицательного
                                 conv_pos:
                                 	; Теперь в r16 модуль числа (0..127)
                                     ; Разбиваем на сотни, десятки, единицы
                                     ; Для 0..127: сотни = 0 или 1
00018a e020                          ldi   r18, 0
00018b e030                          ldi   r19, 0
00018c e040                          ldi   r20, 0
                                 
                                 	; Вычитаем сотни (100)
00018d 3604                          cpi   r16, 100
00018e f010                          brlo  conv_no100
00018f 5604                          subi  r16, 100
000190 e021                          ldi   r18, 1	;сотни
                                 conv_no100:
                                 	; Теперь десятки (0..9)
000191 e050                          ldi   r21, 0            ; счётчик десятков
                                 conv_dec_loop:
000192 300a                          cpi   r16, 10
000193 f018                          brlo  conv_dec_done
000194 500a                          subi  r16, 10
000195 9553                          inc   r21
000196 cffb                          rjmp  conv_dec_loop
                                 conv_dec_done:
000197 2f35                      	mov   r19, r21		;десятки
000198 2f40                          mov   r20, r16          ; остаток = единицы
                                 
000199 d10c                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
                                 	;ori r18, (1<<7) ; устанавливаем 7 бит (это точка) без изменения остальных
00019a 9320 0063                 	sts display_2, r18
00019c 2f23                      	mov r18,r19
00019d d108                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
                                 	;ori r18, (1<<7) ; устанавливаем 7 бит (это точка) без изменения остальных
00019e 9320 0064                 	sts display_3, r18
0001a0 2f24                      	mov r18,r20
0001a1 d104                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
                                 	;ori r18, (1<<7) ; устанавливаем 7 бит (это точка) без изменения остальных
0001a2 9320 0065                 	sts display_4, r18
                                 
0001a4 3011                      	cpi   r17, 1
0001a5 f011                      	breq negativ		;переход если равно, подставляем знак минус
0001a6 e010                      	ldi r17, SEG_OFF
0001a7 c001                      	rjmp DISP_1
                                 NEGATIV:
0001a8 e410                      	ldi r17, 0b01000000 ; Знак минус
                                 DISP_1:
0001a9 9310 0062                 	sts display_1, r17
                                 
0001ab 914f                      	pop r20
0001ac 913f                      	pop r19
0001ad 912f                      	pop r18
0001ae 911f                      	pop r17
0001af 910f                      	pop r16
                                 .include "i2c.asm"	
0001b0 9508                      
                                  * i2c.asm
                                 */ 
                                 ; =========== Инициализация DS3231 ===========
                                 INIT_DS3231:
0001b1 d0d1                          rcall I2C_INIT
                                     
0001b2 d0d5                          rcall I2C_START
0001b3 ed00                          ldi r16, 0xD0		;адрес DS3231
0001b4 d0d9                          rcall I2C_WRITE
                                     
0001b5 e00e                          ldi r16, 0x0E		; адресс Control Register (0Eh) DS3231 
0001b6 d0d7                          rcall I2C_WRITE
                                     
0001b7 e000                          ldi r16, 0x00		; запись в Control Register (0Eh) DS3231 Установка SQW на 1 Гц
0001b8 d0d5                          rcall I2C_WRITE
                                     
0001b9 d0de                          rcall I2C_STOP
                                 
0001ba d022                      	rcall READ_DATETIME_FULL
                                 	;rcall READ_DATETIME
                                 
0001bb 9508                          ret
                                 
                                 ; Подстраиваем глубину опроса времени.
                                 ; В режимах показа часов-минут, минут-секунд читаем только первые 3 байта (Сек, Мин, Час)
                                 ; В режимах день недели, день-месяц, год читаем 7 байт
                                 RTC_ADAPTIVE:
0001bc 9100 0060                 	lds r16, display_mode
0001be 3002                          cpi r16, MODE_DM          ; Если режим Дата, День или Год
0001bf f410                          brsh READ_FULL            ; Переход если больше или равно (Читаем все 7 байт)
                                 
                                     ; Иначе (HM или MS) — читаем только первые 3 байта (Сек, Мин, Час)
                                     ;ldi r17, 3
0001c0 d003                          rcall READ_DATETIME
0001c1 c001                          rjmp OUT_RTC
                                 
                                 READ_FULL:
                                     ;ldi r17, 7
0001c2 d01a                          rcall READ_DATETIME_FULL
                                 OUT_RTC:
0001c3 9508                      	ret
                                 
                                 ;============== Чтение времени из DS3231 ==================================
                                 
                                 READ_DATETIME:
0001c4 930f                          push r16
0001c5 7f7e                      	 cbr rFlags, (1<<rFlag_int0)       
                                     ;rcall I2C_INIT
                                     
0001c6 d0c1                          rcall I2C_START
                                     ; Адрес DS3231 для записи
0001c7 ed00                          ldi r16, 0xD0
0001c8 d0c5                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x00 (секунды)
0001c9 e000                          ldi r16, 0x00
0001ca d0c3                          rcall I2C_WRITE
                                     
0001cb d0bc                      	rcall I2C_START
                                     ; Повторный START для чтения
0001cc ed01                          ldi r16, 0xD1
0001cd d0c0                          rcall I2C_WRITE
                                 		
0001ce d0c3                      	rcall I2C_READ_ACK
0001cf b103                      	in r16, TWDR
0001d0 9300 0066                 	sts i2c_sec,r16
                                 	
0001d2 d0bf                      	rcall I2C_READ_ACK
0001d3 b103                      	in r16, TWDR
0001d4 9300 0067                 	sts i2c_min,r16
                                 	
0001d6 d0be                      	rcall I2C_READ_NACK
0001d7 b103                      	in r16, TWDR
0001d8 9300 0068                 	sts i2c_hours,r16
                                 		
0001da d0bd                      	rcall I2C_STOP
                                 	
0001db 910f                      	pop r16
0001dc 9508                         ret
                                 
                                 ;============== Чтение времени из DS3231 ==================================
                                 
                                 READ_DATETIME_FULL:
0001dd 930f                          push r16
                                 	        
                                         
0001de d0a9                          rcall I2C_START
                                     ; Адрес DS3231 для записи
0001df ed00                          ldi r16, 0xD0
0001e0 d0ad                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x00 (секунды)
0001e1 e000                          ldi r16, 0x00
0001e2 d0ab                          rcall I2C_WRITE
                                     
0001e3 d0a4                      	rcall I2C_START
                                     ; Повторный START для чтения
0001e4 ed01                          ldi r16, 0xD1
0001e5 d0a8                          rcall I2C_WRITE
                                 		
0001e6 d0ab                      	rcall I2C_READ_ACK
0001e7 b103                      	in r16, TWDR
0001e8 9300 0066                 	sts i2c_sec,r16
                                 	
0001ea d0a7                      	rcall I2C_READ_ACK
0001eb b103                      	in r16, TWDR
0001ec 9300 0067                 	sts i2c_min,r16
                                 
0001ee d0a3                      	rcall I2C_READ_ACK
0001ef b103                      	in r16, TWDR
0001f0 9300 0068                 	sts i2c_hours,r16
                                 
0001f2 d09f                      	rcall I2C_READ_ACK
0001f3 b103                      	in r16, TWDR
0001f4 9300 0069                 	sts i2c_weekday,r16
                                 
0001f6 d09b                      	rcall I2C_READ_ACK
0001f7 b103                      	in r16, TWDR
0001f8 9300 006a                 	sts i2c_day,r16
                                 
0001fa d097                      	rcall I2C_READ_ACK
0001fb b103                      	in r16, TWDR
0001fc 9300 006b                 	sts i2c_month,r16
                                 	
0001fe d096                      	rcall I2C_READ_NACK
0001ff b103                      	in r16, TWDR
000200 9300 006c                 	sts i2c_year,r16
                                 		
000202 d095                      	rcall I2C_STOP
                                 	
000203 910f                      	pop r16
000204 9508                         ret
                                 
                                  ;=========== Чтение регистра смещения старения кварцевого резонатора ===========
                                  READ_REGISTER_10H:
000205 930f                      	push r16
                                 	  
                                     ;rcall I2C_INIT
                                     
000206 d081                          rcall I2C_START
                                     ; Адрес DS3231 для записи
000207 ed00                          ldi r16, 0xD0
000208 d085                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x10 (Crystal Aging Offset (10h))
000209 e100                          ldi r16, 0x10
00020a d083                          rcall I2C_WRITE
                                     
00020b d07c                      	rcall I2C_START
                                     ; Повторный START для чтения
00020c ed01                          ldi r16, 0xD1
00020d d080                          rcall I2C_WRITE
                                 		
00020e d086                      	rcall I2C_READ_NACK
00020f b103                      	in r16, TWDR
000210 9300 006d                 	sts i2c_crystal,r16
                                 		
000212 d085                      	rcall I2C_STOP
                                 
000213 6270                      	sbr rFlags, (1<<rFlag_Reg10h) ; устанавливаем флаг
                                 
000214 910f                      	pop r16
000215 9508                         ret
                                 
                                  ;=========== Запись в регистр смещения старения кварцевого резонатора ===========
                                  WRITE_REGISTER_10H:
000216 930f                      	push r16
                                 	  
                                     ;rcall I2C_INIT
                                     
000217 d070                          rcall I2C_START
                                     ; Адрес DS3231 для записи
000218 ed00                          ldi r16, 0xD0
000219 d074                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x10 (Crystal Aging Offset (10h))
00021a e100                          ldi r16, 0x10
00021b d072                          rcall I2C_WRITE
                                     
00021c 9100 006d                 	lds r16, i2c_crystal ; наше новое значение
00021e d06f                          rcall I2C_WRITE
                                 		
00021f d078                      	rcall I2C_STOP
                                 	
                                 	; Теперь запускаем принудительное преобразование температуры и тем самым применения изменений в регистре 10H
                                     ; (если не хотим ждать 64 секунды)
000220 d067                          rcall I2C_START
000221 ed00                          ldi   r16, 0xD0
000222 d06b                          rcall I2C_WRITE
000223 e00e                          ldi   r16, 0x0E          ; регистр управления
000224 d069                          rcall I2C_WRITE
                                     ; Читаем текущее значение регистра управления (опционально)
000225 d062                          rcall I2C_START
000226 ed01                          ldi   r16, 0xD1
000227 d066                          rcall I2C_WRITE
000228 d06c                          rcall I2C_READ_NACK      ; прочитали байт, он в TWDR
                                     ; Устанавливаем бит CONV (бит 5)
000229 b103                          in    r16, TWDR
00022a 6200                          sbr   r16, (1<<5)        ; установить бит 5
00022b 930f                          push  r16	; в стек
                                     ; Записать обратно
00022c d05b                          rcall I2C_START
00022d ed00                          ldi   r16, 0xD0
00022e d05f                          rcall I2C_WRITE
00022f e00e                          ldi   r16, 0x0E
000230 d05d                          rcall I2C_WRITE
000231 910f                          pop   r16	;из стека
000232 d05b                          rcall I2C_WRITE
000233 d064                          rcall I2C_STOP
                                 	; бит CONV (бит 5) Обнулится после преобразования
000234 910f                      	pop r16
000235 9508                         ret
                                 ; =========== Запись времени в DS3231 ===========
                                 WRITE_DATETIME:
000236 930f                          push r16
                                     
                                     ;rcall I2C_INIT
                                     
000237 d050                      	rcall I2C_START
000238 ed00                          ldi r16, 0xD0
000239 d054                          rcall I2C_WRITE
                                     
00023a e000                          ldi r16, 0x00
00023b d052                          rcall I2C_WRITE
                                     
00023c 9100 0066                     lds r16, i2c_sec
00023e d04f                          rcall I2C_WRITE
                                     
00023f 9100 0067                     lds r16, i2c_min
000241 d04c                          rcall I2C_WRITE
                                     
000242 9100 0068                     lds r16, i2c_hours
000244 d049                          rcall I2C_WRITE
                                     
000245 d052                          rcall I2C_STOP
                                 
000246 910f                          pop r16
000247 9508                          ret
                                 
                                 ;============== Запись определенных параметров времени в DS3231 ====================
                                 	WRITE_SPECIFIC_TIME:
000248 930f                      	push r16
                                 
000249 d03e                      	rcall I2C_START
00024a ed00                          ldi r16, 0xD0
00024b d042                          rcall I2C_WRITE
                                 
00024c 9100 0061                 	lds r16, edit_mode
                                 ;запись секунд
00024e 3001                      	cpi r16,1		;
00024f f429                      	BRNE M_Wr		;Перейти если не равно
000250 e000                      	ldi r16, 0x00	; адрес регистра секенд
000251 d03c                      	rcall I2C_WRITE
000252 9100 0066                 	lds r16, i2c_sec
000254 c02a                          rjmp WR_T
                                 ;запись минут
                                 M_Wr:
000255 3002                      	cpi r16,2		;
000256 f429                      	BRNE H_Wr		;Перейти если не равно
000257 e001                      	ldi r16, 0x01	; адрес регистра минут
000258 d035                      	rcall I2C_WRITE
000259 9100 0067                 	lds r16, i2c_min
00025b c023                          rjmp WR_T
                                 ;запись часов
                                 H_Wr:
00025c 3003                      	cpi r16,3		;
00025d f429                      	BRNE WD_Wr		;Перейти если не равно
00025e e002                      	ldi r16, 0x02	; адрес регистра часов
00025f d02e                      	rcall I2C_WRITE
000260 9100 0068                 	lds r16, i2c_hours
000262 c01c                          rjmp WR_T
                                 ;запись дня недели
                                 WD_Wr:
000263 3004                      	cpi r16,4		;
000264 f429                      	BRNE D_Wr		;Перейти если не равно
000265 e003                      	ldi r16, 0x03	; адрес регистра дня недели
000266 d027                      	rcall I2C_WRITE
000267 9100 0069                 	lds r16, i2c_weekday
000269 c015                      	rjmp WR_T
                                 ;запись дня месяца
                                 D_Wr:
00026a 3005                      	cpi r16,5		;
00026b f429                      	BRNE MO_Wr		;Перейти если не равно
00026c e004                      	ldi r16, 0x04	; адрес регистра дня месяца
00026d d020                      	rcall I2C_WRITE
00026e 9100 006a                 	lds r16, i2c_day
000270 c00e                          rjmp WR_T
                                 ;запись месяца
                                 MO_Wr:
000271 3006                      	cpi r16,6		;
000272 f429                      	BRNE Y_Wr		;Перейти если не равно
000273 e005                      	ldi r16, 0x05	; адрес регистра месяца
000274 d019                      	rcall I2C_WRITE
000275 9100 006b                 	lds r16, i2c_month
000277 c007                      	rjmp WR_T
                                 ;запись года
                                 Y_Wr:
000278 3007                      	cpi r16,7		;
000279 f439                      	BRNE St_Wr		;Перейти если не равно
00027a e006                      	ldi r16, 0x06	; адрес регистра года
00027b d012                      	rcall I2C_WRITE
00027c 9100 006c                 	lds r16, i2c_year
00027e c000                          rjmp WR_T
                                 
                                 WR_T:	
00027f d00e                      	rcall I2C_WRITE
000280 d017                          rcall I2C_STOP
                                 St_Wr:
000281 910f                      	pop r16
000282 9508                          ret
                                 
                                 
                                 ; =========== I2C процедуры ===========
                                 I2C_INIT:
000283 e00b                          ldi r16, 11
000284 b900                          out TWBR, r16 ; TWI Bit Rate Register  коэффициент деления для генератора скорости передачи данных
000285 e000                          ldi r16, (0<<TWPS1)|(0<<TWPS0) ; биты предварительного делителя в регистр TWSR (PrescalerValue = 1)
000286 b901                          out TWSR, r16
000287 9508                          ret
                                 
                                 	; TWINT  устанавливается аппаратно, когда TWI завершил свою текущую работу и ожидает ответа 
                                 	; TWEN разрешает работу TWI и активирует интерфейс TWI
                                 	; TWSTA генерирует условие START
                                 I2C_START:
000288 ea04                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTA)
000289 bf06                          out TWCR, r16
                                 
                                 I2C_WAIT:
00028a b706                          in r16, TWCR
00028b ff07                          sbrs r16, TWINT ;  проверяет состояние 7 бита TWINT в регистре и, если этот бит установлен, пропускает следующую команду
00028c cffd                          rjmp I2C_WAIT
00028d 9508                          ret
                                 
                                 I2C_WRITE:
00028e b903                          out TWDR, r16
00028f e804                          ldi r16, (1<<TWINT)|(1<<TWEN)
000290 bf06                          out TWCR, r16
000291 cff8                          rjmp I2C_WAIT
                                 
                                 	; TWEA: TWI Enable Acknowledge Bit 
                                 I2C_READ_ACK:
000292 ec04                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWEA)
000293 bf06                          out TWCR, r16
000294 cff5                          rjmp I2C_WAIT
                                 
                                 I2C_READ_NACK:
000295 e804                          ldi r16, (1<<TWINT)|(1<<TWEN)
000296 bf06                          out TWCR, r16
000297 cff2                          rjmp I2C_WAIT
                                 
                                 	; TWSTO: TWI STOP Condition Bit 
                                 I2C_STOP:
000298 e904                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
000299 bf06                          out TWCR, r16
00029a 9508                          ret
                                 
                                 .include "spi.asm"
                                 
                                  * spi_1.asm
                                  *
                                  *  Created: 07.01.2026 22:45:59
                                  *   Author: ar_user
                                  */ 
                                  INIT_SPI:
                                 ; Включение SPI, режим Master, частота F_CPU/16
00029b e501                          ldi r16, (1<<SPE)|(1<<MSTR)|(0<<SPR1)|(1<<SPR0)
00029c b90d                          out SPCR, r16
                                     ;ldi r16, (0<<SPI2X); этот бит в нуль для полного спокойствия
                                 	;ldi r16, (1<<SPI2X); Бит удвоения скорости SPI
00029d b10e                      	in r16, SPSR
00029e 7f0e                          cbr r16, (1<<SPI2X) ; этот бит в нуль для полного спокойствия
00029f b90e                          out SPSR, r16
0002a0 9508                          ret
                                 
                                 
                                 ;=================== SPI_SEND (ОТПРАВКА БАЙТА ЧЕРЕЗ SPI)===================
                                 
                                 SPI_SEND:
                                     ; Вход: r16 = данные для отправки
                                     ; Выход: данные отправлены через аппаратный SPI
                                     
0002a1 b90f                          out SPDR, r16          ; Записываем данные в регистр SPI
                                 
                                 SPI_WAIT:
0002a2 b10e                          in r16, SPSR           ; Читаем статус SPI
0002a3 ff07                          sbrs r16, SPIF         ; Пропустить следующую команду если бит в регистре установлен. Проверяем флаг завершения передачи
0002a4 cffd                      	rjmp SPI_WAIT          ; Ждем завершения
                                     
0002a5 9508                          ret
                                 
                                 DIGIT_TO_SEGMENT:
                                     ; Вход: r18 = цифра (0-9)
                                     ; Выход: r18 = код сегментов для этой цифры
                                     ; Использует: Z, r17
                                 
0002a6 93ef                          push ZL
0002a7 93ff                          push ZH
0002a8 931f                          push r17
                                    
0002a9 e4e0                          ldi ZL, low(SEG_TABLE*2)
0002aa e0f0                          ldi ZH, high(SEG_TABLE*2)
0002ab 0fe2                          add ZL, r18
0002ac 2711                          clr r17
0002ad 1ff1                          adc ZH, r17
0002ae 9124                          lpm r18, Z
                                 
0002af 911f                          pop r17
0002b0 91ff                          pop ZH
0002b1 91ef                          pop ZL
0002b2 9508                          ret
                                 
                                  ;=========== Прерывание от DS3231 (INT0) ===========
                                 INT0_ISR:
                                 
0002b3 b65f                          in r5, SREG
0002b4 930f                          push r16
                                 	
0002b5 6071                      	sbr rFlags, (1<<rFlag_int0) ; устанавливаем флаг
0002b6 777f                      	cbr rFlags, (1<<rFlag_500) ; сброс флага 500 мс
                                 	
                                 	   	
0002b7 910f                      	pop r16
0002b8 be5f                          out SREG, r5
                                 	
0002b9 9518                          reti
                                 
                                 INT1_ISR:
0002ba b66f                      	in r6, SREG
0002bb 930f                          push r16
                                 
                                 	; ВЫКЛЮЧИТЬ INT1, чтобы не частил (сбросить бит INT1, сохранив INT0)
                                 	/*in  r16, GICR			; Читаем текущее состояние прерываний
                                 	andi r16, ~(1<<INT1)	; Сбрасываем только бит INT1 (это способ создать маску для инвертирования нужного бита в регистре микроконтроллера)
                                 	out GICR, r16			; Выключаем INT1*/
                                 
0002bc b70b                      	in r16, GICR
0002bd 770f                          cbr r16, (1<<INT1)
0002be bf0b                          out GICR, r16
                                 
                                 	; Запуск Таймера 0
                                 	/*; Устанавливаем предделитель (для 10мс)
                                 	Частота МК: 1 000 000 Гц.
                                 	Максимальный предделитель: 1024.
                                 	Частота таймера: 1000000/1024=976,5 Гц.
                                 	Период одного тика: =1,024 мс.
                                 	Количество тиков для 10 мс: 10/1,024=9,76.
                                 	10 мс — это почти ровно 10 тиков таймера при предделителе 1024.
                                 	Это дает погрешность около 2.4% (реально будет 10.24 мс), что для кнопок абсолютно не критично.
                                 	Чтобы таймер срабатывал каждые 10 тиков, мы будем использовать прерывание по переполнению (OVF) и при каждом входе догружать в счетчик значение, чтобы он быстрее добегал до 256.
                                  	Расчет: 256-10=246  (0xF6).*/
                                 	;ldi r16, 246        ; Заряжаем на 10 тиков до переполнения
0002bf ef06                      	ldi r16, 246
0002c0 bf02                          out TCNT0, r16
0002c1 e005                          ldi r16, (1<<CS02)|(0<<CS01)|(1<<CS00) ; Предделитель 1024 (Запуск)
0002c2 bf03                          out TCCR0, r16
                                 
                                 	
                                 	; Чистим флаг INT1 (дребезг при отпускании)
                                 	; 1. Сначала сбрасываем флаг INT1 (записью единицы!)
0002c3 e800                          ldi r16, (1<<INTF1)
0002c4 bf0a                          out GIFR, r16    ; Запись '1' в флаг прерывания очищает его    
                                     
                                 	; 2. Теперь безопасно включаем INT1
0002c5 b70b                          in r16, GICR
0002c6 6800                          ori r16, (1<<INT1)
0002c7 bf0b                          out GICR, r16        ; Снова включаем ожидание нажатия (INT1)
                                 
0002c8 910f                      	pop r16
0002c9 be6f                          out SREG, r6
                                 
                                 	.include "button.asm"
                                 
                                  * button.asm
                                  *
                                  *  Created: 09.02.2026 20:48:56
                                  *   Author: ar_user
                                  */ 
                                  TIMER0_ISR:
                                 	;sbi PORTB, PB0        ; ПОДНЯТЬ PB0 (Начало импульса)  для осцилла
                                 
0002ca b67f                      	in r7, SREG         ; Быстро сохраняем статус в R7 (1 такт)
0002cb 930f                          push r16
0002cc 934f                      	push r20
                                 	
                                 	; 1. Перезапуск таймера (Т0 требует ручной дозагрузки)
0002cd ef06                          ldi r16, 246
0002ce bf02                          out TCNT0, r16
                                 
                                 	; 1. Читаем и инвертируем
0002cf b340                          in   rBtn_now, BTN_PIN	; Считываем весь порт D
0002d0 9540                          com  rBtn_now			; Инвертируем (нажатая кнопка теперь "1")
0002d1 7f40                          andi rBtn_now, BTN_MASK	; Оставляем только PD4-PD7 (BTN_MASK=0xF0)
                                 
                                     ; 2. Если ничего не нажато — сброс счетчика и выход (или выключение)
0002d2 2344                          tst  rBtn_now
0002d3 f071                          breq BTN_RESET_CNT		; Перейти если равно 0 — кнопка отпущена
                                 
                                     ; 3. Кнопка нажата — увеличиваем счетчик
0002d4 9483                          inc  rDebounce
0002d5 e005                      	ldi r16, T_SHORT 
0002d6 1680                          cp  rDebounce, r16
0002d7 f090                          brlo TIM0_EXIT          ; Если еще не накопили 3 такта — просто выходим
                                 
                                     ; --- Кнопка подтверждена (нажата стабильно ~45-50 мс) ---
0002d8 6074                          sbr  rFlags, (1<<rFlag_short)
                                     
                                     ; Перевод в индекс (0-3)
0002d9 9542                          swap rBtn_now
0002da e050                          ldi  rBtn_Index, 0
                                 FIND_IDX:
0002db fd43                          sbrc rBtn_now, 3 ; Пропустить следующую команду если бит в регистре очищен
0002dc c003                          rjmp BTN_SAVE
0002dd 9553                          inc  rBtn_Index
0002de 0f44                          lsl  rBtn_now
0002df cffb                          rjmp FIND_IDX
                                 
                                 BTN_SAVE:
0002e0 9350 006f                     sts  rBtn_Save, rBtn_Index
                                     ; Теперь выключаем таймер, чтобы не частил
                                     ;rjmp STOP_TIMER
                                 
                                 BTN_RESET_CNT:
0002e2 2488                          clr  rDebounce
                                     ; Если кнопка пропала сразу (помеха), выключаем таймер
                                     ; Если хотим ловить длинные нажатия — логика меняется
                                 
                                 STOP_TIMER:
0002e3 e000                          ldi  r16, 0
0002e4 bf03                          out  TCCR0, r16 ; ВЫКЛЮЧАЕМ ТАЙМЕР 0 
                                     ; Чистим флаг INT1 (дребезг при отпускании)
                                 	; 1. Сначала сбрасываем флаг INT1 (записью единицы!)
0002e5 e800                          ldi r16, (1<<INTF1)
0002e6 bf0a                          out GIFR, r16    ; Запись '1' в флаг прерывания очищает его    
                                     
                                 	; 2. Теперь безопасно включаем INT1
0002e7 b70b                          in r16, GICR
0002e8 6800                          ori r16, (1<<INT1)
0002e9 bf0b                          out GICR, r16        ; Снова включаем ожидание нажатия (INT1)
                                 
                                 TIM0_EXIT:
                                    
0002ea 914f                      	pop r20
0002eb 910f                          pop r16
0002ec be7f                          out SREG, r7
                                 
                                 	;cbi PORTB, PB0        ; ОПУСТИТЬ PB0 (Конец импульса) для осцилла
0002ed 9518                      reti
                                 
                                 
                                 Press_Short:
0002ee 930f                      	push r16
0002ef d00a                      	rcall Progra_Short
0002f0 7f7b                      	cbr rFlags, (1<<rFlag_Short)
0002f1 6078                      	sbr rFlags, (1<<rFlag_TimeOut) ; установка флага
0002f2 e302                      	ldi r16,Sec_TimeOut		;вот они 50 секунд для TimeOut
0002f3 9300 0070                 	sts timeout_cnt, r16
0002f5 2700                      	clr r16
0002f6 9300 006f                 	sts rBtn_Save, r16
0002f8 910f                      	pop r16
0002f9 9508                      	ret
                                 
                                  
                                  Progra_Short:
0002fa 9100 006f                 	lds r16, rBtn_Save
                                 	;mov r16, rBtn_index
                                 	; Используем табличный переход
                                 	; Загружаем базовый адрес таблицы
0002fc e2ea                          ldi  ZL, low(TABLSHORT) 
0002fd e0f0                          ldi  ZH, high(TABLSHORT)
                                     ; Прибавляем индекс к адресу (Z = Z + r16)
0002fe 0fe0                          add  ZL, r16
0002ff 2711                          clr  r17
000300 1ff1                          adc  ZH, r17              ; Учитываем перенос
                                 
000301 9409                          ijmp                      ; ПРЫЖОК в обработчики табличных переходов по адресу в Z 
                                 
000302 9508                       ret
                                 
                                 
                                 CHANGE_MO:
000303 9100 0061                 	lds r16, edit_mode
000305 2300                          tst r16
000306 f071                          breq MODE_NEXT		   ; Перейти если равно 0, т.е. мы не в режиме редактирования
000307 3008                      	cpi R16,8 ; проверяем нахождение в режиме редактирование регистра 10Н
000308 f011                      	BREQ Wr_Re		; Перейти если равно
000309 d04d                          rcall SAVE_TO_RTC      ; Если были в редактировании времени - сохраняем
00030a c009                      	rjmp Out_CHM
                                 Wr_Re:
00030b df0a                      	rcall WRITE_REGISTER_10H	; выполняем запись в регистр 10Н
00030c 7d7f                      	cbr rFlags, (1<<rFlag_Reg10h) ; сбрасываем флаг
00030d 2700                      	clr r16				; делаем сброс режимов работы часов
00030e 9300 0061                 	sts edit_mode, r16
000310 9300 0060                 	sts display_mode, r16
000312 9300 006d                 	sts i2c_crystal,r16
                                 Out_CHM:
000314 9508                          ret
                                 MODE_NEXT:
000315 9100 0060                     lds r16, display_mode
000317 9503                          inc r16
000318 3006                          cpi r16, 6
000319 f008                          brlo MO_ST			; Перейти если меньше
00031a 2700                          clr r16
                                 MO_ST:
00031b 9300 0060                     sts display_mode, r16
00031d 9508                       ret
                                 
                                 CHANGE_ED:
00031e 9100 0061                 	lds r16, edit_mode
000320 9503                          inc r16
000321 3009                          cpi r16, 9             ; 8 параметров + 1 выход
000322 f008                          brlo ED_ST
000323 2700                          clr r16
                                 ED_ST:
000324 9300 0061                     sts edit_mode, r16
000326 9300 0060                 	sts display_mode, r16
                                     
000328 9508                      ret
                                 
                                 PLUS:
000329 9100 0061                 	lds  r16, edit_mode
00032b 2300                          tst  r16
00032c f031                          breq PL_BRIGHT           ; Если не в режиме настройки — Увеличиваем яркость
00032d 3008                      	cpi r16,8
00032e f011                      	breq Pl_CRUS		   ; Перейти если равно, работаем с изменение регистра кварца
00032f d030                          rcall VALUE_UP			; Вызываем наш универсальный инкремент через X
000330 c003                      	rjmp  Pl_DONE
                                 Pl_CRUS:
000331 d087                      	rcall Pl_CRUSTAL
000332 c001                      	rjmp  Pl_DONE       
                                 PL_BRIGHT:
000333 d00d                      	rcall BRIGHT_UP
                                 Pl_DONE:
                                 
000334 9508                      ret
                                 
                                 MINUS:
000335 9100 0061                 	lds  r16, edit_mode
000337 2300                          tst  r16
000338 f031                          breq MI_BRIGHT           ; Если не в режиме настройки — Уменьшаем яркость
000339 3008                      	cpi r16,8
00033a f011                      	breq MI_CRUS		   ; Перейти если равно, работаем с изменение регистра кварца 
00033b d03f                          rcall VALUE_DOWN		; Вызываем наш универсальный инкремент через X
00033c c003                      	rjmp  Mi_DONE
                                 MI_CRUS:
00033d d085                      	rcall MI_CRUSTAL
00033e c001                      	rjmp  Mi_DONE        
                                 MI_BRIGHT:
00033f d00c                      	rcall BRIGHT_DOWN
                                 Mi_DONE:
                                     
000340 9508                      ret
                                 
                                 BRIGHT_UP:
000341 b50a                      	in r16, OCR1AL
000342 b51b                      	in r17, OCR1AH
000343 300a                      	cpi r16, 10   ; Проверка нижней границы (макс. яркость)
000344 f010                          brlo LIMIT_UP    ; Перейти если меньше Не уменьшаем дальше
000345 5005                          subi r16, 5  ; Уменьшаем значение OCR1A (свет станет ярче)
000346 c001                      	rjmp BRU_OUT
                                 LIMIT_UP:
000347 e70d                      	ldi r16, 125
                                 BRU_OUT:
000348 2711                          clr r17
000349 bd1b                          out OCR1AH, r17
00034a bd0a                      	out OCR1AL, r16
00034b 9508                      ret
                                 
                                 BRIGHT_DOWN:
00034c b50a                      	in r16, OCR1AL
00034d b51b                      	in r17, OCR1AH
00034e 3f0a                      	cpi r16, 250	; Проверка верхней границы (мин. яркость)
00034f f410                          brsh LIMIT_DOWN    ; Перейти если больше или равно  Не увеличиваем дальше
000350 5f0b                          subi r16, -5	; Увеличиваем значение OCR1A (свет станет тусклее)
000351 c001                      	rjmp BRD_OUT
                                 LIMIT_DOWN:
000352 e70d                      	ldi r16, 125
                                 BRD_OUT:
000353 2711                          clr r17
000354 bd1b                          out OCR1AH, r17
000355 bd0a                      	out OCR1AL, r16
000356 9508                      ret
                                 
                                  
                                  SAVE_TO_RTC:
000357 9100 0061                 	lds r16, edit_mode
000359 deee                      	rcall WRITE_SPECIFIC_TIME
00035a 2700                      	clr r16
00035b 9300 0061                 	sts edit_mode, r16
00035d 9300 0060                 	sts display_mode, r16
00035f 9508                       ret
                                 
                                  VALUE_UP:
                                 	
000360 9100 0061                 	lds  r16, edit_mode
000362 2300                          tst  r16
000363 f0b1                          breq VU_EXIT            ; Если 0 — мы не в режиме настройки, выходим
                                 	
                                     ; Вычисляем адрес нужного байта в i2c_buffer
000364 e6a6                          ldi  XL, low(i2c_buffer)
000365 e0b0                          ldi  XH, high(i2c_buffer)
                                     
                                     ; Смещение: DS3231 имеет порядок Сек(0), Мин(1), Час(2)...
                                     ; Настраиваем указатель: X = i2c_buffer + (edit_mode - 1)
000366 2f10                          mov  r17, r16
000367 951a                          dec  r17                ; Делаем из 1..7 -> 0..6
000368 0fa1                          add  XL, r17
000369 2711                          clr  r17
00036a 1fb1                          adc  XH, r17            ; Указатель X теперь смотрит прямо на байт в SRAM
                                 
00036b 910c                          ld   r16, X             ; Загружаем значение (например, минуты)
                                     
                                     ; Определяем предел для текущего параметра
00036c d02f                          rcall GET_LIMIT         ; Возвращает предел в r17 (напр. 0x60 для минут)
                                     
                                     ; Инкремент BCD
00036d 5f0f                          subi r16, -1            ; +1
00036e 2f20                          mov  r18, r16
00036f 702f                          andi r18, 0x0F
000370 302a                          cpi  r18, 0x0A          ; Проверка полупереноса
000371 f008                          brlo VU_CHECK_LIMIT
000372 5f0a                          subi r16, -6            ; Коррекция BCD (+6)
                                 
                                 VU_CHECK_LIMIT:
000373 1701                          cp   r16, r17           ; Проверка достижения максимума
000374 f008                          brlo VU_SAVE
000375 e000                          ldi  r16, 0x00          ; Сброс в ноль
                                 
                                 VU_SAVE:
000376 930c                          st   X, r16             ; Сохраняем обратно в i2c_buffer
000377 7f7d                      	cbr rFlags, (1<<rFlag_dot)
000378 ddba                          rcall DISPLAY_EDIT ; Сразу обновляем экран для отклика
000379 c000                      	rjmp VU_EXIT
                                 
                                 VU_EXIT:
00037a 9508                       ret
                                 
                                 
                                  VALUE_DOWN:
                                 
00037b 9110 0061                 	lds  r17, edit_mode
00037d 2311                          tst  r17
00037e f0e1                          breq VD_EXIT            ; Если 0 — выходим
                                 	
                                     ; Настройка указателя X на нужный байт в i2c_buffer
00037f e6a6                          ldi  XL, low(i2c_buffer)
000380 e0b0                          ldi  XH, high(i2c_buffer)
000381 951a                          dec  r17                ; Смещение (0..6)
000382 0fa1                          add  XL, r17
000383 2711                          clr  r17
000384 1fb1                          adc  XH, r17
                                 
000385 910c                          ld   r16, X             ; Загружаем значение (напр. 0x10)
                                 
                                     
                                     ; --- Сама логика декремента BCD ---
000386 2300                          tst  r16                ; Проверяем, не ноль ли уже?
000387 f039                          breq VD_SET_MAX         ; Если 0x00, переходим к максимальному пределу
                                     
000388 5001                          subi r16, 1             ; Вычитаем 1 (0x10 -> 0x0F)
000389 2f20                          mov  r18, r16
00038a 702f                          andi r18, 0x0F          ; Изолируем младшую тетраду
00038b 302f                          cpi  r18, 0x0F          ; Был ли переход через ноль (заем)?
00038c f459                          brne VD_SAVE            ; Если нет (результат 0..8) — всё ок
                                     
00038d 5006                          subi r16, 6             ; Коррекция: 0x0F - 0x06 = 0x09
00038e c009                          rjmp VD_SAVE
                                 
                                 VD_SET_MAX:
00038f d00c                          rcall GET_LIMIT         ; Получаем предел (напр. 0x60 для минут) в r17
000390 2f01                          mov  r16, r17
                                     ; Нужно уменьшить предел на 1 шаг BCD, так как предел 0x60 — это уже "перебор"
                                     ; Чтобы получить 0x59 из 0x60:
000391 5001                          subi r16, 1
000392 2f20                          mov  r18, r16
000393 702f                          andi r18, 0x0F
000394 302f                          cpi  r18, 0x0F
000395 f411                          brne VD_SAVE
000396 5006                          subi r16, 6             ; 0x5F -> 0x59
000397 c000                          rjmp VD_SAVE
                                 
                                 VD_SAVE:
000398 930c                          st   X, r16             ; Сохраняем результат
000399 dd99                          rcall DISPLAY_EDIT ; Сразу обновляем экран для отклика
00039a c000                      	rjmp VD_EXIT
                                 
                                 VD_EXIT:
                                    
00039b 9508                       ret
                                 
                                  GET_LIMIT:
00039c 9130 0061                     lds  r19, edit_mode
00039e 3031                          cpi  r19, 1             ; Секунды
00039f f069                          breq LIM_60
0003a0 3032                          cpi  r19, 2             ; Минуты
0003a1 f059                          breq LIM_60
0003a2 3033                          cpi  r19, 3             ; Часы
0003a3 f079                          breq LIM_24
0003a4 3034                          cpi  r19, 4             ; День недели
0003a5 f049                          breq LIM_8	
0003a6 3035                          cpi  r19, 5             ; Дата (упрощенно до 31)
0003a7 f069                          breq LIM_32
0003a8 3036                      	cpi  r19, 6             ; Месяц
0003a9 f039                          breq LIM_13
0003aa 3037                      	cpi  r19, 7             ; Год (упрощенно до 99)
0003ab f059                          breq LIM_99
0003ac 9508                          ret
                                 
                                 LIM_60:
0003ad e610                      	ldi r17, 0x60
0003ae 9508                      	ret
                                 LIM_8:
0003af e018                      	ldi r17, 0x08
0003b0 9508                      	ret
                                 LIM_13:
0003b1 e113                      	ldi r17, 0x13
0003b2 9508                      	ret
                                 LIM_24:
0003b3 e214                      	ldi r17, 0x24
0003b4 9508                      	ret
                                 LIM_32:
0003b5 e312                      	ldi r17, 0x32
0003b6 9508                      	ret
                                 LIM_99:
0003b7 e919                      	ldi r17, 0x99
0003b8 9508                      	ret
                                 
                                 
                                 Pl_CRUSTAL:
0003b9 930f                      	push r16
0003ba 9100 006d                 	lds   r16, i2c_crystal
0003bc 370f                          cpi   r16, 127
0003bd f019                          breq  inc_done           ; если уже максимум, не увеличиваем
0003be 9503                          inc   r16
0003bf 9300 006d                     sts   i2c_crystal, r16
                                 inc_done:
0003c1 910f                      	pop r16	
0003c2 9508                      ret
                                 
                                 MI_CRUSTAL:
0003c3 930f                      	push r16
0003c4 9100 006d                 	lds   r16, i2c_crystal
0003c6 3800                          cpi   r16, -128          ; сравниваем с -128 (0x80)
0003c7 f019                          breq  dec_done
0003c8 950a                          dec   r16
0003c9 9300 006d                     sts   i2c_crystal, r16
                                 dec_done:
0003cb 910f                      	pop r16
0003cc 9508                      	ret
                                 
                                 
                                 


