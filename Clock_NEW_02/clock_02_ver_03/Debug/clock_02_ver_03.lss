                                  DISPLAY_EDIT:
0001cd 930f                      	push r16
0001ce 931f                      	push r17
0001cf 932f                      	push r18
0001d0 93ef                      	push r30
0001d1 93ff                      	push r31
                                 
0001d2 9100 0061                 	lds r16, edit_mode
0001d4 3008                      	cpi R16, 8          ; Проверяем, что индекс меньше 8
0001d5 f438                          brsh Error2     ; Если R16 >= 8, уходим на обработку ошибки
0001d6 950a                      	dec r16 ; делаю декримент для правильной работы табличных переходов мне надо чтобы индекс edit_mode начинался с нуля Делаем из 1..7 -> 0..6
0001d7 e2ea                      	ldi  ZL, low(TABLEDIT) 
0001d8 e0f0                          ldi  ZH, high(TABLEDIT)
                                     ; Прибавляем индекс к адресу (Z = Z + r16)
0001d9 0fe0                          add  ZL, r16
0001da 2711                          clr  r17
0001db 1ff1                          adc  ZH, r17              ; Учитываем перенос
                                 
0001dc 9409                          ijmp                      ; ПРЫЖОК в обработчики табличных переходов по адресу в Z 
                                 
                                 Error2:
0001dd 2700                      	clr r16					; обнуляем "мусор" переводим на режим по дефолту
0001de 9300 0061                 	sts edit_mode, r16
0001e0 c017                      	rjmp OUT_UD2
                                 
                                 ; анимация 2-ого идикатора
                                 Disp_2:
                                 
0001e1 ff92                      	SBRS rFlags, rFlag_blink	 ;пропускает следующую команду если этот бит установлен
0001e2 c002                      	rjmp HoLo
0001e3 e52c                      	ldi  r18,SEG_lo
0001e4 c001                      	rjmp LoHo
                                 HoLo:
0001e5 e623                      	ldi  r18,SEG_ho
                                 LoHo:	
0001e6 9320 0063                 	sts display_2, r18
                                 
0001e8 9508                      	ret
                                 
                                 	
                                 
                                 UPDATE_DISPLAY_2:	 
                                 	    
0001e9 9100 0065                 	lds r16,display_4
0001eb d038                      	rcall spi_send
0001ec 9100 0064                 	lds r16,display_3
0001ee d035                      	rcall spi_send
0001ef 9100 0063                 	lds r16,display_2
0001f1 d032                      	rcall spi_send
0001f2 9100 0062                 	lds r16,display_1
0001f4 d02f                      	rcall spi_send
                                 
                                 	    
                                     ; Защелкиваем данные (импульс на SS/CS)
0001f5 9ac2                      	sbi SPI_PORT, LATCH
0001f6 0000                      	nop
0001f7 98c2                      	cbi SPI_PORT, LATCH 
                                 OUT_UD2:
0001f8 91ff                      	pop r31
0001f9 91ef                      	pop r30
0001fa 912f                      	pop r18
0001fb 911f                      	pop r17
0001fc 910f                      	pop r16
0001fd 9508                      
                                 SELECT_DISP:
0001fe 7f9e                      	cbr rFlags, (1<<rFlag_int0) ; сброс флага
                                 	;проверка на режим редактирования
0001ff 9130 0061                 	lds r19, edit_mode
000201 2333                          tst r19
000202 f011                          breq DiWo       ; Переход если равно т.е.если 0 — работаем как обычно
000203 dfc9                      	rcall DISPLAY_EDIT	;переход в показ режима редактирования
000204 c001                      	rjmp OUT_SeDi
                                 DiWo:
000205 def7                      	rcall DISPLAY_WORK ;переход в показ времени
                                 OUT_SeDi:
000206 9508                      	ret
                                  
                                  ;=========== Прерывание от DS3231 (INT0) ===========
                                 INT0_ISR:
000207 930f                          push r16
000208 b70f                          in r16, SREG
000209 930f                          push r16
                                 
00020a 6091                      	sbr rFlags, (1<<rFlag_int0) ; устанавливаем флаг
00020b e004                          ldi r16, 0b00000100
00020c 2790                          eor rFlags, r16        ; Инвертируем бит мигания rFlag_blink (для F_BLINK)
                                 	
                                 	
00020d 910f                      	pop r16
00020e bf0f                          out SREG, r16
00020f 910f                          pop r16
                                 	
000210 9518                          reti
                                 
                                 ;==================== Прерывание от кнопок (INT1) ===============================
                                 
                                 INT1_ISR:
000211 930f                      	push r16             ; Сохраняем рабочий регистр
000212 b70f                      	in r16, SREG         ; Сохраняем статус
000213 930f                      	push r16
                                 
                                 	; ВЫКЛЮЧИТЬ INT1, чтобы не частил (сбросить бит INT1, сохранив INT0)
000214 b70b                      	in  r16, GICR			; Читаем текущее состояние прерываний
000215 770f                      	andi r16, ~(1<<INT1)	; Сбрасываем только бит INT1 (это способ создать маску для инвертирования нужного бита в регистре микроконтроллера)
000216 bf0b                      	out GICR, r16			; Выключаем INT1
                                 
                                 	; Запуск Таймера 0
                                 	/*; Устанавливаем предделитель (для 10мс)
                                 	Частота МК: 1 000 000 Гц.
                                 	Максимальный предделитель: 1024.
                                 	Частота таймера: 1000000/1024=976,5 Гц.
                                 	Период одного тика: =1,024 мс.
                                 	Количество тиков для 10 мс: 10/1,024=9,76.
                                 	10 мс — это почти ровно 10 тиков таймера при предделителе 1024.
                                 	Это дает погрешность около 2.4% (реально будет 10.24 мс), что для кнопок абсолютно не критично.
                                 	Чтобы таймер срабатывал каждые 10 тиков, мы будем использовать прерывание по переполнению (OVF) и при каждом входе догружать в счетчик значение, чтобы он быстрее добегал до 256.
                                  	Расчет: 256-10=246  (0xF6).*/
                                 	;ldi r16, 246        ; Заряжаем на 10 тиков до переполнения
000217 ef06                      	ldi r16, 246
000218 bf02                          out TCNT0, r16
000219 e005                          ldi r16, (1<<CS02)|(0<<CS01)|(1<<CS00) ; Предделитель 1024 (Запуск)
00021a bf03                          out TCCR0, r16
                                 
00021b 910f                      	pop r16
00021c bf0f                      	out SREG, r16        ; Восстанавливаем статус
00021d 910f                      	pop r16
                                 
00021e 9518                      	reti
                                 
                                 
                                 
                                 .include "spi.asm"
                                 
                                  * spi_1.asm
                                  *
                                  *  Created: 07.01.2026 22:45:59
                                  *   Author: ar_user
                                  */ 
                                  INIT_SPI:
                                 ; Включение SPI, режим Master, частота F_CPU/16
00021f e501                          ldi r16, (1<<SPE)|(1<<MSTR)|(0<<SPR1)|(1<<SPR0)
000220 b90d                          out SPCR, r16
000221 e000                          ldi r16, (0<<SPI2X); этот бит в нуль для полного спокойствия
000222 b90e                          out SPSR, r16
000223 9508                          ret
                                 
                                 
                                 ;=================== SPI_SEND (ОТПРАВКА БАЙТА ЧЕРЕЗ SPI)===================
                                 
                                 SPI_SEND:
                                     ; Вход: r16 = данные для отправки
                                     ; Выход: данные отправлены через аппаратный SPI
                                     
000224 b90f                          out SPDR, r16          ; Записываем данные в регистр SPI
                                 
                                 SPI_WAIT:
000225 b10e                          in r16, SPSR           ; Читаем статус SPI
000226 ff07                          sbrs r16, SPIF         ; Пропустить следующую команду если бит в регистре установлен. Проверяем флаг завершения передачи
000227 cffd                      	rjmp SPI_WAIT          ; Ждем завершения
                                     
000228 9508                          ret
                                 
                                 DIGIT_TO_SEGMENT:
                                     ; Вход: r18 = цифра (0-9)
                                     ; Выход: r18 = код сегментов для этой цифры
                                     ; Использует: Z, r17
                                 
000229 93ef                          push ZL
00022a 93ff                          push ZH
00022b 931f                          push r17
                                    
00022c e4e0                          ldi ZL, low(SEG_TABLE*2)
00022d e0f0                          ldi ZH, high(SEG_TABLE*2)
00022e 0fe2                          add ZL, r18
00022f 2711                          clr r17
000230 1ff1                          adc ZH, r17
000231 9124                          lpm r18, Z
                                 
000232 911f                          pop r17
000233 91ff                          pop ZH
000234 91ef                          pop ZL
000235 9508                          ret
                                 
                                 
                                 ;.include "button.asm"
                                 
                                 


