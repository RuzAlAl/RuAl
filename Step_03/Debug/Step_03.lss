                                 .equ	PORTB6	= 6	; Port B Data Register bit 6
                                 .equ	PB6	= 6	; For compatibility
                                 .equ	PORTB7	= 7	; Port B Data Register bit 7
                                 .equ	PB7	= 7	; For compatibility
                                 
                                 ; DDRB - Port B Data Direction Register
                                 .equ	DDB0	= 0	; Port B Data Direction Register bit 0
                                 .equ	DDB1	= 1	; Port B Data Direction Register bit 1
                                 .equ	DDB2	= 2	; Port B Data Direction Register bit 2
                                 .equ	DDB3	= 3	; Port B Data Direction Register bit 3
                                 .equ	DDB4	= 4	; Port B Data Direction Register bit 4
                                 .equ	DDB5	= 5	; Port B Data Direction Register bit 5
                                 .equ	DDB6	= 6	; Port B Data Direction Register bit 6
                                 .equ	DDB7	= 7	; Port B Data Direction Register bit 7
                                 
                                 ; PINB - Port B Input Pins
                                 .equ	PINB0	= 0	; Port B Input Pins bit 0
                                 .equ	PINB1	= 1	; Port B Input Pins bit 1
                                 .equ	PINB2	= 2	; Port B Input Pins bit 2
                                 .equ	PINB3	= 3	; Port B Input Pins bit 3
                                 .equ	PINB4	= 4	; Port B Input Pins bit 4
                                 .equ	PINB5	= 5	; Port B Input Pins bit 5
                                 .equ	PINB6	= 6	; Port B Input Pins bit 6
                                 .equ	PINB7	= 7	; Port B Input Pins bit 7
                                 
                                 
                                 ; ***** PORTC ************************
                                 ; PORTC - Port C Data Register
                                 .equ	PORTC0	= 0	; Port C Data Register bit 0
                                 .equ	PC0	= 0	; For compatibility
                                 .equ	PORTC1	= 1	; Port C Data Register bit 1
                                 .equ	PC1	= 1	; For compatibility
                                 .equ	PORTC2	= 2	; Port C Data Register bit 2
                                 .equ	PC2	= 2	; For compatibility
                                 .equ	PORTC3	= 3	; Port C Data Register bit 3
                                 .equ	PC3	= 3	; For compatibility
                                 .equ	PORTC4	= 4	; Port C Data Register bit 4
                                 .equ	PC4	= 4	; For compatibility
                                 .equ	PORTC5	= 5	; Port C Data Register bit 5
                                 .equ	PC5	= 5	; For compatibility
                                 .equ	PORTC6	= 6	; Port C Data Register bit 6
                                 .equ	PC6	= 6	; For compatibility
                                 
                                 ; DDRC - Port C Data Direction Register
                                 .equ	DDC0	= 0	; Port C Data Direction Register bit 0
                                 .equ	DDC1	= 1	; Port C Data Direction Register bit 1
                                 .equ	DDC2	= 2	; Port C Data Direction Register bit 2
                                 .equ	DDC3	= 3	; Port C Data Direction Register bit 3
                                 .equ	DDC4	= 4	; Port C Data Direction Register bit 4
                                 .equ	DDC5	= 5	; Port C Data Direction Register bit 5
                                 .equ	DDC6	= 6	; Port C Data Direction Register bit 6
                                 
                                 ; PINC - Port C Input Pins
                                 .equ	PINC0	= 0	; Port C Input Pins bit 0
                                 .equ	PINC1	= 1	; Port C Input Pins bit 1
                                 .equ	PINC2	= 2	; Port C Input Pins bit 2
                                 .equ	PINC3	= 3	; Port C Input Pins bit 3
                                 .equ	PINC4	= 4	; Port C Input Pins bit 4
                                 .equ	PINC5	= 5	; Port C Input Pins bit 5
                                 .equ	PINC6	= 6	; Port C Input Pins bit 6
                                 
                                 
                                 ; ***** PORTD ************************
                                 ; PORTD - Port D Data Register
                                 .equ	PORTD0	= 0	; Port D Data Register bit 0
                                 .equ	PD0	= 0	; For compatibility
                                 .equ	PORTD1	= 1	; Port D Data Register bit 1
                                 .equ	PD1	= 1	; For compatibility
                                 .equ	PORTD2	= 2	; Port D Data Register bit 2
                                 .equ	PD2	= 2	; For compatibility
                                 .equ	PORTD3	= 3	; Port D Data Register bit 3
                                 .equ	PD3	= 3	; For compatibility
                                 .equ	PORTD4	= 4	; Port D Data Register bit 4
                                 .equ	PD4	= 4	; For compatibility
                                 .equ	PORTD5	= 5	; Port D Data Register bit 5
                                 .equ	PD5	= 5	; For compatibility
                                 .equ	PORTD6	= 6	; Port D Data Register bit 6
                                 .equ	PD6	= 6	; For compatibility
                                 .equ	PORTD7	= 7	; Port D Data Register bit 7
                                 .equ	PD7	= 7	; For compatibility
                                 
                                 ; DDRD - Port D Data Direction Register
                                 .equ	DDD0	= 0	; Port D Data Direction Register bit 0
                                 .equ	DDD1	= 1	; Port D Data Direction Register bit 1
                                 .equ	DDD2	= 2	; Port D Data Direction Register bit 2
                                 .equ	DDD3	= 3	; Port D Data Direction Register bit 3
                                 .equ	DDD4	= 4	; Port D Data Direction Register bit 4
                                 .equ	DDD5	= 5	; Port D Data Direction Register bit 5
                                 .equ	DDD6	= 6	; Port D Data Direction Register bit 6
                                 .equ	DDD7	= 7	; Port D Data Direction Register bit 7
                                 
                                 ; PIND - Port D Input Pins
                                 .equ	PIND0	= 0	; Port D Input Pins bit 0
                                 .equ	PIND1	= 1	; Port D Input Pins bit 1
                                 .equ	PIND2	= 2	; Port D Input Pins bit 2
                                 .equ	PIND3	= 3	; Port D Input Pins bit 3
                                 .equ	PIND4	= 4	; Port D Input Pins bit 4
                                 .equ	PIND5	= 5	; Port D Input Pins bit 5
                                 .equ	PIND6	= 6	; Port D Input Pins bit 6
                                 .equ	PIND7	= 7	; Port D Input Pins bit 7
                                 
                                 
                                 ; ***** EEPROM ***********************
                                 ; EEDR - EEPROM Data Register
                                 .equ	EEDR0	= 0	; EEPROM Data Register bit 0
                                 .equ	EEDR1	= 1	; EEPROM Data Register bit 1
                                 .equ	EEDR2	= 2	; EEPROM Data Register bit 2
                                 .equ	EEDR3	= 3	; EEPROM Data Register bit 3
                                 .equ	EEDR4	= 4	; EEPROM Data Register bit 4
                                 .equ	EEDR5	= 5	; EEPROM Data Register bit 5
                                 .equ	EEDR6	= 6	; EEPROM Data Register bit 6
                                 .equ	EEDR7	= 7	; EEPROM Data Register bit 7
                                 
                                 ; EECR - EEPROM Control Register
                                 .equ	EERE	= 0	; EEPROM Read Enable
                                 .equ	EEWE	= 1	; EEPROM Write Enable
                                 .equ	EEMWE	= 2	; EEPROM Master Write Enable
                                 .equ	EEWEE	= EEMWE	; For compatibility
                                 .equ	EERIE	= 3	; EEPROM Ready Interrupt Enable
                                 
                                 
                                 ; ***** CPU **************************
                                 ; SREG - Status Register
                                 .equ	SREG_C	= 0	; Carry Flag
                                 .equ	SREG_Z	= 1	; Zero Flag
                                 .equ	SREG_N	= 2	; Negative Flag
                                 .equ	SREG_V	= 3	; Two's Complement Overflow Flag
                                 .equ	SREG_S	= 4	; Sign Bit
                                 .equ	SREG_H	= 5	; Half Carry Flag
                                 .equ	SREG_T	= 6	; Bit Copy Storage
                                 .equ	SREG_I	= 7	; Global Interrupt Enable
                                 
                                 ; MCUCR - MCU Control Register
                                 ;.equ	ISC00	= 0	; Interrupt Sense Control 0 Bit 0
                                 ;.equ	ISC01	= 1	; Interrupt Sense Control 0 Bit 1
                                 ;.equ	ISC10	= 2	; Interrupt Sense Control 1 Bit 0
                                 ;.equ	ISC11	= 3	; Interrupt Sense Control 1 Bit 1
                                 .equ	SM0	= 4	; Sleep Mode Select
                                 .equ	SM1	= 5	; Sleep Mode Select
                                 .equ	SM2	= 6	; Sleep Mode Select
                                 .equ	SE	= 7	; Sleep Enable
                                 
                                 ; MCUCSR - MCU Control And Status Register
                                 .equ	MCUSR	= MCUCSR	; For compatibility
                                 .equ	PORF	= 0	; Power-on reset flag
                                 .equ	EXTRF	= 1	; External Reset Flag
                                 .equ	BORF	= 2	; Brown-out Reset Flag
                                 .equ	WDRF	= 3	; Watchdog Reset Flag
                                 
                                 ; OSCCAL - Oscillator Calibration Value
                                 .equ	CAL0	= 0	; Oscillator Calibration Value Bit0
                                 .equ	CAL1	= 1	; Oscillator Calibration Value Bit1
                                 .equ	CAL2	= 2	; Oscillator Calibration Value Bit2
                                 .equ	CAL3	= 3	; Oscillator Calibration Value Bit3
                                 .equ	CAL4	= 4	; Oscillator Calibration Value Bit4
                                 .equ	CAL5	= 5	; Oscillator Calibration Value Bit5
                                 .equ	CAL6	= 6	; Oscillator Calibration Value Bit6
                                 .equ	CAL7	= 7	; Oscillator Calibration Value Bit7
                                 
                                 ; SPMCR - Store Program Memory Control Register
                                 .equ	SPMEN	= 0	; Store Program Memory Enable
                                 .equ	PGERS	= 1	; Page Erase
                                 .equ	PGWRT	= 2	; Page Write
                                 .equ	BLBSET	= 3	; Boot Lock Bit Set
                                 .equ	RWWSRE	= 4	; Read-While-Write Section Read Enable
                                 .equ	RWWSB	= 6	; Read-While-Write Section Busy
                                 .equ	SPMIE	= 7	; SPM Interrupt Enable
                                 
                                 ; SFIOR - Special Function IO Register
                                 .equ	PSR10	= 0	; Prescaler Reset Timer/Counter1 and Timer/Counter0
                                 .equ	PUD	= 2	; Pull-up Disable
                                 .equ	ADHSM	= 4	; ADC High Speed Mode
                                 
                                 
                                 ; ***** AD_CONVERTER *****************
                                 ; ADMUX - The ADC multiplexer Selection Register
                                 .equ	MUX0	= 0	; Analog Channel and Gain Selection Bits
                                 .equ	MUX1	= 1	; Analog Channel and Gain Selection Bits
                                 .equ	MUX2	= 2	; Analog Channel and Gain Selection Bits
                                 .equ	MUX3	= 3	; Analog Channel and Gain Selection Bits
                                 .equ	ADLAR	= 5	; Left Adjust Result
                                 .equ	REFS0	= 6	; Reference Selection Bit 0
                                 .equ	REFS1	= 7	; Reference Selection Bit 1
                                 
                                 ; ADCSRA - The ADC Control and Status register
                                 .equ	ADCSR	= ADCSRA	; For compatibility
                                 .equ	ADPS0	= 0	; ADC  Prescaler Select Bits
                                 .equ	ADPS1	= 1	; ADC  Prescaler Select Bits
                                 .equ	ADPS2	= 2	; ADC  Prescaler Select Bits
                                 .equ	ADIE	= 3	; ADC Interrupt Enable
                                 .equ	ADIF	= 4	; ADC Interrupt Flag
                                 .equ	ADFR	= 5	; ADC  Free Running Select
                                 .equ	ADSC	= 6	; ADC Start Conversion
                                 .equ	ADEN	= 7	; ADC Enable
                                 
                                 
                                 
                                 ; ***** LOCKSBITS ********************************************************
                                 .equ	LB1	= 0	; Lock bit
                                 .equ	LB2	= 1	; Lock bit
                                 .equ	BLB01	= 2	; Boot Lock bit
                                 .equ	BLB02	= 3	; Boot Lock bit
                                 .equ	BLB11	= 4	; Boot lock bit
                                 .equ	BLB12	= 5	; Boot lock bit
                                 
                                 
                                 ; ***** FUSES ************************************************************
                                 ; LOW fuse bits
                                 .equ	CKSEL0	= 0	; Select Clock Source
                                 .equ	CKSEL1	= 1	; Select Clock Source
                                 .equ	CKSEL2	= 2	; Select Clock Source
                                 .equ	CKSEL3	= 3	; Select Clock Source
                                 .equ	SUT0	= 4	; Select start-up time
                                 .equ	SUT1	= 5	; Select start-up time
                                 .equ	BODEN	= 6	; Brown out detector enable
                                 .equ	BODLEVEL	= 7	; Brown out detector trigger level
                                 
                                 ; HIGH fuse bits
                                 .equ	BOOTRST	= 0	; Select Reset Vector
                                 .equ	BOOTSZ0	= 1	; Select Boot Size
                                 .equ	BOOTSZ1	= 2	; Select Boot Size
                                 .equ	EESAVE	= 3	; EEPROM memory is preserved through chip erase
                                 .equ	CKOPT	= 4	; Oscillator Options
                                 .equ	SPIEN	= 5	; Enable Serial programming and Data Downloading
                                 .equ	WTDON	= 6	; Enable watchdog
                                 .equ	RSTDISBL	= 7	; Disable reset
                                 
                                 
                                 
                                 ; ***** CPU REGISTER DEFINITIONS *****************************************
                                 .def	XH	= r27
                                 .def	XL	= r26
                                 .def	YH	= r29
                                 .def	YL	= r28
                                 .def	ZH	= r31
                                 .def	ZL	= r30
                                 
                                 
                                 
                                 ; ***** DATA MEMORY DECLARATIONS *****************************************
                                 .equ	FLASHEND	= 0x0fff	; Note: Word address
                                 .equ	IOEND	= 0x003f
                                 .equ	SRAM_START	= 0x0060
                                 .equ	SRAM_SIZE	= 1024
                                 .equ	RAMEND	= 0x045f
                                 .equ	XRAMEND	= 0x0000
                                 .equ	E2END	= 0x01ff
                                 .equ	EEPROMEND	= 0x01ff
                                 .equ	EEADRBITS	= 9
                                 #pragma AVRPART MEMORY PROG_FLASH 8192
                                 #pragma AVRPART MEMORY EEPROM 512
                                 #pragma AVRPART MEMORY INT_SRAM SIZE 1024
                                 #pragma AVRPART MEMORY INT_SRAM START_ADDR 0x60
                                 
                                 
                                 
                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0xc00
                                 .equ	NRWW_STOP_ADDR	= 0xfff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0xbff
                                 .equ	PAGESIZE	= 32
                                 .equ	FIRSTBOOTSTART	= 0xf80
                                 .equ	SECONDBOOTSTART	= 0xf00
                                 .equ	THIRDBOOTSTART	= 0xe00
                                 .equ	FOURTHBOOTSTART	= 0xc00
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0001	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0002	; External Interrupt Request 1
                                 .equ	OC2addr	= 0x0003	; Timer/Counter2 Compare Match
                                 .equ	OVF2addr	= 0x0004	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0005	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0006	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0007	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x0008	; Timer/Counter1 Overflow
                                 .equ	OVF0addr	= 0x0009	; Timer/Counter0 Overflow
                                 .equ	SPIaddr	= 0x000a	; Serial Transfer Complete
                                 .equ	URXCaddr	= 0x000b	; USART, Rx Complete
                                 .equ	UDREaddr	= 0x000c	; USART Data Register Empty
                                 .equ	UTXCaddr	= 0x000d	; USART, Tx Complete
                                 .equ	ADCCaddr	= 0x000e	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x000f	; EEPROM Ready
                                 .equ	ACIaddr	= 0x0010	; Analog Comparator
                                 .equ	TWIaddr	= 0x0011	; 2-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0012	; Store Program Memory Ready
                                 
                                 .equ	INT_VECTORS_SIZE	= 19	; size in words
                                 
                                 #pragma AVRPART CORE INSTRUCTIONS_NOT_SUPPORTED break
                                 
                                 #endif  /* _M8DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; Step_03.asm
                                 ;
                                 ; Created: 17.02.2026 21:36:00
                                 ; Author : ar_user
                                 ;
                                 
                                 .include "m8def.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega8.xml *************
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m8def.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega8
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega8
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M8DEF_INC_
                                 #endif  /* _M8DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 .list
                                 .include "define.inc"	; Наши все определения переменных тут
                                 
                                  * define.inc
                                  */ 
                                 
                                 .equ F_CPU = 1000000
                                 
                                 ; SPI для 74HC595
                                 .equ SPI_PORT    = PORTB
                                 .equ SPI_DDR     = DDRB		; направление 1 -выход, 0 -вход
                                 .equ SPI_PIN     = PINB		; информация только читается
                                 .equ SCK         = PB5     ; CLOCK
                                 .equ MISO        = PB4     ; не используется
                                 .equ DATA        = PB3     ; DATA (SER)
                                 .equ LATCH       = PB2     ; LATCH (CS)
                                 .equ OE          = PB1     ; ШИМ для яркости (Output Enable, активный низкий)
                                 
                                 .equ BEEPER_PIN  = PB0	   ; Выход для бипера
                                 
                                 ; Кнопки на PD7-PD4 с внешней подтяжкой
                                 .equ BTN_PORT    = PORTD
                                 .equ BTN_DDR     = DDRD
                                 .equ BTN_PIN     = PIND
                                 .equ BTN_MASK    = 0xF0		; PD7-PD4
                                 .equ BTN1        = 7		;PD7 Минус
                                 .equ BTN2        = 6		;PD6 Плюс
                                 .equ BTN3        = 5		;PD5 Вход в настройку (Edit)
                                 .equ BTN4        = 4		;PD4 Режимы дисплея/ Запись времени
                                 
                                 .equ BEEP_LEN   = 5     ; Длительность работы БИППЕРА (3 * 10мс = 30мс)
                                 .def rBeepTimer = r9     ; Счетчик длительности звука (в младших регистрах)
                                 
                                 .equ T_SHORT	= 3        ; 30 мс : Короткое нажатие
                                 .equ T_LONG     = 60	   ; 600 мс : Длинное нажатие
                                 
                                 .def rDebounce	 = r8     ; Счетчик антидребезга
                                 .def rBtn_now    = r20    ; Текущее чтение PIND
                                 .def rBtn_Index  = r21	  ; Индекс нажатой кнопки
                                 
                                 ; Кнопки через диоды (на INT1)
                                 .equ BTN_INT   = PD3     ; INT1
                                 
                                 ; DS3231 (на INT0)
                                 .equ DS3231_INT   = PD2     ; INT0
                                 
                                 ; I2C для DS3231
                                 .equ SDA          = PC4
                                 .equ SCL          = PC5
                                 
                                 ; Флаги
                                 .def rFlags = r23		  ; R23 регистр флагов
                                 .equ rFlag_int0   = 0	  ; Бит 0: Событие INT0 (от DS3231)
                                 .equ rFlag_dot  = 1		 ; Бит 1: Фаза мигания точки
                                 .equ rFlag_short  = 2     ; Бит 2: Короткое нажатие
                                 .equ rFlag_long   = 3     ; Бит 3: Длинное нажатие
                                 .equ rFlag_TimeOut = 4	  ; Бит 4: TimeOut режимов 
                                 .equ rFlag_beep   = 5     ; Бит 5: Активность бипера (1 - звучит)
                                 
                                 
                                 
                                 ; Сегменты цифр 0b dp,g,f,e,d,c,b,a
                                 			
                                 .equ SEG_0 = 0b00111111
                                 .equ SEG_1 = 0b00000110
                                 .equ SEG_2 = 0b01011011
                                 .equ SEG_3 = 0b01001111
                                 .equ SEG_4 = 0b01100110
                                 .equ SEG_5 = 0b01101101
                                 .equ SEG_6 = 0b01111101
                                 .equ SEG_7 = 0b00000111
                                 .equ SEG_8 = 0b01111111
                                 .equ SEG_9 = 0b01101111
                                 .equ SEG_C = 0b00111001
                                 .equ SEG_E = 0b01111001
                                 .equ SEG_ho = 0b01100011
                                 .equ SEG_lo = 0b01011100
                                 
                                 
                                 ; =========== Сегмент данных ===========
                                 .dseg
                                 .org SRAM_START
                                 
                                 ; Режимы дисплея
000060                           display_mode: .byte 1
                                 .equ MODE_HM     = 0      ; Часы-минуты
                                 .equ MODE_MS     = 1      ; Минуты-секунды
                                 .equ MODE_DM     = 2      ; Число-месяц
                                 .equ MODE_DAY    = 3      ; День недели
                                 .equ MODE_YEAR   = 4      ; Год (2 последние цифры)
                                 
                                 
000061                           edit_mode:    .byte 1
                                 .equ edit_off		= 0      ; редактирование отключено
                                 .equ edit_sec		= 1      ; секунды
                                 .equ edit_min		= 2      ; минуты
                                 .equ edit_hours     = 3      ; часы
                                 .equ edit_weekday   = 4      ; день недели
                                 .equ edit_day		= 5      ; день месяца
                                 .equ edit_mouth		= 6      ; месяц
                                 .equ edit_year		= 7      ; год
                                 
                                 
                                 ; Буферы
000062                           display_buf:  .byte 4
                                 .equ display_1		= display_buf       ; байт первого индикатора
                                 .equ display_2		= display_buf+1     ; байт второго индикатора
                                 .equ display_3		= display_buf+2     ; байт третьего индикатора
                                 .equ display_4		= display_buf+3     ; байт четвертого индикатора
                                 
000066                           i2c_buffer:   .byte 7      ; Буфер для I2C (секунды, минуты, часы, день, дата, месяц, год)
                                 .equ i2c_sec		= i2c_buffer     ; байт секунд в формате BCD 
                                 .equ i2c_min		= i2c_buffer+1   ; байт минут в формате BCD
                                 .equ i2c_hours		= i2c_buffer+2   ; байт часов в формате BCD 
                                 .equ i2c_weekday	= i2c_buffer+3   ; байт дня недели в формате BCD 
                                 .equ i2c_day		= i2c_buffer+4   ; байт дня месяца в формате BCD 
                                 .equ i2c_month		= i2c_buffer+5   ; байт месяца в формате BCD 
                                 .equ i2c_year		= i2c_buffer+6   ; байт года в формате BCD 
                                 
00006d                           rBtn_Latch:   .byte 1    ; Замороженное состояние нажатой кнопки
00006e                           timeout_cnt:  .byte 1    ; счетчик сброса режимов
                                 
                                 .cseg
                                 ; =========== Векторы прерывания ===========
                                 .include "vectors.inc"
                                 
                                 			;.CSEG
                                 			.ORG 	0x0000			; Проц стартует с нуля, но дальше идут вектора 
000000 c029                      			RJMP 	Reset			; прерываний, поэтому отсюда сразу же прыгаем на начало программы. На метку Reset
                                 			.ORG	INT0addr		; External Interrupt Request 0 = 0x0001
000001 c196                      			RJMP 	INT0_ISR		; Вектор INT0 (DS3231)
                                 			.ORG	INT1addr		; External Interrupt Request 1 = 0x0002
000002 9518                      			RETI
                                 			.ORG	OC2addr			; Timer/Counter2 Compare Match = 0x0003
000003 9518                      			RETI	
                                 			.ORG	OVF2addr		; Timer/Counter2 Overflow	= 0x0004
000004 9518                      			RETI
                                 			.ORG	ICP1addr		; Timer/Counter1 Capture Event = 0x0005
000005 9518                      			RETI
                                 			.ORG	OC1Aaddr		; Timer/Counter1 Compare Match A = 0x0006
000006 9518                      			RETI
                                 			.ORG	OC1Baddr		; Timer/Counter1 Compare Match B = 0x0007
000007 9518                      			RETI
                                 			.ORG	OVF1addr		; Timer/Counter1 Overflow = 0x0008
000008 9518                      			RETI
                                 			.ORG	OVF0addr		; Timer/Counter0 Overflow = 0x0009
                                 			;RJMP	TIMER0_OVF		; Jump to Timer0 overflow ISR
                                 			.ORG	SPIaddr			; Serial Transfer Complete = 0x000a
00000a 9518                      			RETI
                                 			.ORG	URXCaddr		; USART, Rx Complete = 0x000b
00000b 9518                      			RETI	
                                 			.ORG	UDREaddr		; USART Data Register Empty = 0x000c
00000c 9518                      			RETI
                                 			.ORG	UTXCaddr		; USART, Tx Complete = 0x000d
00000d 9518                      			RETI
                                 			.ORG	ADCCaddr		; ADC Conversion Complete = 0x000e
00000e 9518                      			RETI
                                 			.ORG	ERDYaddr		; EEPROM Ready = 0x000f
00000f 9518                      			RETI
                                 			.ORG	ACIaddr			; Analog Comparator = 0x0010
000010 9518                      			RETI
                                 			.ORG	TWIaddr			; 2-wire Serial Interface = 0x0011
000011 9518                      			RETI
                                 			.ORG	SPMRaddr		; Store Program Memory Ready = 0x0012
000012 9518                      			RETI
                                 
                                 .org 0x0020
                                 
                                 ; =========== Таблицы ===========
                                 SEG_TABLE:
000020 063f
000021 4f5b
000022 6d66
000023 077d
000024 6f7f                          .db SEG_0, SEG_1, SEG_2, SEG_3, SEG_4, SEG_5, SEG_6, SEG_7, SEG_8, SEG_9
                                 
                                 TABLDISP:
000025 c06e                      rjmp SHOW_HM      ; Индекс 0
000026 c072                      rjmp SHOW_MS      ; Индекс 1
000027 c077                      rjmp SHOW_DM      ; Индекс 2
000028 c075                      rjmp SHOW_DAY     ; Индекс 3
000029 c07a                      rjmp SHOW_YEAR    ; Индекс 4
                                 
                                 Reset:
                                     ; Инициализация стека
00002a e004                          ldi r16, high(RAMEND)
00002b bf0e                          out SPH, r16
00002c e50f                          ldi r16, low(RAMEND)
00002d bf0d                          out SPL, r16
                                 
                                 	; Инициализация портов
00002e d01c                          rcall INIT_PORTS
                                 
                                 	; Инициализация переменных
00002f d009                      	rcall INIT_VARIABLES
                                 
                                 	; Инициализация прерываний
000030 d026                      	rcall INIT_INTERRUPTS
                                 
                                 	; Инициализация DS3231
000031 d0d1                      	rcall INIT_DS3231
                                 
                                 	; Инициализация SPI
000032 d14e                      	rcall INIT_SPI
                                 	 
000033 9433                      	inc r3 ; смотрю ресеты
                                 
                                 	; Разрешение прерываний
000034 9478                      	sei
                                 
                                 
                                 
                                 MAIN_LOOP:
                                 	; 1. Событие INT0 (RTC секунда прошла)
000035 fd70                          sbrc rFlags, rFlag_int0 ; Пропустить следующую команду если бит в регистре очищен
000036 d025                      	rcall SELECT_DISP
                                 	
                                 SLEEP_ALL:	
                                 	; Режим сна
000037 9588                      	 sleep                 ; Перевести МК в режим энергосбережения
                                 
000038 cffc                      	rjmp MAIN_LOOP
                                 
                                 .include "initialization.asm"
                                 
                                  * initialization.asm
                                  *
                                  *  Created: 02.02.2026 16:11:17
                                  *   Author: ar_user
                                  */ 
                                  ; =========== Инициализация переменных ===========
                                 INIT_VARIABLES:
000039 2411                      	clr r1 ; R1: Всегда 0x00 (ускоряет очистку регистров и портов)
00003a 2455                          clr r5	; Используем в прерывании INT0 для сохранения SREG
00003b 2466                      	clr r6	; Используем в прерывании INT1 для сохранения SREG
00003c 2477                      	clr r7	; Используем в прерывании TIMER0 OVF для сохранения SREG
00003d 2488                      	clr r8	; Счетчик антидребезга
00003e 2499                      	clr r9  ; Счетчик длительности звука (в младших регистрах)
00003f 2755                      	clr r21	; Индекс нажатой кнопки
                                 	
                                 	; Флаги
000040 2777                           clr rflags ; регистр r23
                                 	     
                                     ; Режимы
000041 e000                      	ldi r16,0
000042 9300 0061                 	sts edit_mode, r16
                                 
000044 e000                      	ldi r16,0
000045 9300 0060                 	sts display_mode, r16
                                 	
000047 e00a                      	ldi r16,10
000048 9300 006e                 	sts timeout_cnt, r16
                                 
00004a 9508                      	ret
                                 
                                 ; =========== Инициализация портов ===========
                                 INIT_PORTS:
                                     
                                 	; SPI порты (MOSI, SCK, SS, OE, MR как выходы) и BEEPER_PIN
00004b ea0f                          ldi r16, (1<<DATA)|(1<<SCK)|(1<<LATCH)|(1<<OE)|(1<<BEEPER_PIN)|(1<<PB7)
00004c bb07                          out SPI_DDR, r16
                                     
                                     ; OE (яркость) - низкий уровень по умолчанию (максимальная яркость)
00004d 98c1                          cbi SPI_PORT, OE
                                 	     
                                 	    
                                     ; Порт для DS3231 (INT0)
00004e 988a                          cbi DDRD, DS3231_INT      ; Вход
00004f 9a92                          sbi PORTD, DS3231_INT     ; Подтяжка
                                     
                                     ; Порты для I2C
000050 98a4                          cbi DDRC, SDA             ; SDA - вход
000051 98a5                          cbi DDRC, SCL             ; SCL - вход
000052 9aac                          sbi PORTC, SDA            ; Подтяжка
000053 9aad                          sbi PORTC, SCL            ; Подтяжка
                                 
                                 	; Порты подключенных кнопок как входы и PD3 для INT1, без подтяжки (внешние резисторы на 5в)
000054 e000                          ldi r16, (0<<BTN1)|(0<<BTN2)|(0<<BTN3)|(0<<BTN4)|(0<<BTN_INT); BTN1 это PD7, BTN2 это PD6, BTN3 это PD5, BTN4 это PD4, BTN_INT это PD3
000055 bb01                          out BTN_DDR, r16
                                     
000056 9508                          ret
                                 
                                 
                                 ; =========== Инициализация прерываний ===========
                                 INIT_INTERRUPTS:
                                 	/*ISC01 ISC00 Описание
                                 	0 		0 Низкий уровень INT0 генерирует запрос прерывания.
                                 	0 		1 Любое логическое изменение на INT0 генерирует запрос прерывания.
                                 	1 		0 Спадающий фронт INT0 генерирует запрос прерывания.
                                 	1 		1 Восходящий фронт INT0 генерирует запрос прерывания.*/
                                     ; INT0 - От DS3231 восходящий фронт генерирует запрос прерывания
000057 e002                          ldi r16, (1<<ISC01)|(0<<ISC00)
000058 bf05                          out MCUCR, r16
000059 e400                          ldi r16, (1<<INT0)
00005a bf0b                          out GICR, r16
                                 
                                 	; INT1 - прерывание от кнопок по нажатию 
                                     ; (нажатие = 1->0 на INT1, отпускание = 0->1)
                                    /* ldi r16, (1<<ISC11)|(0<<ISC10)  ; нажатие = 1->0 по спаду (Falling Edge)
                                     out MCUCR, r16
                                 	; ВКЛЮЧИТЬ INT1 (установить бит INT1, сохранив INT0)
                                 	in  r16, GICR        ; Читаем текущее состояние
                                 	ori r16, (1<<INT1)   ; Устанавливаем только бит INT1 (Разрешение INT1)
                                 	out GICR, r16        ; Записываем обратно, включаем INT1
                                 
                                 	; Разрешаем прерывание по переполнению Таймера 0
                                     in r16, TIMSK
                                     ori r16, (1 << TOIE0)
                                     out TIMSK, r16*/
                                     
00005b 9508                      
                                 SELECT_DISP:
00005c fd74                      	sbrc rFlags, rFlag_TimeOut ; Пропустить следующую команду если бит в регистре очищен
00005d d00a                      	rcall TimeOut
00005e 7f7e                      	cbr rFlags, (1<<rFlag_int0) ; сброс флага
00005f d01c                      	rcall TEST_B
                                 	;проверка на режим редактирования
000060 9130 0061                 	lds r19, edit_mode
000062 2333                          tst r19
000063 f011                          breq DiWo       ; Переход если равно т.е.если 0 — работаем как обычно
000064 d010                      	rcall DISPLAY_EDIT	;переход в показ режима редактирования
000065 c001                      	rjmp OUT_SeDi
                                 DiWo:
000066 d041                      	rcall DISPLAY_WORK ;переход в показ времени
                                 OUT_SeDi:
000067 9508                      	ret
                                 
                                 TimeOut:
                                 	; --- Логика таймаута ---
000068 9130 006e                     lds r19, timeout_cnt
00006a 953a                          dec r19             ; Уменьшаем каждую секунду
00006b 9330 006e                     sts timeout_cnt, r19
00006d f431                          brne Out_TO  ; Если еще не ноль, продолжаем 
                                 
00006e 2700                          clr r16             ; Если ноль — сброс режима
00006f 7e7f                      	cbr rFlags, (1<<rFlag_TimeOut) ; сброс флага
000070 9300 0061                     sts edit_mode, r16	
000072 9300 0060                 	sts display_mode, r16
                                 
                                 Out_TO:
000074 9508                       ret
                                 
                                  DISPLAY_EDIT:
000075 d001                       rcall TEST_A
000076 9508                       ret
                                 
                                 TEST_A:
                                 	;cbr rFlags, (1<<rFlag_int0)
                                 	;rcall READ_DATETIME
000077 b308                      	in  r16, PORTB
000078 e810                      	ldi r17,(1<<PB7)
000079 2701                      	eor r16, r17  ; Исключающее ИЛИ: если был 0 — станет 1, если 1 — станет 0
00007a bb08                      	out PORTB,r16
                                 	/*in  r16, PORTB
                                 	andi r16,0b10000000 ; Оставляем только 7 бит
                                 	cpi r16,0b10000000
                                 	BRNE VVV			;Перейти если не равно
                                 	cbi PORTB, PB7
                                 	rjmp Out_Te
                                 VVV:
                                 	sbi PORTB, PB7*/
                                 out_te:
00007b 9508                      ret	
                                 ; Делаю пятисекундное изменение режима дисплея от 0 до 4
                                 TEST_B:
00007c 933f                      	push r19
00007d 9130 006e                 	lds r19, timeout_cnt
00007f 953a                          dec r19             ; Уменьшаем каждую секунду
000080 9330 006e                     sts timeout_cnt, r19
000082 f479                          brne Out_TB2  ; Если еще не ноль, продолжаем 
000083 e035                      	ldi r19,5	
000084 9330 006e                 	sts timeout_cnt, r19
000086 9130 0060                 	lds r19, display_mode
000088 9533                      	inc r19
000089 3035                      	cpi r19,5	;5 это уже перебор
00008a f418                          brsh Out_TB1    ; Если R19 >= 5
00008b 9330 0060                 	sts display_mode, r19
00008d c004                      	rjmp Out_TB2
                                 Out_TB1:
00008e 7f7d                      	cbr rFlags, (1<<rFlag_dot)
00008f 2733                      	clr r19
000090 9330 0060                 	sts display_mode, r19	
                                 	
                                 Out_TB2:
000092 913f                      	pop r19
000093 9508                      ret
                                 
                                 .include "displaywork.asm"
                                 
                                  * displayrtc.asm
                                  *
                                  *  Created: 02.02.2026 16:20:48
                                  *   Author: ar_user
                                  */ 
                                  ; --- Обработчики табличных переходов ---
                                 SHOW_HM:
000094 9100 0068                     lds  r16, i2c_hours
000096 9110 0067                     lds  r17, i2c_min
000098 c023                          rjmp Buffer_disp
                                 
                                 SHOW_MS:
000099 9100 0067                     lds  r16, i2c_min
00009b 9110 0066                     lds  r17, i2c_sec
00009d c01e                          rjmp Buffer_disp
                                 
                                 SHOW_DAY:
                                 	;ldi  r16, 0x00
                                     ;lds  r17, i2c_weekday
00009e c01d                          rjmp Buffer_disp
                                 
                                 SHOW_DM:
00009f 9100 006a                 	lds  r16, i2c_day
0000a1 9110 006b                     lds  r17, i2c_month
0000a3 c018                          rjmp Buffer_disp
                                 
                                 SHOW_YEAR:
0000a4 e200                      	ldi  r16, 0x20
0000a5 9110 006c                     lds  r17, i2c_year
0000a7 c014                          rjmp Buffer_disp
                                 
                                 
                                 DISPLAY_WORK:
0000a8 930f                      	push r16
0000a9 931f                      	push r17
0000aa 932f                      	push r18
0000ab 93ef                      	push r30
0000ac 93ff                      	push r31
                                 
                                 NORMAL_VIEW:
0000ad d060                      	rcall RTC_ADAPTIVE
0000ae 9100 0060                 	lds r16, display_mode
0000b0 3005                      	cpi R16, 5          ; Проверяем, что индекс меньше 5
0000b1 f430                          brsh Error1     ; Если R16 >= 5, уходим на обработку ошибки
                                 
                                     ; Используем табличный переход
                                 	; Загружаем базовый адрес таблицы
0000b2 e2e5                          ldi  ZL, low(TABLDISP) 
0000b3 e0f0                          ldi  ZH, high(TABLDISP)
                                     ; Прибавляем индекс к адресу (Z = Z + r16)
0000b4 0fe0                          add  ZL, r16
0000b5 2711                          clr  r17
0000b6 1ff1                          adc  ZH, r17              ; Учитываем перенос
                                 
0000b7 9409                          ijmp                      ; ПРЫЖОК в обработчики табличных переходов по адресу в Z 
                                 
                                 Error1:
0000b8 2700                      	clr r16					; обнуляем "мусор" переводим на режим по дефолту
0000b9 9300 0060                 	sts display_mode, r16
0000bb cff1                      	rjmp NORMAL_VIEW
                                 	
                                 		
                                 Buffer_disp:
                                 		
                                 	; Переход для формирования дня недели
0000bc 9120 0060                     lds r18, display_mode
0000be 3023                      	cpi r18, MODE_DAY
0000bf f109                      	BREQ MD3
                                 	
                                 			    
                                     ; Формируем 4 цифры:
                                     ; Индикатор 1 (левый): десятки часов
0000c0 2f20                      	mov r18, r16
0000c1 9522                          swap r18
0000c2 702f                          andi r18, 0x0F        ; Десятки часов (0-2)
0000c3 d0c7                      	rcall DIGIT_TO_SEGMENT    ; преобразуем цифру в код сегментов
0000c4 9320 0062                 	sts display_1, r18     ;  Сохраняем в буфер для левого (первого) индикатора
                                 	    
                                     ; Индикатор 2: единицы часов + точка
0000c6 2f20                          mov r18, r16
0000c7 702f                          andi r18, 0x0F        ; Единицы часов (0-9)
0000c8 d0c2                          rcall DIGIT_TO_SEGMENT ; преобразуем цифру в код сегментов
                                 
                                     ; Добавляем мигающую точку (между часами и минутами) работает только в режиме НМ
0000c9 9100 0060                 	lds r16, display_mode
0000cb 3000                      	cpi R16, MODE_HM
0000cc f431                      	brne OUT_DI2 ; Перейти если не равно
                                 	;SBRS rFlags, rFlag_dot ; проверяет состояние одного бита в регистре и пропускает следующую команду если этот бит установлен
0000cd fd71                      	SBRC rFlags, rFlag_dot ; проверяет состояние одного бита в регистре и пропускает следующую команду если этот бит очищен
0000ce c003                      	rjmp OUT_DI1
0000cf 6820                      	ori r18, (1<<7) ; устанавливаем 7 бит (это точка на 2-ом индикаторе) без изменения остальных
0000d0 6072                      	sbr rFlags, (1<<rFlag_dot)
0000d1 c001                      	rjmp OUT_DI2
                                 OUT_DI1:
0000d2 7f7d                      	cbr rFlags, (1<<rFlag_dot)
                                 OUT_DI2:
0000d3 9320 0063                 	sts display_2, r18     ; Сохраняем в буфер для второго индикатора
                                 
                                 
                                     ; Индикатор 3: Десятки минут
0000d5 2f21                          mov r18, r17
0000d6 9522                          swap r18
0000d7 702f                          andi r18, 0x0F        ; Десятки минут (0-5)
0000d8 d0b2                          rcall DIGIT_TO_SEGMENT
0000d9 9320 0064                     sts display_3, r18     ; третий индикатор
                                     
                                     ; 4. Единицы минут
0000db 2f21                          mov r18, r17
0000dc 702f                          andi r18, 0x0F        ; Единицы минут (0-9)
0000dd d0ad                          rcall DIGIT_TO_SEGMENT
0000de 9320 0065                     sts display_4, r18     ; четвертый индикатор
                                 	
0000e0 c00e                      	rjmp UPDATE_DISPLAY
                                 
                                 MD3:; формирование дня недели
0000e1 e400                      	ldi r16, 0b01000000
0000e2 9300 0062                 	sts display_1, r16
0000e4 9300 0063                 	sts display_2, r16
0000e6 9300 0065                 	sts display_4, r16	 ; четвертый индикатор
0000e8 9110 0069                 	lds  r17, i2c_weekday
0000ea 2f21                      	mov r18, r17
0000eb 702f                          andi r18, 0x0F        ; дни (1-7)
0000ec d09e                          rcall DIGIT_TO_SEGMENT
0000ed 9320 0064                     sts display_3, r18   ; третий индикатор  
                                 	
                                 	
                                 UPDATE_DISPLAY:	 
                                 	    
                                     ; ВАЖНО: передаем данные в обратном порядке!
                                     ; Первым выводим правый разряд (последний в цепочке 74HC595)
                                     
0000ef 9100 0065                 	lds r16,display_4
0000f1 d094                      	rcall spi_send
0000f2 9100 0064                 	lds r16,display_3
0000f4 d091                      	rcall spi_send
0000f5 9100 0063                 	lds r16,display_2
0000f7 d08e                      	rcall spi_send
0000f8 9100 0062                 	lds r16,display_1
0000fa d08b                      	rcall spi_send
                                 
                                 	    
                                     ; Защелкиваем данные (импульс на SS/CS)
0000fb 9ac2                      	sbi SPI_PORT, LATCH
                                 	;nop
0000fc 98c2                      	cbi SPI_PORT, LATCH 
                                 
                                 	;rcall TEST_A
                                 
0000fd 91ff                      	pop r31
0000fe 91ef                      	pop r30
0000ff 912f                      	pop r18
000100 911f                      	pop r17
000101 910f                      	pop r16
                                 
000102 9508                          ret
                                 	
                                 
                                 
                                 .include "i2c.asm"	
                                 
                                  * i2c.asm
                                 */ 
                                 ; =========== Инициализация DS3231 ===========
                                 INIT_DS3231:
000103 d065                          rcall I2C_INIT
                                     
000104 d069                          rcall I2C_START
000105 ed00                          ldi r16, 0xD0		;адрес DS3231
000106 d06d                          rcall I2C_WRITE
                                     
000107 e00e                          ldi r16, 0x0E		; адресс Control Register (0Eh) DS3231 
000108 d06b                          rcall I2C_WRITE
                                     
000109 e000                          ldi r16, 0x00		; запись в Control Register (0Eh) DS3231 Установка SQW на 1 Гц
00010a d069                          rcall I2C_WRITE
                                     
00010b d072                          rcall I2C_STOP
                                 
00010c d022                      	rcall READ_DATETIME_FULL
                                 	;rcall READ_DATETIME
                                 
00010d 9508                          ret
                                 
                                 ; Подстраиваем глубину опроса времени.
                                 ; В режимах показа часов-минут, минут-секунд читаем только первые 3 байта (Сек, Мин, Час)
                                 ; В режимах день недели, день-месяц, год читаем 7 байт
                                 RTC_ADAPTIVE:
00010e 9100 0060                 	lds r16, display_mode
000110 3002                          cpi r16, MODE_DM          ; Если режим Дата, День или Год
000111 f410                          brsh READ_FULL            ; Переход если больше или равно (Читаем все 7 байт)
                                 
                                     ; Иначе (HM или MS) — читаем только первые 3 байта (Сек, Мин, Час)
                                     ;ldi r17, 3
000112 d003                          rcall READ_DATETIME
000113 c001                          rjmp OUT_RTC
                                 
                                 READ_FULL:
                                     ;ldi r17, 7
000114 d01a                          rcall READ_DATETIME_FULL
                                 OUT_RTC:
000115 9508                      	ret
                                 
                                 ;============== Чтение времени из DS3231 ==================================
                                 
                                 READ_DATETIME:
000116 930f                          push r16
000117 7f7e                      	 cbr rFlags, (1<<rFlag_int0)       
                                     ;rcall I2C_INIT
                                     
000118 d055                          rcall I2C_START
                                     ; Адрес DS3231 для записи
000119 ed00                          ldi r16, 0xD0
00011a d059                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x00 (секунды)
00011b e000                          ldi r16, 0x00
00011c d057                          rcall I2C_WRITE
                                     
00011d d050                      	rcall I2C_START
                                     ; Повторный START для чтения
00011e ed01                          ldi r16, 0xD1
00011f d054                          rcall I2C_WRITE
                                 		
000120 d057                      	rcall I2C_READ_ACK
000121 b103                      	in r16, TWDR
000122 9300 0066                 	sts i2c_sec,r16
                                 	
000124 d053                      	rcall I2C_READ_ACK
000125 b103                      	in r16, TWDR
000126 9300 0067                 	sts i2c_min,r16
                                 	
000128 d052                      	rcall I2C_READ_NACK
000129 b103                      	in r16, TWDR
00012a 9300 0068                 	sts i2c_hours,r16
                                 		
00012c d051                      	rcall I2C_STOP
                                 	
00012d 910f                      	pop r16
00012e 9508                         ret
                                 
                                 ;============== Чтение времени из DS3231 ==================================
                                 
                                 READ_DATETIME_FULL:
00012f 930f                          push r16
                                 	        
                                         
000130 d03d                          rcall I2C_START
                                     ; Адрес DS3231 для записи
000131 ed00                          ldi r16, 0xD0
000132 d041                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x00 (секунды)
000133 e000                          ldi r16, 0x00
000134 d03f                          rcall I2C_WRITE
                                     
000135 d038                      	rcall I2C_START
                                     ; Повторный START для чтения
000136 ed01                          ldi r16, 0xD1
000137 d03c                          rcall I2C_WRITE
                                 		
000138 d03f                      	rcall I2C_READ_ACK
000139 b103                      	in r16, TWDR
00013a 9300 0066                 	sts i2c_sec,r16
                                 	
00013c d03b                      	rcall I2C_READ_ACK
00013d b103                      	in r16, TWDR
00013e 9300 0067                 	sts i2c_min,r16
                                 
000140 d037                      	rcall I2C_READ_ACK
000141 b103                      	in r16, TWDR
000142 9300 0068                 	sts i2c_hours,r16
                                 
000144 d033                      	rcall I2C_READ_ACK
000145 b103                      	in r16, TWDR
000146 9300 0069                 	sts i2c_weekday,r16
                                 
000148 d02f                      	rcall I2C_READ_ACK
000149 b103                      	in r16, TWDR
00014a 9300 006a                 	sts i2c_day,r16
                                 
00014c d02b                      	rcall I2C_READ_ACK
00014d b103                      	in r16, TWDR
00014e 9300 006b                 	sts i2c_month,r16
                                 	
000150 d02a                      	rcall I2C_READ_NACK
000151 b103                      	in r16, TWDR
000152 9300 006c                 	sts i2c_year,r16
                                 		
000154 d029                      	rcall I2C_STOP
                                 	
000155 910f                      	pop r16
000156 9508                         ret
                                 
                                 
                                 ; =========== Запись времени в DS3231 ===========
                                 WRITE_DATETIME:
000157 930f                          push r16
                                     
                                     ;rcall I2C_INIT
                                     
000158 d015                      	rcall I2C_START
000159 ed00                          ldi r16, 0xD0
00015a d019                          rcall I2C_WRITE
                                     
00015b e000                          ldi r16, 0x00
00015c d017                          rcall I2C_WRITE
                                     
00015d 9100 0066                     lds r16, i2c_sec
00015f d014                          rcall I2C_WRITE
                                     
000160 9100 0067                     lds r16, i2c_min
000162 d011                          rcall I2C_WRITE
                                     
000163 9100 0068                     lds r16, i2c_hours
000165 d00e                          rcall I2C_WRITE
                                     
000166 d017                          rcall I2C_STOP
                                 
000167 910f                          pop r16
000168 9508                          ret
                                 
                                 
                                 ; =========== I2C процедуры ===========
                                 I2C_INIT:
000169 e00b                          ldi r16, 11
00016a b900                          out TWBR, r16 ; TWI Bit Rate Register  коэффициент деления для генератора скорости передачи данных
00016b e000                          ldi r16, (0<<TWPS1)|(0<<TWPS0) ; биты предварительного делителя в регистр TWSR (PrescalerValue = 1)
00016c b901                          out TWSR, r16
00016d 9508                          ret
                                 
                                 	; TWINT  устанавливается аппаратно, когда TWI завершил свою текущую работу и ожидает ответа 
                                 	; TWEN разрешает работу TWI и активирует интерфейс TWI
                                 	; TWSTA генерирует условие START
                                 I2C_START:
00016e ea04                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTA)
00016f bf06                          out TWCR, r16
                                 
                                 I2C_WAIT:
000170 b706                          in r16, TWCR
000171 ff07                          sbrs r16, TWINT ;  проверяет состояние 7 бита TWINT в регистре и, если этот бит установлен, пропускает следующую команду
000172 cffd                          rjmp I2C_WAIT
000173 9508                          ret
                                 
                                 I2C_WRITE:
000174 b903                          out TWDR, r16
000175 e804                          ldi r16, (1<<TWINT)|(1<<TWEN)
000176 bf06                          out TWCR, r16
000177 cff8                          rjmp I2C_WAIT
                                 
                                 	; TWEA: TWI Enable Acknowledge Bit 
                                 I2C_READ_ACK:
000178 ec04                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWEA)
000179 bf06                          out TWCR, r16
00017a cff5                          rjmp I2C_WAIT
                                 
                                 I2C_READ_NACK:
00017b e804                          ldi r16, (1<<TWINT)|(1<<TWEN)
00017c bf06                          out TWCR, r16
00017d cff2                          rjmp I2C_WAIT
                                 
                                 	; TWSTO: TWI STOP Condition Bit 
                                 I2C_STOP:
00017e e904                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
00017f bf06                          out TWCR, r16
000180 9508                          ret
                                 
                                 .include "spi.asm"
                                 
                                  * spi_1.asm
                                  *
                                  *  Created: 07.01.2026 22:45:59
                                  *   Author: ar_user
                                  */ 
                                  INIT_SPI:
                                 ; Включение SPI, режим Master, частота F_CPU/16
000181 e501                          ldi r16, (1<<SPE)|(1<<MSTR)|(0<<SPR1)|(1<<SPR0)
000182 b90d                          out SPCR, r16
                                     ;ldi r16, (0<<SPI2X); этот бит в нуль для полного спокойствия
000183 e001                      	ldi r16, (1<<SPI2X); Бит удвоения скорости SPI
000184 b90e                          out SPSR, r16
000185 9508                          ret
                                 
                                 
                                 ;=================== SPI_SEND (ОТПРАВКА БАЙТА ЧЕРЕЗ SPI)===================
                                 
                                 SPI_SEND:
                                     ; Вход: r16 = данные для отправки
                                     ; Выход: данные отправлены через аппаратный SPI
                                     
000186 b90f                          out SPDR, r16          ; Записываем данные в регистр SPI
                                 
                                 SPI_WAIT:
000187 b10e                          in r16, SPSR           ; Читаем статус SPI
000188 ff07                          sbrs r16, SPIF         ; Пропустить следующую команду если бит в регистре установлен. Проверяем флаг завершения передачи
000189 cffd                      	rjmp SPI_WAIT          ; Ждем завершения
                                     
00018a 9508                          ret
                                 
                                 DIGIT_TO_SEGMENT:
                                     ; Вход: r18 = цифра (0-9)
                                     ; Выход: r18 = код сегментов для этой цифры
                                     ; Использует: Z, r17
                                 
00018b 93ef                          push ZL
00018c 93ff                          push ZH
00018d 931f                          push r17
                                    
00018e e4e0                          ldi ZL, low(SEG_TABLE*2)
00018f e0f0                          ldi ZH, high(SEG_TABLE*2)
000190 0fe2                          add ZL, r18
000191 2711                          clr r17
000192 1ff1                          adc ZH, r17
000193 9124                          lpm r18, Z
                                 
000194 911f                          pop r17
000195 91ff                          pop ZH
000196 91ef                          pop ZL
000197 9508                          ret
                                 
                                  ;=========== Прерывание от DS3231 (INT0) ===========
                                 INT0_ISR:
                                 
000198 b65f                          in r5, SREG
000199 930f                          push r16
                                 	
00019a 6071                      	sbr rFlags, (1<<rFlag_int0) ; устанавливаем флаг
                                    	
00019b 910f                      	pop r16
00019c be5f                          out SREG, r5
                                 	
00019d 9518                          reti
                                 
                                 
                                 


