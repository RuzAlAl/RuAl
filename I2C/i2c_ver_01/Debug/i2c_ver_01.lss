                                 .equ	PINB5	= 5	; Port B Input Pins bit 5
                                 .equ	PINB6	= 6	; Port B Input Pins bit 6
                                 .equ	PINB7	= 7	; Port B Input Pins bit 7
                                 
                                 
                                 ; ***** PORTC ************************
                                 ; PORTC - Port C Data Register
                                 .equ	PORTC0	= 0	; Port C Data Register bit 0
                                 .equ	PC0	= 0	; For compatibility
                                 .equ	PORTC1	= 1	; Port C Data Register bit 1
                                 .equ	PC1	= 1	; For compatibility
                                 .equ	PORTC2	= 2	; Port C Data Register bit 2
                                 .equ	PC2	= 2	; For compatibility
                                 .equ	PORTC3	= 3	; Port C Data Register bit 3
                                 .equ	PC3	= 3	; For compatibility
                                 .equ	PORTC4	= 4	; Port C Data Register bit 4
                                 .equ	PC4	= 4	; For compatibility
                                 .equ	PORTC5	= 5	; Port C Data Register bit 5
                                 .equ	PC5	= 5	; For compatibility
                                 .equ	PORTC6	= 6	; Port C Data Register bit 6
                                 .equ	PC6	= 6	; For compatibility
                                 
                                 ; DDRC - Port C Data Direction Register
                                 .equ	DDC0	= 0	; Port C Data Direction Register bit 0
                                 .equ	DDC1	= 1	; Port C Data Direction Register bit 1
                                 .equ	DDC2	= 2	; Port C Data Direction Register bit 2
                                 .equ	DDC3	= 3	; Port C Data Direction Register bit 3
                                 .equ	DDC4	= 4	; Port C Data Direction Register bit 4
                                 .equ	DDC5	= 5	; Port C Data Direction Register bit 5
                                 .equ	DDC6	= 6	; Port C Data Direction Register bit 6
                                 
                                 ; PINC - Port C Input Pins
                                 .equ	PINC0	= 0	; Port C Input Pins bit 0
                                 .equ	PINC1	= 1	; Port C Input Pins bit 1
                                 .equ	PINC2	= 2	; Port C Input Pins bit 2
                                 .equ	PINC3	= 3	; Port C Input Pins bit 3
                                 .equ	PINC4	= 4	; Port C Input Pins bit 4
                                 .equ	PINC5	= 5	; Port C Input Pins bit 5
                                 .equ	PINC6	= 6	; Port C Input Pins bit 6
                                 
                                 
                                 ; ***** PORTD ************************
                                 ; PORTD - Port D Data Register
                                 .equ	PORTD0	= 0	; Port D Data Register bit 0
                                 .equ	PD0	= 0	; For compatibility
                                 .equ	PORTD1	= 1	; Port D Data Register bit 1
                                 .equ	PD1	= 1	; For compatibility
                                 .equ	PORTD2	= 2	; Port D Data Register bit 2
                                 .equ	PD2	= 2	; For compatibility
                                 .equ	PORTD3	= 3	; Port D Data Register bit 3
                                 .equ	PD3	= 3	; For compatibility
                                 .equ	PORTD4	= 4	; Port D Data Register bit 4
                                 .equ	PD4	= 4	; For compatibility
                                 .equ	PORTD5	= 5	; Port D Data Register bit 5
                                 .equ	PD5	= 5	; For compatibility
                                 .equ	PORTD6	= 6	; Port D Data Register bit 6
                                 .equ	PD6	= 6	; For compatibility
                                 .equ	PORTD7	= 7	; Port D Data Register bit 7
                                 .equ	PD7	= 7	; For compatibility
                                 
                                 ; DDRD - Port D Data Direction Register
                                 .equ	DDD0	= 0	; Port D Data Direction Register bit 0
                                 .equ	DDD1	= 1	; Port D Data Direction Register bit 1
                                 .equ	DDD2	= 2	; Port D Data Direction Register bit 2
                                 .equ	DDD3	= 3	; Port D Data Direction Register bit 3
                                 .equ	DDD4	= 4	; Port D Data Direction Register bit 4
                                 .equ	DDD5	= 5	; Port D Data Direction Register bit 5
                                 .equ	DDD6	= 6	; Port D Data Direction Register bit 6
                                 .equ	DDD7	= 7	; Port D Data Direction Register bit 7
                                 
                                 ; PIND - Port D Input Pins
                                 .equ	PIND0	= 0	; Port D Input Pins bit 0
                                 .equ	PIND1	= 1	; Port D Input Pins bit 1
                                 .equ	PIND2	= 2	; Port D Input Pins bit 2
                                 .equ	PIND3	= 3	; Port D Input Pins bit 3
                                 .equ	PIND4	= 4	; Port D Input Pins bit 4
                                 .equ	PIND5	= 5	; Port D Input Pins bit 5
                                 .equ	PIND6	= 6	; Port D Input Pins bit 6
                                 .equ	PIND7	= 7	; Port D Input Pins bit 7
                                 
                                 
                                 ; ***** EEPROM ***********************
                                 ; EEDR - EEPROM Data Register
                                 .equ	EEDR0	= 0	; EEPROM Data Register bit 0
                                 .equ	EEDR1	= 1	; EEPROM Data Register bit 1
                                 .equ	EEDR2	= 2	; EEPROM Data Register bit 2
                                 .equ	EEDR3	= 3	; EEPROM Data Register bit 3
                                 .equ	EEDR4	= 4	; EEPROM Data Register bit 4
                                 .equ	EEDR5	= 5	; EEPROM Data Register bit 5
                                 .equ	EEDR6	= 6	; EEPROM Data Register bit 6
                                 .equ	EEDR7	= 7	; EEPROM Data Register bit 7
                                 
                                 ; EECR - EEPROM Control Register
                                 .equ	EERE	= 0	; EEPROM Read Enable
                                 .equ	EEWE	= 1	; EEPROM Write Enable
                                 .equ	EEMWE	= 2	; EEPROM Master Write Enable
                                 .equ	EEWEE	= EEMWE	; For compatibility
                                 .equ	EERIE	= 3	; EEPROM Ready Interrupt Enable
                                 
                                 
                                 ; ***** CPU **************************
                                 ; SREG - Status Register
                                 .equ	SREG_C	= 0	; Carry Flag
                                 .equ	SREG_Z	= 1	; Zero Flag
                                 .equ	SREG_N	= 2	; Negative Flag
                                 .equ	SREG_V	= 3	; Two's Complement Overflow Flag
                                 .equ	SREG_S	= 4	; Sign Bit
                                 .equ	SREG_H	= 5	; Half Carry Flag
                                 .equ	SREG_T	= 6	; Bit Copy Storage
                                 .equ	SREG_I	= 7	; Global Interrupt Enable
                                 
                                 ; MCUCR - MCU Control Register
                                 ;.equ	ISC00	= 0	; Interrupt Sense Control 0 Bit 0
                                 ;.equ	ISC01	= 1	; Interrupt Sense Control 0 Bit 1
                                 ;.equ	ISC10	= 2	; Interrupt Sense Control 1 Bit 0
                                 ;.equ	ISC11	= 3	; Interrupt Sense Control 1 Bit 1
                                 .equ	SM0	= 4	; Sleep Mode Select
                                 .equ	SM1	= 5	; Sleep Mode Select
                                 .equ	SM2	= 6	; Sleep Mode Select
                                 .equ	SE	= 7	; Sleep Enable
                                 
                                 ; MCUCSR - MCU Control And Status Register
                                 .equ	MCUSR	= MCUCSR	; For compatibility
                                 .equ	PORF	= 0	; Power-on reset flag
                                 .equ	EXTRF	= 1	; External Reset Flag
                                 .equ	BORF	= 2	; Brown-out Reset Flag
                                 .equ	WDRF	= 3	; Watchdog Reset Flag
                                 
                                 ; OSCCAL - Oscillator Calibration Value
                                 .equ	CAL0	= 0	; Oscillator Calibration Value Bit0
                                 .equ	CAL1	= 1	; Oscillator Calibration Value Bit1
                                 .equ	CAL2	= 2	; Oscillator Calibration Value Bit2
                                 .equ	CAL3	= 3	; Oscillator Calibration Value Bit3
                                 .equ	CAL4	= 4	; Oscillator Calibration Value Bit4
                                 .equ	CAL5	= 5	; Oscillator Calibration Value Bit5
                                 .equ	CAL6	= 6	; Oscillator Calibration Value Bit6
                                 .equ	CAL7	= 7	; Oscillator Calibration Value Bit7
                                 
                                 ; SPMCR - Store Program Memory Control Register
                                 .equ	SPMEN	= 0	; Store Program Memory Enable
                                 .equ	PGERS	= 1	; Page Erase
                                 .equ	PGWRT	= 2	; Page Write
                                 .equ	BLBSET	= 3	; Boot Lock Bit Set
                                 .equ	RWWSRE	= 4	; Read-While-Write Section Read Enable
                                 .equ	RWWSB	= 6	; Read-While-Write Section Busy
                                 .equ	SPMIE	= 7	; SPM Interrupt Enable
                                 
                                 ; SFIOR - Special Function IO Register
                                 .equ	PSR10	= 0	; Prescaler Reset Timer/Counter1 and Timer/Counter0
                                 .equ	PUD	= 2	; Pull-up Disable
                                 .equ	ADHSM	= 4	; ADC High Speed Mode
                                 
                                 
                                 ; ***** AD_CONVERTER *****************
                                 ; ADMUX - The ADC multiplexer Selection Register
                                 .equ	MUX0	= 0	; Analog Channel and Gain Selection Bits
                                 .equ	MUX1	= 1	; Analog Channel and Gain Selection Bits
                                 .equ	MUX2	= 2	; Analog Channel and Gain Selection Bits
                                 .equ	MUX3	= 3	; Analog Channel and Gain Selection Bits
                                 .equ	ADLAR	= 5	; Left Adjust Result
                                 .equ	REFS0	= 6	; Reference Selection Bit 0
                                 .equ	REFS1	= 7	; Reference Selection Bit 1
                                 
                                 ; ADCSRA - The ADC Control and Status register
                                 .equ	ADCSR	= ADCSRA	; For compatibility
                                 .equ	ADPS0	= 0	; ADC  Prescaler Select Bits
                                 .equ	ADPS1	= 1	; ADC  Prescaler Select Bits
                                 .equ	ADPS2	= 2	; ADC  Prescaler Select Bits
                                 .equ	ADIE	= 3	; ADC Interrupt Enable
                                 .equ	ADIF	= 4	; ADC Interrupt Flag
                                 .equ	ADFR	= 5	; ADC  Free Running Select
                                 .equ	ADSC	= 6	; ADC Start Conversion
                                 .equ	ADEN	= 7	; ADC Enable
                                 
                                 
                                 
                                 ; ***** LOCKSBITS ********************************************************
                                 .equ	LB1	= 0	; Lock bit
                                 .equ	LB2	= 1	; Lock bit
                                 .equ	BLB01	= 2	; Boot Lock bit
                                 .equ	BLB02	= 3	; Boot Lock bit
                                 .equ	BLB11	= 4	; Boot lock bit
                                 .equ	BLB12	= 5	; Boot lock bit
                                 
                                 
                                 ; ***** FUSES ************************************************************
                                 ; LOW fuse bits
                                 .equ	CKSEL0	= 0	; Select Clock Source
                                 .equ	CKSEL1	= 1	; Select Clock Source
                                 .equ	CKSEL2	= 2	; Select Clock Source
                                 .equ	CKSEL3	= 3	; Select Clock Source
                                 .equ	SUT0	= 4	; Select start-up time
                                 .equ	SUT1	= 5	; Select start-up time
                                 .equ	BODEN	= 6	; Brown out detector enable
                                 .equ	BODLEVEL	= 7	; Brown out detector trigger level
                                 
                                 ; HIGH fuse bits
                                 .equ	BOOTRST	= 0	; Select Reset Vector
                                 .equ	BOOTSZ0	= 1	; Select Boot Size
                                 .equ	BOOTSZ1	= 2	; Select Boot Size
                                 .equ	EESAVE	= 3	; EEPROM memory is preserved through chip erase
                                 .equ	CKOPT	= 4	; Oscillator Options
                                 .equ	SPIEN	= 5	; Enable Serial programming and Data Downloading
                                 .equ	WTDON	= 6	; Enable watchdog
                                 .equ	RSTDISBL	= 7	; Disable reset
                                 
                                 
                                 
                                 ; ***** CPU REGISTER DEFINITIONS *****************************************
                                 .def	XH	= r27
                                 .def	XL	= r26
                                 .def	YH	= r29
                                 .def	YL	= r28
                                 .def	ZH	= r31
                                 .def	ZL	= r30
                                 
                                 
                                 
                                 ; ***** DATA MEMORY DECLARATIONS *****************************************
                                 .equ	FLASHEND	= 0x0fff	; Note: Word address
                                 .equ	IOEND	= 0x003f
                                 .equ	SRAM_START	= 0x0060
                                 .equ	SRAM_SIZE	= 1024
                                 .equ	RAMEND	= 0x045f
                                 .equ	XRAMEND	= 0x0000
                                 .equ	E2END	= 0x01ff
                                 .equ	EEPROMEND	= 0x01ff
                                 .equ	EEADRBITS	= 9
                                 #pragma AVRPART MEMORY PROG_FLASH 8192
                                 #pragma AVRPART MEMORY EEPROM 512
                                 #pragma AVRPART MEMORY INT_SRAM SIZE 1024
                                 #pragma AVRPART MEMORY INT_SRAM START_ADDR 0x60
                                 
                                 
                                 
                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0xc00
                                 .equ	NRWW_STOP_ADDR	= 0xfff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0xbff
                                 .equ	PAGESIZE	= 32
                                 .equ	FIRSTBOOTSTART	= 0xf80
                                 .equ	SECONDBOOTSTART	= 0xf00
                                 .equ	THIRDBOOTSTART	= 0xe00
                                 .equ	FOURTHBOOTSTART	= 0xc00
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0001	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0002	; External Interrupt Request 1
                                 .equ	OC2addr	= 0x0003	; Timer/Counter2 Compare Match
                                 .equ	OVF2addr	= 0x0004	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0005	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0006	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0007	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x0008	; Timer/Counter1 Overflow
                                 .equ	OVF0addr	= 0x0009	; Timer/Counter0 Overflow
                                 .equ	SPIaddr	= 0x000a	; Serial Transfer Complete
                                 .equ	URXCaddr	= 0x000b	; USART, Rx Complete
                                 .equ	UDREaddr	= 0x000c	; USART Data Register Empty
                                 .equ	UTXCaddr	= 0x000d	; USART, Tx Complete
                                 .equ	ADCCaddr	= 0x000e	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x000f	; EEPROM Ready
                                 .equ	ACIaddr	= 0x0010	; Analog Comparator
                                 .equ	TWIaddr	= 0x0011	; 2-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0012	; Store Program Memory Ready
                                 
                                 .equ	INT_VECTORS_SIZE	= 19	; size in words
                                 
                                 #pragma AVRPART CORE INSTRUCTIONS_NOT_SUPPORTED break
                                 
                                 #endif  /* _M8DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; i2c_ver_01.asm
                                 ;
                                 ; Created: 05.01.2026 17:19:26
                                 ; Author : ar_user
                                 ;
                                 .include "m8def.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega8.xml *************
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m8def.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega8
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega8
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M8DEF_INC_
                                 #endif  /* _M8DEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 .list
                                 .include "define.inc"	; Наши все определения переменных тут
                                 
                                  * define.inc
                                  */ 
                                 
                                 .equ F_CPU = 1000000
                                 
                                 ; SPI для 74HC595
                                 .equ SPI_PORT    = PORTB
                                 .equ SPI_DDR     = DDRB		; направление 1 -выход, 0 -вход
                                 .equ SPI_PIN     = PINB		; информация только читается
                                 .equ SCK         = PB5     ; CLOCK
                                 .equ MISO        = PB4     ; не используется
                                 .equ DATA        = PB3     ; DATA (SER)
                                 .equ LATCH       = PB2     ; LATCH (CS)
                                 .equ OE          = PB1     ; ШИМ для яркости (Output Enable, активный низкий)
                                 .equ MR          = PB0	   ; reset для регистров 74HC595
                                 
                                 
                                 ; Кнопки на PD7-PD4 с внешней подтяжкой
                                 .equ BTN_PORT    = PORTD
                                 .equ BTN_DDR     = DDRD
                                 .equ BTN_PIN     = PIND
                                 .equ BTN_MASK    = 0xF0    ; PD7-PD4
                                 .equ BTN1        = PD7
                                 .equ BTN2        = PD6
                                 .equ BTN3        = PD5
                                 .equ BTN4        = PD4
                                 
                                 ; DS3231 (на INT0)
                                 .equ DS3231_INT   = PD2     ; INT0
                                 
                                 ; I2C для DS3231
                                 .equ SDA          = PC4
                                 .equ SCL          = PC5
                                 
                                 ; Флаги
                                 .def Flags = r25		 ; R25 регистр флагов
                                 .equ flag_time = 0       ; Бит 0: событие 1 секунда (от INT0)
                                 .equ flag_disp = 1	     ; Бит 1: Необходимость обновления дисплея
                                 .equ flag_bnt   = 2      ; Бит 2: Есть нажатая кнопка (от Timer1)
                                 
                                 
                                 ; Сегменты цифр
                                 .equ SEG_0 = 0b00111111
                                 .equ SEG_1 = 0b00110000
                                 .equ SEG_2 = 0b01101101
                                 .equ SEG_3 = 0b01111001
                                 .equ SEG_4 = 0b01110010
                                 .equ SEG_5 = 0b01011011
                                 .equ SEG_6 = 0b01011111
                                 .equ SEG_7 = 0b00110001
                                 .equ SEG_8 = 0b01111111
                                 .equ SEG_9 = 0b01111011
                                 .equ SEG_OFF = 0b00000000
                                 .equ SEG_DP = 0b10000000
                                 
                                 
                                 ; =========== Сегмент данных ===========
                                 .dseg
                                 .org SRAM_START
                                 
                                 ; Режимы дисплея
000060                           display_mode: .byte 1
                                 .equ MODE_HM     = 0      ; Часы-минуты
                                 .equ MODE_MS     = 1      ; Минуты-секунды
                                 .equ MODE_DM     = 2      ; Число-месяц
                                 .equ MODE_DAY    = 3      ; День недели
                                 .equ MODE_YEAR   = 4      ; Год (2 последние цифры)
                                 .equ MODE_COUNT  = 5
                                 
000061                           edit_mode:    .byte 1
                                 
                                 ; Флаги
                                 ;Необходимость записи времени
000062                           flag_wr_time:        .byte 1
                                 .equ wr_sec			= 0   ; нулевой бит, необходима запись секунд
                                 .equ wr_min			= 1   ; необходима запись минут
                                 .equ wr_hours		= 2   ; необходима запись часов
                                 .equ wr_weekday		= 3   ; необходима запись дня недели
                                 .equ wr_day			= 4   ; необходима запись дня месяца
                                 .equ wr_mouth		= 5   ; необходима запись месяца
                                 .equ wr_year		= 6   ; необходима запись года
                                 .equ wr_time		= 7	  ; общий флаг необходимости записи времени
                                 
                                 ; Буферы
000063                           display_buf:  .byte 4
                                 
000067                           i2c_buffer:   .byte 7      ; Буфер для I2C (секунды, минуты, часы, день, дата, месяц, год)
                                 .equ i2c_sec		= i2c_buffer     ; байт секунд в формате BCD 
                                 .equ i2c_min		= i2c_buffer+1   ; байт минут в формате BCD
                                 .equ i2c_hours		= i2c_buffer+2   ; байт часов в формате BCD 
                                 .equ i2c_weekday	= i2c_buffer+3   ; байт дня недели в формате BCD 
                                 .equ i2c_day		= i2c_buffer+4   ; байт дня месяца в формате BCD 
                                 .equ i2c_month		= i2c_buffer+5   ; байт месяца в формате BCD 
                                 .equ i2c_year		= i2c_buffer+6   ; байт года в формате BCD 
                                 
00006e                           bin_time_buffer:	.byte 7      ; Буфер для времени в формате BIN (секунды, минуты, часы, день, дата, месяц, год)
                                 .equ bin_sec		= bin_time_buffer     ; байт секунд в формате BIN
                                 .equ bin_min		= bin_time_buffer+1   ; байт минут в формате BIN
                                 .equ bin_hours		= bin_time_buffer+2   ; байт часов в формате BIN
                                 .equ bin_weekday	= bin_time_buffer+3   ; байт дня недели в формате BIN
                                 .equ bin_day		= bin_time_buffer+4   ; байт дня месяца в формате BIN
                                 .equ bin_mouth		= bin_time_buffer+5   ; байт месяца в формате BIN
                                 .equ bin_year		= bin_time_buffer+6   ; байт года в формате BIN
                                 
                                 .cseg
                                 ; =========== Векторы прерывания ===========
                                 	.ORG 	0x0000			; Проц стартует с нуля, но дальше идут вектора 
000000 c024                      	RJMP 	Reset			; прерываний, поэтому отсюда сразу же прыгаем на начало программы. На метку Reset
                                 	.ORG	0x0001			; External Interrupt Request 0 = 0x0001
000001 c047                      	RJMP 	INT0_DS3231		; Вектор INT0 (DS3231)
                                 .org 0x0020
                                 
                                 ; =========== Таблицы ===========
                                 SEG_TABLE:
000020 303f
000021 796d
000022 5b72
000023 315f
000024 7b7f                          .db SEG_0, SEG_1, SEG_2, SEG_3, SEG_4, SEG_5, SEG_6, SEG_7, SEG_8, SEG_9
                                 
                                 ;.include "i2c.asm"
                                 
                                 Reset:
                                     ; Инициализация стека
000025 e004                          ldi r16, high(RAMEND)
000026 bf0e                          out SPH, r16
000027 e50f                          ldi r16, low(RAMEND)
000028 bf0d                          out SPL, r16
                                 
                                 	; Инициализация портов
000029 d05a                          rcall INIT_PORTS
                                 
                                 	; Инициализация переменных
00002a d026                      	rcall INIT_VARIABLES
                                 
                                 	; Инициализация прерываний
00002b d063                      	rcall INIT_INTERRUPTS
                                 
                                 	; Инициализация DS3231
00002c d06a                      	rcall INIT_DS3231
                                 
                                 	;Запись времени для ТЕСТа
                                 	;rcall WRITE_DATETIME
                                 
                                 	; Инициализация SPI
                                 	;rcall INIT_SPI
                                 
00002d 9100 0062                 	lds r16, flag_wr_time	;считываем
00002f 6804                      	sbr r16, (1<<wr_time)| (1<<wr_hours)
000030 9300 0062                 	sts flag_wr_time, r16	; записываем
                                 
                                 		
                                 	; Разрешение прерываний
000032 9478                      	sei
                                 
                                 MAIN_LOOP:
                                 		
                                 	; Обновление времени по флагу
000033 ff90                          sbrs Flags, flag_time ;Пропустить следующую команду если бит в регистре стоит
000034 c002                          rjmp DISPLAY
000035 7f9e                      	cbr Flags, (1<<flag_time) ; СРАЗУ сбрасываем флаг
000036 d06a                      	rcall READ_DATETIME
                                 
                                 	; Обновление дисплея по флагу
                                 DISPLAY:	
000037 ff91                      	sbrs Flags, flag_disp ;Пропустить следующую команду если бит в регистре стоит
000038 c002                          rjmp BUTTON
000039 7f9d                      	cbr Flags, (1<<flag_disp) ; СРАЗУ сбрасываем флаг
00003a d059                      	rcall UPDATE_DISPLAY
                                 
                                 	; Обработка нажатой кнопки
                                 BUTTON:
00003b ff92                      	sbrs Flags, flag_bnt ;Пропустить следующую команду если бит в регистре стоит
00003c c002                          rjmp NEED_RECORD_TIME
00003d 7f9b                      	cbr Flags, (1<<flag_bnt) ; СРАЗУ сбрасываем флаг
00003e d057                      	rcall ACTIV_BUTTON
                                 
                                 	;Необходимость записи времени
                                 NEED_RECORD_TIME:
00003f 9100 0062                 	lds r16, flag_wr_time	;считываем
000041 ff07                      	sbrs r16, wr_time		;  проверяет состояние 7 бита (общий флаг необходимости записи времени), если этот бит установлен, пропускает следующую команду
000042 c004                          rjmp SLEEP_ALL
000043 770f                      	cbr r16, (1<<wr_time)	; СРАЗУ сбрасываем флаг
000044 9300 0062                 	sts flag_wr_time, r16	; записываем
000046 d087                      	rcall WRITE_SPECIFIC_TIME
                                 
                                 SLEEP_ALL:	
                                 	; Режим сна
000047 9588                      	 sleep                 ; Перевести МК в режим энергосбережения
                                    
000048 cfea                        	rjmp MAIN_LOOP
                                 
                                  ;=========== Прерывание от DS3231 (INT0) ===========
                                 INT0_DS3231:
000049 930f                          push r16
00004a b70f                          in r16, SREG
00004b 930f                          push r16
                                 	
                                 	; Установка флага считывания времени
00004c 6093                      	sbr Flags, (1<<flag_time)|(1<<flag_disp)
                                 			
00004d 910f                      	pop r16
00004e bf0f                          out SREG, r16
00004f 910f                          pop r16
                                 	
000050 9518                          reti
                                 
                                 ; =========== Инициализация переменных ===========
                                 INIT_VARIABLES:
000051 2700                          clr r16
                                 	; Время
000052 9300 0070                     sts bin_hours, r16
000054 9300 006f                     sts bin_min, r16
000056 9300 006e                     sts bin_sec, r16
000058 9300 0072                     sts bin_day, r16
00005a 9300 0073                     sts bin_mouth, r16
00005c 9300 0074                     sts bin_year, r16
00005e 9300 0071                     sts bin_weekday, r16
                                     
                                     ; Режимы
                                 	;ldi r16, 0
000060 9300 0060                     sts display_mode, r16
                                 	;clr r16
000062 9300 0061                     sts edit_mode, r16
                                 
                                 	; Флаги
000064 2799                           clr flags
000065 9300 0062                 	 sts flag_wr_time, r16
                                 
                                     ; Для теста установки времени
000067 e303                      	ldi r16,0x33
000068 d0e1                      	rcall BCD_TO_BIN
000069 9300 006e                 	sts bin_sec, r16
00006b e202                      	ldi r16,0x22
00006c d0dd                      	rcall BCD_TO_BIN
00006d 9300 006f                 	sts bin_min, r16
00006f e101                      	ldi r16,0x11
000070 d0d9                      	rcall BCD_TO_BIN
000071 9300 0070                 	sts bin_hours, r16
000073 e007                      	ldi r16,0x07
000074 d0d5                      	rcall BCD_TO_BIN
000075 9300 0071                 	sts bin_weekday, r16
000077 e006                      	ldi r16,0x06
000078 d0d1                      	rcall BCD_TO_BIN
000079 9300 0072                 	sts bin_day, r16
00007b e002                      	ldi r16,0x02
00007c d0cd                      	rcall BCD_TO_BIN
00007d 9300 0073                 	sts bin_mouth, r16
00007f e206                      	ldi r16,0x26
000080 d0c9                      	rcall BCD_TO_BIN
000081 9300 0074                 	sts bin_year, r16
                                       
000083 9508                          ret
                                 
                                 ; =========== Инициализация портов ===========
                                 INIT_PORTS:
                                     
                                 	; SPI порты (MOSI, SCK, SS, OE, MR как выходы)
000084 e20f                          ldi r16, (1<<DATA)|(1<<SCK)|(1<<LATCH)|(1<<OE)|(1<<MR)
000085 bb07                          out SPI_DDR, r16
                                     
                                     ; OE (яркость) - низкий уровень по умолчанию (максимальная яркость)
000086 98c1                          cbi SPI_PORT, OE
                                 	; MR (reset регистров 74HC595) - высокий уровень по умолчанию
000087 9ac0                      	sbi SPI_PORT, MR
                                      
                                 	    
                                     ; Порт для DS3231 (INT0)
000088 988a                          cbi DDRD, DS3231_INT      ; Вход
000089 9a92                          sbi PORTD, DS3231_INT     ; Подтяжка
                                     
                                     ; Порты для I2C
00008a 98a4                          cbi DDRC, SDA             ; SDA - вход
00008b 98a5                          cbi DDRC, SCL             ; SCL - вход
00008c 9aac                          sbi PORTC, SDA            ; Подтяжка
00008d 9aad                          sbi PORTC, SCL            ; Подтяжка
                                     
00008e 9508                          ret
                                 
                                 
                                 ; =========== Инициализация прерываний ===========
                                 INIT_INTERRUPTS:
                                     ; INT0 - От DS3231 восходящий фронт генерирует запрос прерывания
00008f e003                          ldi r16, (1<<ISC01)|(1<<ISC00)
000090 bf05                          out MCUCR, r16
000091 e400                          ldi r16, (1<<INT0)
000092 bf0b                          out GICR, r16
                                     
000093 9508                          ret
                                 ;===================================================
                                 UPDATE_DISPLAY:
000094 9ab0                      	sbi SPI_PIN, PB0
                                 
                                 	/*lds r16, flag_wr_time
                                 	sbr r16, (1<<wr_time)
                                 	sts flag_wr_time, r16*/
                                 
000095 9508                      	ret
                                 
                                 ACTIV_BUTTON:
000096 9ab1                      	sbi SPI_PIN, PB1
                                 
                                 	/*lds r16, flag_wr_time
                                 	sbr r16, (1<<wr_time)
                                 	sts flag_wr_time, r16*/
                                 
                                 .include "i2c.asm"
                                 
                                  * i2c.asm
                                 */ 
                                 ; =========== Инициализация DS3231 ===========
                                 INIT_DS3231:
000097 d09a                          rcall I2C_INIT
                                     
000098 d09e                          rcall I2C_START
000099 ed00                          ldi r16, 0xD0		;адрес DS3231
00009a d0a2                          rcall I2C_WRITE
                                     
00009b e00e                          ldi r16, 0x0E		; адресс Control Register (0Eh) DS3231 
00009c d0a0                          rcall I2C_WRITE
                                     
00009d e000                          ldi r16, 0x00		; запись в Control Register (0Eh) DS3231 Установка SQW на 1 Гц
00009e d09e                          rcall I2C_WRITE
                                     
00009f d0a7                          rcall I2C_STOP
                                 
0000a0 9508                          ret
                                 
                                 ;============== Чтение времени из DS3231 ==================================
                                 
                                 READ_DATETIME:
0000a1 930f                          push r16
                                 	        
                                     ;rcall I2C_INIT
                                     
0000a2 d094                          rcall I2C_START
                                     ; Адрес DS3231 для записи
0000a3 ed00                          ldi r16, 0xD0
0000a4 d098                          rcall I2C_WRITE
                                     
                                     ; Регистр 0x00 (секунды)
0000a5 e000                          ldi r16, 0x00
0000a6 d096                          rcall I2C_WRITE
                                     
0000a7 d08f                      	rcall I2C_START
                                     ; Повторный START для чтения
0000a8 ed01                          ldi r16, 0xD1
0000a9 d093                          rcall I2C_WRITE
                                 		
0000aa d096                      	rcall I2C_READ_ACK
0000ab b103                      	in r16, TWDR
0000ac 9300 0067                 	sts i2c_sec,r16
                                 	
0000ae d092                      	rcall I2C_READ_ACK
0000af b103                      	in r16, TWDR
0000b0 9300 0068                 	sts i2c_min,r16
                                 	
0000b2 d091                      	rcall I2C_READ_NACK
0000b3 b103                      	in r16, TWDR
0000b4 9300 0069                 	sts i2c_hours,r16
                                 		
0000b6 d090                      	rcall I2C_STOP
                                 	
0000b7 910f                      	pop r16
0000b8 9508                         ret
                                 
                                 ; =========== Запись времени в DS3231 ===========
                                 WRITE_DATETIME:
0000b9 930f                          push r16
                                     
                                     ;rcall I2C_INIT
                                     
0000ba d07c                      	rcall I2C_START
0000bb ed00                          ldi r16, 0xD0
0000bc d080                          rcall I2C_WRITE
                                     
0000bd e000                          ldi r16, 0x00
0000be d07e                          rcall I2C_WRITE
                                     
0000bf 9100 006e                     lds r16, bin_sec
0000c1 d098                          rcall BIN_TO_BCD
0000c2 d07a                          rcall I2C_WRITE
                                     
0000c3 9100 006f                     lds r16, bin_min
0000c5 d094                          rcall BIN_TO_BCD
0000c6 d076                          rcall I2C_WRITE
                                     
0000c7 9100 0070                     lds r16, bin_hours
0000c9 d090                          rcall BIN_TO_BCD
0000ca d072                          rcall I2C_WRITE
                                     
0000cb d07b                          rcall I2C_STOP
                                 
0000cc 910f                          pop r16
0000cd 9508                          ret
                                 
                                 ;============== Запись определенных параметров времени в DS3231 ====================
                                 WRITE_SPECIFIC_TIME:
0000ce 930f                      	push r16
                                 
0000cf d067                      	rcall I2C_START
0000d0 ed00                          ldi r16, 0xD0
0000d1 d06b                          rcall I2C_WRITE
                                 ;запись секунд
0000d2 9100 0062                 	lds r16, flag_wr_time	;считываем
0000d4 ff00                      	sbrs r16, wr_sec
0000d5 c009                      	rjmp M_Wr
0000d6 7f0e                      	cbr r16, (1<<wr_sec)	; СРАЗУ сбрасываем флаг
0000d7 9300 0062                 	sts flag_wr_time, r16	; записываем
0000d9 e000                      	ldi r16, 0x00	; адрес регистра секенд
0000da d062                      	rcall I2C_WRITE
0000db 9100 006e                 	lds r16, bin_sec
0000dd d07c                          rcall BIN_TO_BCD
0000de c042                      	rjmp WR_T
                                 ;запись минут
                                 M_Wr:
0000df ff01                      	sbrs r16, wr_min
0000e0 c009                      	rjmp H_Wr
0000e1 7f0d                      	cbr r16, (1<<wr_min)	; СРАЗУ сбрасываем флаг
0000e2 9300 0062                 	sts flag_wr_time, r16	; записываем
0000e4 e001                      	ldi r16, 0x01	; адрес регистра минут
0000e5 d057                      	rcall I2C_WRITE
0000e6 9100 006f                 	lds r16, bin_min
0000e8 d071                          rcall BIN_TO_BCD
0000e9 c037                      	rjmp WR_T
                                 ;запись часов
                                 H_Wr:
0000ea ff02                      	sbrs r16, wr_hours
0000eb c009                      	rjmp WD_Wr
0000ec 7f0b                      	cbr r16, (1<<wr_hours)	; СРАЗУ сбрасываем флаг
0000ed 9300 0062                 	sts flag_wr_time, r16	; записываем
0000ef e002                      	ldi r16, 0x02	; адрес регистра часов
0000f0 d04c                      	rcall I2C_WRITE
0000f1 9100 0070                 	lds r16, bin_hours
0000f3 d066                          rcall BIN_TO_BCD
0000f4 c02c                      	rjmp WR_T
                                 ;запись дня недели
                                 WD_Wr:
0000f5 ff03                      	sbrs r16, wr_weekday
0000f6 c009                      	rjmp D_Wr
0000f7 7f07                      	cbr r16, (1<<wr_weekday)	; СРАЗУ сбрасываем флаг
0000f8 9300 0062                 	sts flag_wr_time, r16	; записываем
0000fa e003                      	ldi r16, 0x03	; адрес регистра дня недели
0000fb d041                      	rcall I2C_WRITE
0000fc 9100 0071                 	lds r16, bin_weekday
0000fe d05b                          rcall BIN_TO_BCD
0000ff c021                      	rjmp WR_T
                                 ;запись дня месяца
                                 D_Wr:
000100 ff04                      	sbrs r16, wr_day
000101 c009                      	rjmp MO_Wr
000102 7e0f                      	cbr r16, (1<<wr_day)	; СРАЗУ сбрасываем флаг
000103 9300 0062                 	sts flag_wr_time, r16	; записываем
000105 e004                      	ldi r16, 0x04	; адрес регистра дня месяца
000106 d036                      	rcall I2C_WRITE
000107 9100 0072                 	lds r16, bin_day
000109 d050                          rcall BIN_TO_BCD
00010a c016                      	rjmp WR_T
                                 ;запись месяца
                                 MO_Wr:
00010b ff05                      	sbrs r16, wr_mouth
00010c c009                      	rjmp Y_Wr
00010d 7d0f                      	cbr r16, (1<<wr_mouth)	; СРАЗУ сбрасываем флаг
00010e 9300 0062                 	sts flag_wr_time, r16	; записываем
000110 e005                      	ldi r16, 0x05	; адрес регистра месяца
000111 d02b                      	rcall I2C_WRITE
000112 9100 0073                 	lds r16, bin_mouth
000114 d045                          rcall BIN_TO_BCD
000115 c00b                      	rjmp WR_T
                                 ;запись года
                                 Y_Wr:
000116 ff06                      	sbrs r16, wr_year
000117 c00b                      	rjmp St_Wr
000118 7b0f                      	cbr r16, (1<<wr_year)	; СРАЗУ сбрасываем флаг
000119 9300 0062                 	sts flag_wr_time, r16	; записываем
00011b e006                      	ldi r16, 0x06	; адрес регистра года
00011c d020                      	rcall I2C_WRITE
00011d 9100 0074                 	lds r16, bin_year
00011f d03a                          rcall BIN_TO_BCD
000120 c000                      	rjmp WR_T
                                 
                                 WR_T:	
000121 d01b                      	rcall I2C_WRITE
000122 d024                          rcall I2C_STOP
                                 St_Wr:
000123 910f                      	pop r16
000124 9508                          ret
                                 ; =========== Запись часов в DS3231 ===========
                                 WRITE_HOURS:
000125 930f                          push r16
                                     
                                     ;rcall I2C_INIT
                                     
000126 d010                      	rcall I2C_START
000127 ed00                          ldi r16, 0xD0
000128 d014                          rcall I2C_WRITE
                                     
000129 e002                          ldi r16, 0x02	; адрес регистра часов
00012a d012                          rcall I2C_WRITE
                                     
00012b 9100 0070                     lds r16, bin_hours
00012d d02c                          rcall BIN_TO_BCD
00012e d00e                          rcall I2C_WRITE
                                     
00012f d017                          rcall I2C_STOP
                                 
000130 910f                          pop r16
000131 9508                          ret
                                 
                                 ; =========== I2C процедуры ===========
                                 I2C_INIT:
000132 e00b                          ldi r16, 11
000133 b900                          out TWBR, r16 ; TWI Bit Rate Register  коэффициент деления для генератора скорости передачи данных
000134 e000                          ldi r16, (0<<TWPS1)|(0<<TWPS0) ; биты предварительного делителя в регистр TWSR (PrescalerValue = 1)
000135 b901                          out TWSR, r16
000136 9508                          ret
                                 
                                 	; TWINT  устанавливается аппаратно, когда TWI завершил свою текущую работу и ожидает ответа 
                                 	; TWEN разрешает работу TWI и активирует интерфейс TWI
                                 	; TWSTA генерирует условие START
                                 I2C_START:
000137 ea04                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTA)
000138 bf06                          out TWCR, r16
                                 
                                 I2C_WAIT:
000139 b706                          in r16, TWCR
00013a ff07                          sbrs r16, TWINT ;  проверяет состояние 7 бита TWINT в регистре и, если этот бит установлен, пропускает следующую команду
00013b cffd                          rjmp I2C_WAIT
00013c 9508                          ret
                                 
                                 I2C_WRITE:
00013d b903                          out TWDR, r16
00013e e804                          ldi r16, (1<<TWINT)|(1<<TWEN)
00013f bf06                          out TWCR, r16
000140 cff8                          rjmp I2C_WAIT
                                 
                                 	; TWEA: TWI Enable Acknowledge Bit 
                                 I2C_READ_ACK:
000141 ec04                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWEA)
000142 bf06                          out TWCR, r16
000143 cff5                          rjmp I2C_WAIT
                                 
                                 I2C_READ_NACK:
000144 e804                          ldi r16, (1<<TWINT)|(1<<TWEN)
000145 bf06                          out TWCR, r16
000146 cff2                          rjmp I2C_WAIT
                                 
                                 	; TWSTO: TWI STOP Condition Bit 
                                 I2C_STOP:
000147 e904                          ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
000148 bf06                          out TWCR, r16
000149 9508                          ret
                                 
                                 ; =========== BCD в BIN ===========
                                 BCD_TO_BIN:
                                 	; Вход: r16
00014a 931f                          push r17
00014b 932f                          push r18
00014c 2f10                          mov  r17, r16       ; Копируем BCD
00014d 701f                          andi r17, 0x0F      ; R17 = Единицы (младшая тетрада)
00014e 9502                          swap r16            ; Меняем тетрады местами
00014f 700f                          andi r16, 0x0F      ; R16 = Десятки (бывшая старшая тетрада)
                                     
                                     ; Умножение на 10: (X * 8) + (X * 2)
000150 2f20                          mov  r18, r16       ; R18 = X
000151 0f00                          lsl  r16            ; X * 2
000152 0f00                          lsl  r16            ; X * 4
000153 0f00                          lsl  r16            ; X * 8
000154 0f02                          add  r16, r18       ; + X = X * 9
000155 0f02                          add  r16, r18       ; + X = X * 10
                                     
000156 0f01                          add  r16, r17       ; Прибавляем единицы
000157 912f                          pop  r18
000158 911f                          pop  r17
000159 9508                          ret
                                 
                                 ; =========== BIN в BCD ===========
                                 BIN_TO_BCD:
                                 	; Вход: r16
00015a 931f                          push r17
00015b e010                          ldi  r17, 0         ; Счетчик десятков
                                 BIN_loop:
00015c 300a                          cpi  r16, 10        ; Сравниваем с 10
00015d f018                          brlo BIN_done       ; Если меньше 10, выходим
00015e 500a                          subi r16, 10        ; Вычитаем 10
00015f 9513                          inc  r17            ; Увеличиваем счетчик десятков
000160 cffb                          rjmp BIN_loop
                                 BIN_done:
000161 9512                          swap r17            ; Перемещаем десятки в старшую тетраду
000162 2b01                          or   r16, r17       ; Объединяем с единицами (BCD упакованный)
000163 911f                          pop  r17
000164 9508                          ret
                                 
                                 
000165 9508                      	ret


